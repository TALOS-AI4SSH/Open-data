<location rdf:resource="http://ontologia.fr/OTB/lac#loc-Greece"/>
<beginDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-192</beginDate>
<endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-188</endDate>
<rdfs:comment xml:lang="en">The Seleucid War (192–188 BC), also known as the War of Antiochos or the Syrian War, was a military conflict between two coalitions led by the Roman Republic and the Seleucid Empire. The fighting took place in modern day southern Greece, the Aegean Sea and Asia Minor. https://en.wikipedia.org/wiki/Roman–Seleucid_War</rdfs:comment>
<rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Roman–Seleucid_War</rdfs:seeAlso>
</owl:NamedIndividual>
