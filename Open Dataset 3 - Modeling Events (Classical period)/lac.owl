<rdf:Description rdf:about="http://ontologia.fr/OTB/lac#Crisis">
<rdfs:label xml:lang="el">κρίση</rdfs:label>
<rdfs:label xml:lang="en">crisis</rdfs:label>
<rdfs:comment xml:lang="grc">κρίσις [ι^ς], εως, ἡ, （κρίνω) A.separating, distinguishing 2. decision, judgement 3. choice, election 4. interpretation of dreams or portents II. judgement of a court b. result of a trial, condemnation 2. trial of skill or strength 3. dispute III. event, issue 2. turning point of a disease, sudden change for better or worse https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.04.0057%3Aentry%3Dkri%2Fsis</rdfs:comment>
</rdf:Description>
<rdf:Description rdf:about="http://ontologia.fr/OTB/lac#Defection">
<skos:prefLabel xml:lang="en">defection</skos:prefLabel>
<skos:prefLabel xml:lang="grc">ἀπόστασις LSJ http://www.perseus.tufts.edu/hopper/morph?l=a%29posta%2Fsewn&la=greek&can=a%29posta%2Fsewn0&prior=tw=n&d=Perseus:text:1999.01.0199:book=1:chapter=99:section=1&i=1#Perseus:text:1999.04.0057:entry=a)po/stasis-contents</skos:prefLabel>
<rdfs:label xml:lang="en">defection</rdfs:label>
<skos:prefLabel xml:lang="el">αποστασία</skos:prefLabel>
<rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Defection</rdfs:seeAlso>
</rdf:Description>
<rdf:Description rdf:about="http://ontologia.fr/OTB/lac#Deforestation">
<rdfs:comment xml:lang="el">συστηματική υλοτόμηση των δασών και της υποβλάστησής τους</rdfs:comment>
<rdfs:label xml:lang="el">αποψίλωση δασών</rdfs:label>
<rdfs:label xml:lang="en">deforestation</rdfs:label>
