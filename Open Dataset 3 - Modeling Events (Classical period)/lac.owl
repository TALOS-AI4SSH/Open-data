<!--  http://ontologia.fr/OTB/lac#Event  -->
<owl:Class rdf:about="http://ontologia.fr/OTB/lac#Event">
<owl:equivalentClass>
<owl:Class>
<owl:intersectionOf rdf:parseType="Collection">
<rdf:Description rdf:about="http://ontologia.fr/OTB/lac#LACRIMALit"/>
<owl:Restriction>
<owl:onProperty rdf:resource="http://ontologia.fr/OTB/lac#agent"/>
