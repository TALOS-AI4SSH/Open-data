<PerseusLSJURI xml:lang="grc">https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.04.0057%3Aentry%3De)kstratei%2Fa</PerseusLSJURI>
<rdfs:label xml:lang="grc">ἐκστρατεία</rdfs:label>
<rdfs:label xml:lang="en">expedition</rdfs:label>
<skos:prefLabel xml:lang="en">campaign</skos:prefLabel>
