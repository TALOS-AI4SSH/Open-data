<rdfs:seeAlso xml:lang="en">https://topostext.org/place/404239PAka</rdfs:seeAlso>
</owl:NamedIndividual>
<!--  http://ontologia.fr/OTB/lac#loc-Achaemenid_Persian_empire  -->
<owl:NamedIndividual rdf:about="http://ontologia.fr/OTB/lac#loc-Achaemenid_Persian_empire">
