<!--  http://ontologia.fr/OTB/lac#evt-Roman_Syrian_war_192-188_BC  -->
<owl:NamedIndividual rdf:about="http://ontologia.fr/OTB/lac#evt-Roman_Syrian_war_192-188_BC">
<rdf:type rdf:resource="http://ontologia.fr/OTB/lac#War"/>
