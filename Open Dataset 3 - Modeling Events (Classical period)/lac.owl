<!--  http://ontologia.fr/OTB/lac#agt-Twelve_Lictors  -->
<owl:NamedIndividual rdf:about="http://ontologia.fr/OTB/lac#agt-Twelve_Lictors">
<rdf:type rdf:resource="http://ontologia.fr/OTB/lac#Group"/>
<rdfs:comment xml:lang="en">The lictors were instituted by Rome's first king, Romulus, who appointed twelve lictors to attend him. They were Roman civil servants who served as attendant and bodyguard to a magistrate who held imperium (a form of authority held by a citizen to control a military or governmental entity).</rdfs:comment>
<rdfs:label xml:lang="en">Twelve Lictors</rdfs:label>
<rdfs:label xml:lang="el">Δώδεκα Λίκτορες</rdfs:label>
<rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Lictor</rdfs:seeAlso>
</owl:NamedIndividual>
<!--  http://ontologia.fr/OTB/lac#agt-Xenophon  -->
