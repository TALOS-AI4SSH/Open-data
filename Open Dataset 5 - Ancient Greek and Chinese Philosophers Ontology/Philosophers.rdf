        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_αρχαία_κινεζική_περιοχή_el">
                <ontolex:isEvokedBy rdf:resource="#αρχαία_κινεζική_περιοχή_el"/>
