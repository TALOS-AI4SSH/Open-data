            <ontolex:LexicalConcept rdf:about="#lexical_concept_αρχαία_ελληνική_περιοχή_el">
                <ontolex:isEvokedBy rdf:resource="#αρχαία_ελληνική_περιοχή_el"/>
                <skos:definition xml:lang="el">Αρχαία Ελληνική περιοχή.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Ancient-Greek-Place"/>
    </ontolex:LexicalEntry>

