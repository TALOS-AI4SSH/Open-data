        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Epictetus"/>
        <foaf:depiction rdf:resource="https://upload.wikimedia.org/wikipedia/commons/thumb/0/00/Epicteti_Enchiridion_Latinis_versibus_adumbratum_%28Oxford_1715%29_frontispiece.jpg/800px-Epicteti_Enchiridion_Latinis_versibus_adumbratum_%28Oxford_1715%29_frontispiece.jpg"/>
        <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/epictetus/"/>
