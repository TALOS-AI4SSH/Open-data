    <owl:NamedIndividual rdf:about="#epictetus">
        <rdfs:label xml:lang="en">epictetus</rdfs:label>
        <skos:prefLabel xml:lang="en">epictetus</skos:prefLabel>
        <rdf:type rdf:resource="#Ancient-Greek-Philosopher"/>
        <skos:note>By William Sonmans Michael Burghers - Imaginary portrait of Epictetus. Engraved frontispiece of Edward Ivie’s Latin translation (or versification) of Epictetus’ Enchiridon, printed in Oxford in 1715. The subscription is an epigram from the Anthologia Palatina (VII 676): “I was Epictetus the slave, and not sound in all my limbs, and poor as Irus, and beloved by the gods.” (Irus is the beggar in the Odyssey.) https:archive.orgdetailsepictetienchirid00epic, Public Domain, https:commons.wikimedia.orgwindex.php?curid=9071933</skos:note>
        <birthDate>55_CE</birthDate>
        <deathDate>135_CE</deathDate>
        <representativeOf rdf:resource="#stoic_school"/>        <teacherOf rdf:resource="#demonax_of_cyprus"/>        <stayedIn rdf:resource="#rome"/>        <centuryOfLiving rdf:resource="#1st_century_CE"/>        <centuryOfLiving rdf:resource="#2nd_century_CE"/>        <birthPlace rdf:resource="#hierapolis"/>        <authorOf rdf:resource="#the_handbook_epictetus"/>        <authorOf rdf:resource="#discourses_epictetus"/>        <rdfs:seeAlso rdf:resource="https://iep.utm.edu/epictetu/"/>
        <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/epictetus/#TexTra"/>
        <rdfs:seeAlso rdf:resource="https://classics.mit.edu/Browse/browse-Epictetus.html"/>
        <rdfs:seeAlso rdf:resource="https://librivox.org/author/4230?primary_key=4230&amp;search_category=author&amp;search_page=1&amp;search_form=get_results&amp;search_order=alpha"/>
