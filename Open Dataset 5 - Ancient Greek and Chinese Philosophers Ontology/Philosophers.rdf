                <ontolex:isEvokedBy rdf:resource="#σχολή_αρχαίας_κινεζικής_φιλοσοφίας_el"/>
                <skos:definition xml:lang="el">Σχολή Αρχαίας Κινεζικής φιλοσοφίας.</skos:definition>
