	<!--  OWL Ontology -->

    <owl:Ontology rdf:about="http://www.ontologia.fr/OTB/Philosophers">
        <dc:title>Philosophers</dc:title>
        <dc:description>The current ontoterminology version 1.0 aims to model the Ancient Greek philosophers, their philosophical production and their spatial and temporal positioning. A previous version of the ontology has been developed in the context of the KELKIP Project (https:kelkip.uoa.gr). 
The ontoterminology was created by Rafail Giannadakis (Department of Philology, University of Crete) under the supervision of Dr. Maria Papadopoulou (Department of Philology, University of Crete).
We gratefully acknowledge the TALOS-AI4SSH project and the funding of the European Commission under TALOS- Artificial Intelligence for the Social Sciences and the Humanities; Grant agreement ID: 101087269.
</dc:description>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-11</dc:issued>
        <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-8-26</dc:modified>
        <dc:creator>Maria Papadopoulou</dc:creator>
        <dc:publisher>Condillac</dc:publisher>
    </owl:Ontology>

