                <ontolex:isEvokedBy rdf:resource="#false_witness_suit_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for providing false witness testimony, tried before the dikasterion.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_providing_false_witness_testimony_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#scrutiny_en">
        <ontolex:lexicalForm>
