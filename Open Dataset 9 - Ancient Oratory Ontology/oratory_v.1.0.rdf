    </owl:Class>

    <owl:Class rdf:about="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_">
        <rdfs:label xml:lang="en">indictment for seduction</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for seduction</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">μοιχείας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">μοιχείας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Lys. 1.36: "οἷς ὑμᾶς ἀξιῶ τὴν αὐτὴν γνώμην ἔχειν: εἰ δὲ μή, τοιαύτην ἄδειαν τοῖς μοιχοῖς ποιήσετε, ὥστε1 καὶ τοὺς κλέπτας ἐπαρεῖτε φάσκειν μοιχοὺς εἶναι, εὖ εἰδότας ὅτι, ἐὰν ταύτην τὴν αἰτίαν περὶ ἑαυτῶν λέγωσι καὶ ἐπὶ τούτῳ φάσκωσιν εἰς τὰς ἀλλοτρίας οἰκίας εἰσιέναι, οὐδεὶς αὐτῶν ἅψεται. πάντες γὰρ εἴσονται ὅτι τοὺς μὲν νόμους τῆς μοιχείας χαίρειν ἐᾶν δεῖ, τὴν δὲ ψῆφον τὴν ὑμετέραν δεδιέναι: αὕτη γάρ ἐστι πάντων τῶν ἐν τῇ πόλει κυριωτάτη."</skos:example>
        <rdfs:subClassOf rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_prostitution_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_impiety_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_"/>
        <owl:disjointWith rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
