	<!--  SKOS Concept Scheme -->

    <skos:ConceptScheme rdf:about="http://www.ontologia.fr/OTB/oratory_v.1.0">
        <dc:title>Oratory</dc:title>
        <dc:description>This is version 1.0 of a dataset created in the context  of a PhD in "Semantic Annotation and Attic Oratory" that defines the primary legal bodies in Classical Athenian courts c. 419 BC to 323 BC. A legal body is defined as "an individual or group who either proceeds over or judges a legal proceeding". This work draws upon the corpus of Attic oratory and the Pseudo-Aristotelian Athenian constitution, as well as The Law of Ancient Athens by David D. Phillips.
This dataset is authored by Rachel Milio (TALOS Ph.D. candidate, Department of Philology, University of Crete), under the supervision of Dr. Maria Papadopoulou (Department of Philology, University of Crete) and Prof. Christophe Roche (TALOS ERA Chair Professor, University of Crete).
Acknowledgement: We gratefully acknowledge the generous funding of the European Commission under the ERA Chair Project TALOS AI for SSH (Grant agreement ID: 101087269).
Contact: Rachel.Milio@outlook.com
</dc:description>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-7-12</dc:issued>
        <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-8-30</dc:modified>
        <dc:creator>Rachel Milio</dc:creator>
        <dc:publisher>University of Crete</dc:publisher>
    </skos:ConceptScheme>

	<!--  SKOS Concepts -->

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for avoiding military service</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for avoiding military service</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for avoiding military service, proceeded over by the Strategoi and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of disenfranchisement.</skos:definition>
        <rdfs:label xml:lang="grc">ἀστρατείας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀστρατείας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for avoiding military service, proceeded over by the Strategoi and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of disenfranchisement.</skos:definition>
        <skos:example xml:lang="grc">Lys. 15.1: "ἐγὼ μέν, ὦ ἄνδρες δικασταί, καὶ ὑμᾶς αἰτοῦμαι τὰ δίκαια ψηφίσασθαι, καὶ τῶν στρατηγῶν δέομαι, ἐπεὶ καὶ ἐν τῇ ἄλλῃ ἀρχῇ πολλοῦ ἄξιοι τῇ πόλει γεγόνασι, καὶ τῶν τῆς ἀστρατείας γραφῶν κοινοὺς εἶναι τῷ τε διώκοντι καὶ τῷ φεύγοντι, καὶ μὴ βοηθοῦντας ᾧ ἂν βούλωνται πᾶσαν προθυμίαν ἔχειν παρὰ τὸ δίκαιον ὑμᾶς ψηφίσασθαι,"</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_providing_false_witness_testimony_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">false witness suit</rdfs:label>
        <skos:prefLabel xml:lang="en">false witness suit</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for providing false witness testimony, tried before the dikasterion.</skos:definition>
        <rdfs:label xml:lang="grc">ψευδομαρτυριῶν δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">ψευδομαρτυριῶν δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for providing false witness testimony, tried before the dikasterion.</skos:definition>
        <skos:example xml:lang="grc">Dem. 24.131: "οὐδὲ γὰρ οἱ τῆς ξενίας ἁλισκόμενοι ἀγανακτοῦσιν ἐν τῷ οἰκήματι τούτῳ ὄντες, ἕως ἂν τῶν ψευδομαρτυριῶν ἀγωνίσωνται, ἀλλὰ μένουσιν καὶ οὐκ οἴονται δεῖν ἐγγυητὰς καταστήσαντες περιιέναι."</skos:example>
        <skos:example xml:lang="grc">Isaeus 11.46: "δίκαι γὰρ ἐνεστήκασι ψευδομαρτυρίων, κελεύει δ᾽ ὁ νόμος, ἐὰν ἁλῷ τις τῶν ψευδομαρτυρίων, πάλιν ἐξ ἀρχῆς εἶναι περὶ αὐτῶν τὰς λήξεις: τὰ δὲ τοῦ παιδὸς ὡμολογημένα καὶ ἀναμφισβήτητα καταλέλοιπε Στρατοκλῆς. ὅτι δὲ τοσαῦτά ἐστι τἀμὰ σὺν τοῖς τοῦ ἐκποιήτου ὑέος, καὶ ψευδομαρτυριῶν ἐνεστᾶσι δίκαι περὶ τῶν Ἁγνίου, λαβὲ τὰς μαρτυρίας καὶ ἀνάγνωθι."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_unintentional_homicide">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">unintentional homicide suit</rdfs:label>
        <skos:prefLabel xml:lang="en">unintentional homicide suit</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for unintentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the 51 Ephetai. If convicted, the defendant receives the non-assessable penalty of exile.</skos:definition>
        <rdfs:label xml:lang="grc">φόνος ἀκούσιος δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">φόνος ἀκούσιος δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for unintentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the 51 Ephetai. If convicted, the defendant receives the non-assessable penalty of exile.</skos:definition>
        <skos:example xml:lang="grc">Antiph. 3 3.7: "ἀκουσίως δὲ οὐχ ἧσσον ἢ ἑκουσίως ἀποκτείναντες1 μου τὸν παῖδα, τὸ παράπαν δ᾽ ἀρνούμενοι2 μὴ ἀποκτεῖναι αὐτόν, οὐδ᾽ ὑπὸ τοῦ νόμου καταλαμβάνεσθαί φασιν,3 ὃς ἀπαγορεύει μήτε δικαίως μήτε ἀδίκως ἀποκτείνειν. ἀλλὰ τίς ὁ βαλών; εἰς τίν᾽ ὁ φόνος ἀνήκει;4 εἰς τοὺς θεωμένους ἢ εἰς τοὺς παιδαγωγοὺς, ὧν οὐδεὶς οὐδὲν κατηγορεῖ; οὐ γὰρ ἀφανὴς ἀλλὰ καὶ λίαν φανερὸς ἔμοιγε αὐτοῦ ὁ θάνατός ἐστιν. ἐγὼ δὲ τὸν νόμον ὀρθῶς ἀγορεύειν φημὶ τοὺς ἀποκτείναντας κολάζεσθαι: ὅ τε γὰρ ἄκων ἀποκτείνας ἀκουσίοις κακοῖς περιπεσεῖν δίκαιός ἐστιν, ὅ τε διαφθαρεὶς οὐδὲν ἧσσον ἀκουσίως ἢ ἑκουσίως βλαφθεὶς ἀδικοῖτ᾽ ἂν ἀτιμώρητος γενόμενος."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_battery_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">battery suit</rdfs:label>
        <skos:prefLabel xml:lang="en">battery suit</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
        <rdfs:label xml:lang="grc">αἰκίας δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">αἰκίας δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
        <skos:example xml:lang="grc">Dem. 37.33: "
ἐνταυθὶ πόλλ᾽ ἄττα καὶ δεινά μοι ἅμ᾽ ἐγκαλεῖ: καὶ γὰρ αἴκειαν καὶ ὕβριν καὶ βιαίων καὶ πρὸς ἐπικλήρους ἀδικήματα. τούτων δ᾽ εἰσὶν ἑκάστου χωρὶς αἱ δίκαι καὶ οὔτε πρὸς ἀρχὴν τὴν αὐτὴν οὔθ᾽ ὑπὲρ τιμημάτων τῶν αὐτῶν, ἀλλ᾽ ἡ μὲν αἴκεια καὶ τὰ τῶν βιαίων πρὸς τοὺς τετταράκοντα, αἱ δὲ τῆς ὕβρεως πρὸς τοὺς θεσμοθέτας, ὅσα δ᾽ εἰς ἐπικλήρους, πρὸς τὸν ἄρχοντα. οἱ δὲ νόμοι καὶ τούτων διδόασι τὰς παραγραφὰς ἀντιλαγχάνειν, περὶ ὧν οὐκ εἰσὶν εἰσαγωγεῖς. λέγε δ᾽ αὐτοῖς τουτονὶ τὸν νόμον."</skos:example>
        <skos:example xml:lang="grc">Dem. 54.18: "φασὶ τοίνυν ταύτας διὰ τοῦτο γίγνεσθαι, ἵνα μὴ λοιδορούμενοι τύπτειν ἀλλήλους προάγωνται. πάλιν αἰκείας εἰσί: καὶ ταύτας ἀκούω διὰ τοῦτ᾽ εἶναι τὰς δίκας, ἵνα μηδείς, ὅταν ἥττων ᾖ, λίθῳ μηδὲ τῶν τοιούτων ἀμύνηται μηδενί, ἀλλὰ τὴν ἐκ τοῦ νόμου δίκην ἀναμένῃ."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">review</rdfs:label>
        <skos:prefLabel xml:lang="en">review</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</skos:definition>
        <rdfs:label xml:lang="grc">εὔθυναι</rdfs:label>
        <skos:prefLabel xml:lang="grc">εὔθυναι</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</skos:definition>
        <skos:example xml:lang="grc">--- new context ---
--- should contain the term ---</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_prostitution_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for prostitution</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for prostitution</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for exercising citizenship rights having engaged in prostitution, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death.</skos:definition>
        <rdfs:label xml:lang="grc">ἑταιρήσεως γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἑταιρήσεως γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for exercising citizenship rights having engaged in prostitution, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death.</skos:definition>
        <skos:example xml:lang="grc">Aeschin. 1.20: "μηδὲ κηρυκευσάτω, μηδὲ πρεσβευσάτω, μηδὲ τοὺς πρεσβεύσαντας κρινέτω, μηδὲ συκοφαντείτω μισθωθείς, μηδὲ γνώμην εἰπάτω μηδέποτε μήτε ἐν τῇ βουλῇ μήτε ἐν τῷ δήμῳ, μηδ᾽ ἂν δεινότατος ᾖ λέγειν Ἀθηναίων. ἐὰν δέ τις παρὰ ταῦτα πράττῃ, γραφὰς ἑταιρήσεως πεποίηκε καὶ τὰ μέγιστα ἐπιτίμια ἐπέθηκεν. λέγε αὐτοῖς καὶ τοῦτον τὸν νόμον, ἵν᾽ εἰδῆτε οἵων νόμων ὑμῖν κειμένων, ὡς καλῶν καὶ σωφρόνων, τετόλμηκε Τίμαρχος δημηγορεῖν, ὁ τοιοῦτος τὸν τρόπον οἷον ὑμεῖς ἐπίστασθε."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_return_of_a_dowry_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for a dowry</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for a dowry</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη προικός</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη προικός</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <skos:example xml:lang="grc">Isaeus 3.9: "ἢ εἰ μὴ ἐκομίζετο, ὁποίαν δίκην σίτου ἢ τῆς προικὸς αὐτῆς ἐν εἴκοσιν ἔτεσι τῷ ἔχοντι τὸν κλῆρον δικάσασθαι ἠξίωσεν,1 ἢ εἴ του ἀνθρώπων ἐναντίον προσῆλθεν ἐγκαλῶν τῷ κληρονόμῳ περὶ τῆς προικὸς τῆς ἀδελφῆς ἐν χρόνῳ τοσούτῳ. περί τε οὖν τούτων ἡδέως ἂν πυθοίμην, ὅ τι ποτ᾽ ἦν τὸ αἴτιον τοῦ μηδὲν τούτων γεγενῆσθαι περὶ τῆς ἐγγυητῆς （ὡς μεμαρτύρηκεν οὗτος） γυναικός,"</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">intentional wounding suit</rdfs:label>
        <skos:prefLabel xml:lang="en">intentional wounding suit</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <rdfs:label xml:lang="grc">τραύματος ἐκ προνοίας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">τραύματος ἐκ προνοίας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <skos:example xml:lang="grc">Dem 23.22: "δικάζειν δὲ τὴν βουλὴν τὴν ἐν Ἀρείῳ πάγῳ φόνου καὶ τραύματος ἐκ προνοίας καὶ πυρκαϊᾶς καὶ φαρμάκων, ἐάν τις ἀποκτείνῃ δούς."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_against_obstructing_an_heir_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for ejectment</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for ejectment</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for physically obstructing someone from their inheritance, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of restoring the property to the heir and paying its value to the state. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <rdfs:label xml:lang="grc">ἐξούλης δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἐξούλης δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for physically obstructing someone from their inheritance, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of restoring the property to the heir and paying its value to the state. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <skos:example xml:lang="grc">Dem. 39.15: "ὅτι νὴ Δί᾽ εἴσονται πάντες πότερός ποτ᾽ ὦφλεν. καλῶς. ἂν δέ, ὃ τυχὸν γένοιτ᾽ ἄν, χρόνος διέλθῃ καὶ μὴ ἐκτεισθῇ τὸ ὄφλημα, τί μᾶλλον οἱ τούτου παῖδες ἔσονται τῶν ἐμῶν ἐγγεγραμμένοι, ὅταν τοὔνομα καὶ ὁ πατὴρ καὶ ἡ φυλὴ καὶ πάντ᾽ ᾖ ταὐτά; τί δ᾽, εἴ τις δίκην ἐξούλης αὐτῷ λαχὼν μηδὲν ἐμοὶ φαίη πρὸς αὑτὸν εἶναι, κυρίαν δὲ ποιησάμενος ἐγγράψαι, τί μᾶλλον ἂν εἴη τοῦτον ἢ ἔμ᾽ ἐγγεγραφώς; τί δ᾽, εἴ τινας εἰσφορὰς μὴ θείη;"</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_against_crimes_against_humanity_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for hubris</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for hubris</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for crimes of hubris, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">ὕβρεως γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ὕβρεως γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for crimes of hubris, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 37.33: "ἐνταυθὶ πόλλ᾽ ἄττα καὶ δεινά μοι ἅμ᾽ ἐγκαλεῖ: καὶ γὰρ αἴκειαν καὶ ὕβριν καὶ βιαίων καὶ πρὸς ἐπικλήρους ἀδικήματα. τούτων δ᾽ εἰσὶν ἑκάστου χωρὶς αἱ δίκαι καὶ οὔτε πρὸς ἀρχὴν τὴν αὐτὴν οὔθ᾽ ὑπὲρ τιμημάτων τῶν αὐτῶν, ἀλλ᾽ ἡ μὲν αἴκεια καὶ τὰ τῶν βιαίων πρὸς τοὺς τετταράκοντα, αἱ δὲ τῆς ὕβρεως πρὸς τοὺς θεσμοθέτας, ὅσα δ᾽ εἰς ἐπικλήρους, πρὸς τὸν ἄρχοντα. οἱ δὲ νόμοι καὶ τούτων διδόασι τὰς παραγραφὰς ἀντιλαγχάνειν, περὶ ὧν οὐκ εἰσὶν εἰσαγωγεῖς. λέγε δ᾽ αὐτοῖς τουτονὶ τὸν νόμον."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for removal of sacred olive tree</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for removal of sacred olive tree</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for the destruction of sacred olive trees, proceeded over by the Basileus and tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <rdfs:label xml:lang="grc">ἀσεβείας τοῦ σηκοῦ γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀσεβείας τοῦ σηκοῦ γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for the destruction of sacred olive trees, proceeded over by the Basileus and tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <skos:example xml:lang="grc">Lys. 7.2: "οὕτω δ᾽ ἄπορος ὁ ἀγών μοι καθέστηκεν, ὥστε ἀπεγράφην τὸ μὲν πρῶτον ἐλάαν ἐκ τῆς γῆς ἀφανίζειν, καὶ πρὸς τοὺς ἐωνημένους τοὺς καρποὺς τῶν μορίων πυνθανόμενοι προσῇσαν: ἐπειδὴ δ᾽ ἐκ τούτου τοῦ τρόπου ἀδικοῦντά με οὐδὲν εὑρεῖν ἐδυνήθησαν, νυνί με σηκόν φασιν1 ἀφανίζειν, ἡγούμενοι ἐμοὶ μὲν ταύτην τὴν αἰτίαν ἀπορωτάτην εἶναι ἀπελέγξαι,2 αὐτοῖς δὲ ἐξεῖναι μᾶλλον ὅ τι ἂν βούλωνται λέγειν."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_against_official_for_offenses_against_the_state">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">impeachment for treason</rdfs:label>
        <skos:prefLabel xml:lang="en">impeachment for treason</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
        <rdfs:label xml:lang="grc">εἰσαγγελία</rdfs:label>
        <skos:prefLabel xml:lang="grc">εἰσαγγελία</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
        <skos:example xml:lang="grc">Andoc. 1.43: "ἡ μὲν εἰσαγγελία αὐτῷ, ὦ ἄνδρες, τοιαύτη: ἀπογράφει δὲ τὰ ὀνόματα τῶν ἀνδρῶν ὧν ἔφη γνῶναι, δύο καὶ τετταράκοντα, πρώτους μὲν Μαντίθεον καὶ Ἀψεφίωνα, βουλευτὰς ὄντας καὶ καθημένους ἔνδον, εἶτα δὲ καὶ τοὺς ἄλλους. ἀναστὰς δὲ Πείσανδρος ἔφη χρῆναι λύειν τὸ ἐπὶ Σκαμανδρίου ψήφισμα καὶ ἀναβιβάζειν ἐπὶ τὸν τροχὸν τοὺς ἀπογραφέντας, ὅπως μὴ πρότερον νὺξ ἔσται πρὶν πυθέσθαι τοὺς ἄνδρας ἅπαντας. ἀνέκραγεν ἡ βουλὴ ὡς εὖ λέγει."</skos:example>
        <skos:example xml:lang="grc">Dem. 21.121: "Λυσίμαχος Ἀλωπεκῆθεν, Δημέας Σουνιεύς, Χάρης Θορίκιος, Φιλήμων Σφήττιος, Μόσχος Παιανιεύς, καθ᾽ οὓς καιροὺς ἡ εἰσαγγελία ἐδόθη εἰς τὴν βουλὴν ὑπὲρ Ἀριστάρχου τοῦ Μόσχου, ὅτι εἴη Νικόδημον ἀπεκτονώς, οἴδαμεν Μειδίαν τὸν κρινόμενον ὑπὸ Δημοσθένους, ᾧ μαρτυροῦμεν, ἐλθόντα πρὸς τὴν βουλὴν καὶ λέγοντα μηδένα ἕτερον εἶναι τὸν Νικοδήμου φονέα, ἀλλ᾽ Ἀρίσταρχον, καὶ τοῦτον αὐτοῦ γεγονέναι αὐτόχειρα, καὶ συμβουλεύοντα τῇ βουλῇ βαδίζειν ἐπὶ τὴν οἰκίαν τὴν Ἀριστάρχου καὶ συλλαμβάνειν αὐτόν."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_illegal_defamatory_speech_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">defamation suit</rdfs:label>
        <skos:prefLabel xml:lang="en">defamation suit</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</skos:definition>
        <rdfs:label xml:lang="grc">κακηγορίας δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">κακηγορίας δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</skos:definition>
        <skos:example xml:lang="grc">Dem. 21.32: "ἴστε δήπου τοῦθ᾽ ὅτι τῶν θεσμοθετῶν τούτων οὐδενὶ θεσμοθέτης ἔστ᾽ ὄνομα, ἀλλ᾽ ὁτιδήποθ᾽ ἑκάστῳ. ἂν μὲν τοίνυν ἰδιώτην ὄντα τιν᾽ αὐτῶν ὑβρίσῃ τις ἢ κακῶς εἴπῃ, γραφὴν ὕβρεως καὶ δίκην κακηγορίας ἰδίαν φεύξεται, ἐὰν δὲ θεσμοθέτην, ἄτιμος ἔσται καθάπαξ. διὰ τί; ὅτι τοὺς νόμους ἤδη ὁ τοῦτο ποιῶν προσυβρίζει καὶ τὸν ὑμέτερον κοινὸν στέφανον καὶ τὸ τῆς πόλεως ὄνομα: ὁ γὰρ θεσμοθέτης οὐδενὸς ἀνθρώπων ἔστ᾽ ὄνομα, ἀλλὰ τῆς πόλεως."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_by_an_arrest_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">summary arrest</rdfs:label>
        <skos:prefLabel xml:lang="en">summary arrest</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
        <rdfs:label xml:lang="grc">ἀπαγωγή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀπαγωγή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 24.146: "ὡς δὲ σαφῶς γνώσεσθ᾽ ὅτι ἀληθῆ λέγω, ἐγὼ ὑμῖν ἐρῶ. οὔτε γὰρ ἄν, ὦ ἄνδρες δικασταί, τιμᾶν ἐξῆν ὑμῖν ὅ τι χρὴ παθεῖν ἢ ἀποτεῖσαι （ἐν γὰρ τῷ παθεῖν καὶ ὁ δεσμὸς ἔνι: οὐκ ἂν οὖν ἐξῆν δεσμοῦ τιμῆσαι）, οὔθ᾽ ὅσων ἔνδειξίς ἐστιν ἢ ἀπαγωγὴ προσεγέγραπτ᾽ ἂν ἐν τοῖς νόμοις ‘τὸν δ᾽ ἐνδειχθέντα ἢ ἀπαχθέντα δησάντων οἱ ἕνδεκα ἐν τῷ ξύλῳ,’ εἴπερ μὴ ἐξῆν ἄλλους ἢ τοὺς ἐπὶ προδοσίᾳ τῆς πόλεως ἢ ἐπὶ καταλύσει τοῦ δήμου συνιόντας ἢ τοὺς τὰ τέλη ὠνουμένους καὶ μὴ καταβάλλοντας δῆσαι."σει τοῦ δήμου συνιόντας ἢ τοὺς τὰ τέλη ὠνουμένους καὶ μὴ καταβάλλοντας δῆσαι.</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">public lawsuits</rdfs:label>
        <skos:prefLabel xml:lang="en">public lawsuits</skos:prefLabel>
        <skos:definition xml:lang="en"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
        <rdfs:label xml:lang="grc">δίκαι δημόσιαι</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκαι δημόσιαι</skos:prefLabel>
        <skos:definition xml:lang="grc"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
        <skos:example xml:lang="grc">Andoc. 1.9: " ὁρῶν ὑμᾶς καὶ ἐν τοῖς ἰδίοις καὶ ἐν τοῖς δημοσίοις περὶ πλείστου τοῦτο ποιουμένους"</skos:example>
        <skos:broader rdf:resource="#Legal_proceeding"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_by_an_arrest_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
        <skos:narrower rdf:resource="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">presentation</rdfs:label>
        <skos:prefLabel xml:lang="en">presentation</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
        <rdfs:label xml:lang="grc">προβολή</rdfs:label>
        <skos:prefLabel xml:lang="grc">προβολή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
        <skos:example xml:lang="grc">Dem. 21.193: "οἶμαι τοίνυν αὐτὸν οὐδὲ τοῦ δήμου κατηγορεῖν ὀκνήσειν οὐδὲ τῆς ἐκκλησίας, ἀλλ᾽ ἅπερ τότ᾽ ἐτόλμα λέγειν ὅτ᾽ ἦν ἡ προβολή, ταῦτα καὶ νῦν ἐρεῖν, ὡς ὅσοι δέον ἐξιέναι κατέμενον καὶ ὅσοι τὰ φρούρι᾽ ἦσαν ἔρημα λελοιπότες, ἐξεκλησίασαν, καὶ χορευταὶ καὶ ξένοι καὶ τοιοῦτοί τινες ἦσαν οἳ κατεχειροτόνησαν αὐτοῦ."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Legal_proceeding_with_a_fixed_penalty">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">non-assessable lawsuit</rdfs:label>
        <skos:prefLabel xml:lang="en">non-assessable lawsuit</skos:prefLabel>
        <skos:definition xml:lang="en">A legal proceeding with a non-assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη ἀτίμητη</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη ἀτίμητη</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding with a non-assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 27.67: "καὶ νῦν κομίσασθαι τἀμαυτοῦ ζητῶν εἰς κίνδυνον καθέστηκα τὸν μέγιστον. ἂν γὰρ ἀποφύγῃ μ᾽ οὗτος, ὃ μὴ γένοιτο, τὴν ἐπωβελίαν ὀφλήσω μνᾶς ἑκατόν. καὶ τούτῳ μέν, ἐὰν καταψηφίσησθε, τιμητόν, κοὐκ ἐκ τῶν ἑαυτοῦ χρημάτων, ἀλλ᾽ ἐκ τῶν ἐμῶν ποιήσεται τὴν ἔκτεισιν: ἐμοὶ δ᾽ ἀτίμητον τοῦτ᾽ ἔστιν, ὥστ᾽ οὐ μόνον ἔσομαι τῶν πατρῴων ἀπεστερημένος, ἀλλὰ καὶ πρὸς ἠτιμωμένος, ἂν μὴ νῦν ἡμᾶς ὑμεῖς ἐλεήσητε."</skos:example>
        <rdfs:label xml:lang="grc">ἀγών ἀτίμητος</rdfs:label>
        <skos:altLabel xml:lang="grc">ἀγών ἀτίμητος</skos:altLabel>
        <skos:broader rdf:resource="#Legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for seduction</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for seduction</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">μοιχείας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">μοιχείας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Lys. 1.36: "οἷς ὑμᾶς ἀξιῶ τὴν αὐτὴν γνώμην ἔχειν: εἰ δὲ μή, τοιαύτην ἄδειαν τοῖς μοιχοῖς ποιήσετε, ὥστε1 καὶ τοὺς κλέπτας ἐπαρεῖτε φάσκειν μοιχοὺς εἶναι, εὖ εἰδότας ὅτι, ἐὰν ταύτην τὴν αἰτίαν περὶ ἑαυτῶν λέγωσι καὶ ἐπὶ τούτῳ φάσκωσιν εἰς τὰς ἀλλοτρίας οἰκίας εἰσιέναι, οὐδεὶς αὐτῶν ἅψεται. πάντες γὰρ εἴσονται ὅτι τοὺς μὲν νόμους τῆς μοιχείας χαίρειν ἐᾶν δεῖ, τὴν δὲ ψῆφον τὴν ὑμετέραν δεδιέναι: αὕτη γάρ ἐστι πάντων τῶν ἐν τῇ πόλει κυριωτάτη."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_against_guardian_withholding_property_from_ward_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit over a guardianship</rdfs:label>
        <skos:prefLabel xml:lang="en">suit over a guardianship</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding against guardian witholding property from ward, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη ἐπιτροπῆς</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη ἐπιτροπῆς</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding against guardian witholding property from ward, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <skos:example xml:lang="grc">Isaeus 7.7: " ἀνδρί τε γενομένῳ συνηγωνίσατο καὶ εἰσέπραξε τὸ ἡμικλήριον ὧν Μνήσων κατέλιπεν ὅσα τε ἐκ τῆς ἐπιτροπῆς ἀπεστέρησε, δίκας δύο ἑλών, καὶ τὴν οὐσίαν ἐποίησε κομίσασθαι τὴν αὑτοῦ πᾶσαν."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for false assertion of citizenship</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for false assertion of citizenship</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</skos:definition>
        <rdfs:label xml:lang="grc">ξενίας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ξενίας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</skos:definition>
        <skos:example xml:lang="grc">Dem. 24.131: "μὴ τοίνυν αὐτοὶ διδάσκετε, ἀλλὰ τιμωρεῖσθε. καὶ μὴ ἐᾶτ᾽ ἀγανακτεῖν εἰ δεθήσονται ἔχοντες τὰ ὑμέτερα ἀλλ᾽ ἄγετ᾽ αὐτοὺς ὑπὸ τοὺς νόμους. οὐδὲ γὰρ οἱ τῆς ξενίας ἁλισκόμενοι ἀγανακτοῦσιν ἐν τῷ οἰκήματι τούτῳ ὄντες, ἕως ἂν τῶν ψευδομαρτυριῶν ἀγωνίσωνται, ἀλλὰ μένουσιν καὶ οὐκ οἴονται δεῖν ἐγγυητὰς καταστήσαντες περιιέναι."</skos:example>
        <skos:example xml:lang="grc">Isaeus 3.37: "ἆρ᾽ οὖν δοκεῖ τῳ ὑμῶν ὀλιγώρως οὕτως ἔχειν χρημάτων Νικόδημος, ὥστε παραλιπεῖν ἄν τι τῶν τοιούτων; ἐγὼ μὲν γὰρ οὐ νομίζω. εἶτα παρὰ τούτου ὁ ἡμέτερος θεῖος ἠξίωσεν ἂν ἐγγυήσασθαι τὴν ἀδελφήν, ὃς αὐτὸς ξενίας φεύγων ὑπὸ ἑνὸς τῶν φρατόρων ὧν φησιν αὑτοῦ εἶναι, παρὰ τέτταρας ψήφους μετέσχε τῆς πόλεως; καὶ ὡς ἀληθῆ λέγω, ἀναγίγνωσκε τὴν μαρτυρίαν."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_against_theft">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for theft</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for theft</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <rdfs:label xml:lang="grc">κλοπῆς δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">κλοπῆς δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <skos:example xml:lang="grc">Aeschin. 3.10: "πολλοὶ γὰρ πάνυ τῶν ὑπευθύνων, ἐπ᾽ αὐτοφώρῳ κλέπται τῶν δημοσίων χρημάτων ὄντες ἐξελεγχόμενοι, διεφύγγανον ἐκ τῶν δικαστηρίων, εἰκότως: ᾐσχύνοντο γὰρ οἶμαι οἱ δικασταί, εἰ φανήσεται ὁ αὐτὸς ἀνὴρ ἐν τῇ αὐτῇ πόλει, πρώην1 μέν ποτε ἀναγορευόμενος ἐν τοῖς ἀγῶσιν, ὅτι στεφανοῦται ἀρετῆς ἕνεκα καὶ δικαιοσύνης ὑπὸ τοῦ δήμου χρυσῷ στεφάνῳ, ὁ δὲ αὐτὸς ἀνὴρ μικρὸν ἐπισχὼν ἔξεισιν ἐκ τοῦ δικαστηρίου κλοπῆς ἕνεκα τὰς εὐθύνας ὠφληκώς: ὥστε ἠναγκάζοντο τὴν ψῆφον φέρειν οἱ δικασταί, οὐ περὶ τοῦ παρόντος ἀδικήματος,"</skos:example>
        <skos:example xml:lang="grc">Dem. 22.26: "δεῖν δ᾽ ᾤετο μηδέν᾽ ἀποστερεῖσθαι τοῦ δίκης τυχεῖν, ὡς ἕκαστος δύναται. πῶς οὖν ἔσται τοῦτο; ἐὰν πολλὰς ὁδοὺς δῷ διὰ τῶν νόμων ἐπὶ τοὺς ἠδικηκότας οἷον τῆς κλοπῆς. ἔρρωσαι καὶ σαυτῷ πιστεύεις: ἄπαγε: ἐν χιλίαις δ᾽ ὁ κίνδυνος. ἀσθενέστερος εἶ: τοῖς ἄρχουσιν ἐφηγοῦ: τοῦτο ποιήσουσιν ἐκεῖνοι. φοβεῖ καὶ τοῦτο: γράφου."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_against_forceful_acts_of_violence">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for acts of violence</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for acts of violence</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
        <rdfs:label xml:lang="grc">βιαίων δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">βιαίων δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
        <skos:example xml:lang="grc">Dem. 37.33: "ἐνταυθὶ πόλλ᾽ ἄττα καὶ δεινά μοι ἅμ᾽ ἐγκαλεῖ: καὶ γὰρ αἴκειαν καὶ ὕβριν καὶ βιαίων καὶ πρὸς ἐπικλήρους ἀδικήματα. τούτων δ᾽ εἰσὶν ἑκάστου χωρὶς αἱ δίκαι καὶ οὔτε πρὸς ἀρχὴν τὴν αὐτὴν οὔθ᾽ ὑπὲρ τιμημάτων τῶν αὐτῶν, ἀλλ᾽ ἡ μὲν αἴκεια καὶ τὰ τῶν βιαίων πρὸς τοὺς τετταράκοντα, αἱ δὲ τῆς ὕβρεως πρὸς τοὺς θεσμοθέτας, ὅσα δ᾽ εἰς ἐπικλήρους, πρὸς τὸν ἄρχοντα. οἱ δὲ νόμοι καὶ τούτων διδόασι τὰς παραγραφὰς ἀντιλαγχάνειν, περὶ ὧν οὐκ εἰσὶν εἰσαγωγεῖς. λέγε δ᾽ αὐτοῖς τουτονὶ τὸν νόμον."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_intentional_homicide">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">intentional homicide suit</rdfs:label>
        <skos:prefLabel xml:lang="en">intentional homicide suit</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for intentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the Council of the Areopagus. If convicted, the defendant receives the non-assessable penalty of death and confiscation.</skos:definition>
        <rdfs:label xml:lang="grc">φόνος ἑκούσιος δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">φόνος ἑκούσιος δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for intentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the Council of the Areopagus. If convicted, the defendant receives the non-assessable penalty of death and confiscation.</skos:definition>
        <skos:example xml:lang="grc">Antiph. 3 3.7: "ἀκουσίως δὲ οὐχ ἧσσον ἢ ἑκουσίως ἀποκτείναντες1 μου τὸν παῖδα, τὸ παράπαν δ᾽ ἀρνούμενοι2 μὴ ἀποκτεῖναι αὐτόν, οὐδ᾽ ὑπὸ τοῦ νόμου καταλαμβάνεσθαί φασιν,3 ὃς ἀπαγορεύει μήτε δικαίως μήτε ἀδίκως ἀποκτείνειν. ἀλλὰ τίς ὁ βαλών; εἰς τίν᾽ ὁ φόνος ἀνήκει;4 εἰς τοὺς θεωμένους ἢ εἰς τοὺς παιδαγωγοὺς, ὧν οὐδεὶς οὐδὲν κατηγορεῖ; οὐ γὰρ ἀφανὴς ἀλλὰ καὶ λίαν φανερὸς ἔμοιγε αὐτοῦ ὁ θάνατός ἐστιν. ἐγὼ δὲ τὸν νόμον ὀρθῶς ἀγορεύειν φημὶ τοὺς ἀποκτείναντας κολάζεσθαι: ὅ τε γὰρ ἄκων ἀποκτείνας ἀκουσίοις κακοῖς περιπεσεῖν δίκαιός ἐστιν, ὅ τε διαφθαρεὶς οὐδὲν ἧσσον ἀκουσίως ἢ ἑκουσίως βλαφθεὶς ἀδικοῖτ᾽ ἂν ἀτιμώρητος γενόμενος."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_competing_inheritance_claims_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">lawsuit for adjudication</rdfs:label>
        <skos:prefLabel xml:lang="en">lawsuit for adjudication</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding initiated by competing claims for inheritance with no defendant or prosecutor, proceeded over by the Eponymous Archon and tried by the dikasterion. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the contested sum.</skos:definition>
        <rdfs:label xml:lang="grc">διαδικασία</rdfs:label>
        <skos:prefLabel xml:lang="grc">διαδικασία</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding initiated by competing claims for inheritance with no defendant or prosecutor, proceeded over by the Eponymous Archon and tried by the dikasterion. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the contested sum.</skos:definition>
        <skos:example xml:lang="grc">Dem. 24.54: "ὅσων δίκη πρότερον ἐγένετο ἢ εὔθυνα ἢ διαδικασία περί του ἐν δικαστηρίῳ, ἢ ἰδίᾳ ἢ δημοσίᾳ, ἢ τὸ δημόσιον ἀπέδοτο, μὴ εἰσάγειν περὶ τούτων εἰς τὸ δικαστήριον μηδ᾽ ἐπιψηφίζειν τῶν ἀρχόντων μηδένα, μηδὲ κατηγορεῖν ἐώντων ἃ οὐκ ἐῶσιν οἱ νόμοι.”</skos:example>
        <skos:example xml:lang="grc">Dem. 43.61: "ἔστιν δ᾽ ὁ νῦν ἀγὼν καὶ ἡ διαδικασία οὐκ εἴ τις ἕτερος ἑτέρου πρότερος ἢ ὕστερος τετελεύτηκεν, ἀλλ᾽ εἰ μὴ προσήκει ἐξελαθῆναι ἐκ τοῦ οἴκου τοῦ Ἁγνίου τοὺς οἰκείους τοὺς Ἁγνίου, ἀνεψιοὺς ὄντας καὶ ἀνεψιῶν παῖδας Ἁγνίᾳ πρὸς πατρός, ὑπὸ τῶν ἐκ τοῦ Στρατίου οἴκου καὶ μηδὲν προσηκόντων ὥστε κληρονομεῖν τῶν Ἁγνίου, ἀλλὰ γένει ἀπωτέρω ὄντων. περὶ τούτου νῦν ἐσθ᾽ ὁ ἀγών."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">denunciation of malefactors</rdfs:label>
        <skos:prefLabel xml:lang="en">denunciation of malefactors</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death</skos:definition>
        <rdfs:label xml:lang="grc">ἔνδειξις τῶν κακούργων</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἔνδειξις τῶν κακούργων</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death.</skos:definition>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_wrongful_financial_loss">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for damages</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for damages</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding for causing financial loss, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the sum in question.</skos:definition>
        <rdfs:label xml:lang="grc">βλάβης δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">βλάβης δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding for causing financial loss, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the sum in question.</skos:definition>
        <skos:example xml:lang="grc">Dem. 49.20: "νυνὶ δὲ τῷ Ἀντιφάνει εἴληχα βλάβης ἰδίαν δίκην, ὅτι μοι οὔτ᾽ ἐμαρτύρησεν οὔτ᾽ ἐξωμόσατο κατὰ τὸν νόμον. καὶ ἀξιῶ αὐτὸν ἀναβάντα εἰπεῖν ἐναντίον ὑμῶν διομοσάμενον, πρῶτον μὲν εἰ ἐδάνεισε Τιμοθέῳ ἐν Καλαυρείᾳ χιλίας δραχμάς, δεύτερον δ᾽ εἰ παρὰ τοῦ πατρὸς Φίλιππος ἀπέλαβεν ἐνθάδε τοῦτο τὸ ἀργύριον."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">private lawsuits</rdfs:label>
        <skos:prefLabel xml:lang="en">private lawsuits</skos:prefLabel>
        <skos:definition xml:lang="en">A legal proceeding brought forward by the injured party or a guardian.</skos:definition>
        <rdfs:label xml:lang="grc">δίκαι ἴδιαι</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκαι ἴδιαι</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding brought forward by the injured party or a guardian.</skos:definition>
        <skos:example xml:lang="grc">Andoc. 1.9: " ὁρῶν ὑμᾶς καὶ ἐν τοῖς ἰδίοις καὶ ἐν τοῖς δημοσίοις περὶ πλείστου τοῦτο ποιουμένους"</skos:example>
        <skos:broader rdf:resource="#Legal_proceeding"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_battery_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_providing_false_witness_testimony_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_illegal_defamatory_speech_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_intentional_homicide"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_unintentional_homicide"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_wrongful_financial_loss"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_against_forceful_acts_of_violence"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_interest_on_dowry_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_against_theft"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_against_obstructing_an_heir_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_competing_inheritance_claims_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_for_return_of_a_dowry_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_against_guardian_withholding_property_from_ward_"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding_against_an_illegal_prosecution_"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_for_interest_on_dowry_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">suit for maintenance</rdfs:label>
        <skos:prefLabel xml:lang="en">suit for maintenance</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding to claim interest owed on a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <rdfs:label xml:lang="grc">σίτου δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">σίτου δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding to claim interest owed on a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
        <skos:example xml:lang="grc">Dem 59.53: "τὸν μὲν τοίνυν νόμον ἀνέγνω ὑμῖν, καθ᾽ ὃν ἐγράφη Στέφανος οὑτοσὶ ὑπὸ τοῦ Φράστορος πρὸς τοὺς θεσμοθέτας. γνοὺς δ᾽ ὅτι κινδυνεύσει ἐξελεγχθεὶς ξένης θυγατέρα ἠγγυηκέναι καὶ ταῖς ἐσχάταις ζημίαις περιπεσεῖν, διαλλάττεται πρὸς τὸν Φράστορα καὶ ἀφίσταται τῆς προικός, καὶ τὴν δίκην τοῦ σίτου ἀνείλετο, καὶ ὁ Φράστωρ τὴν γραφὴν παρὰ τῶν θεσμοθετῶν. καὶ ὡς ἀληθῆ λέγω, τούτων ὑμῖν μάρτυρα αὐτὸν τὸν Φράστορα καλῶ, καὶ ἀναγκάσω μαρτυρεῖν κατὰ τὸν νόμον."</skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Legal_proceeding_with_an_assessable_penalty">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">assessable lawsuit</rdfs:label>
        <skos:prefLabel xml:lang="en">assessable lawsuit</skos:prefLabel>
        <skos:definition xml:lang="en">Lawsuit with assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη τιμητή</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη τιμητή</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding with an assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 27.67: "καὶ νῦν κομίσασθαι τἀμαυτοῦ ζητῶν εἰς κίνδυνον καθέστηκα τὸν μέγιστον. ἂν γὰρ ἀποφύγῃ μ᾽ οὗτος, ὃ μὴ γένοιτο, τὴν ἐπωβελίαν ὀφλήσω μνᾶς ἑκατόν. καὶ τούτῳ μέν, ἐὰν καταψηφίσησθε, τιμητόν, κοὐκ ἐκ τῶν ἑαυτοῦ χρημάτων, ἀλλ᾽ ἐκ τῶν ἐμῶν ποιήσεται τὴν ἔκτεισιν: ἐμοὶ δ᾽ ἀτίμητον τοῦτ᾽ ἔστιν, ὥστ᾽ οὐ μόνον ἔσομαι τῶν πατρῴων ἀπεστερημένος, ἀλλὰ καὶ πρὸς ἠτιμωμένος, ἂν μὴ νῦν ἡμᾶς ὑμεῖς ἐλεήσητε."</skos:example>
        <rdfs:label xml:lang="grc">ἀγών τιμητός</rdfs:label>
        <skos:altLabel xml:lang="grc">ἀγών τιμητός</skos:altLabel>
        <skos:broader rdf:resource="#Legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for accepting bribes</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for accepting bribes</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for accepting bribes, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of death or a fine ten times the bribe.</skos:definition>
        <rdfs:label xml:lang="grc">δωροδοκίας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">δωροδοκίας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for accepting bribes, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of death or a fine ten times the bribe.</skos:definition>
        <skos:example xml:lang="grc">Aeschin. 2.3: "ἀλλ᾽ οἶμαι Δημοσθένης οὐ χαίρει δικαίοις λόγοις, οὐδ᾽ οὕτω παρεσκεύασται, ἀλλὰ τὴν ὑμετέραν ὀργὴν ἐκκαλέσασθαι βεβούληται. καὶ κατηγόρηκε δωροδοκίας, ἀπίθανος ὢν πρὸς τὴν ὑποψίαν ταύτην: τὸν γὰρ ἐπὶ ταῖς δωροδοκίαις προτρεπόμενον ὀργίζεσθαι, αὐτὸν χρὴ τῶν τοιούτων ἔργων ἀπέχεσθαι."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_impiety_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for impiety</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for impiety</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for impiety, proceeded over by the Basileus and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death.
</skos:definition>
        <rdfs:label xml:lang="grc">ἀσεβείας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀσεβείας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for impiety, proceeded over by the Basileus and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death.
</skos:definition>
        <skos:example xml:lang="grc">Dem. 22.2: "αἰτιασάμενος γάρ με, ἃ καὶ λέγειν ἂν ὀκνήσειέ τις, εἰ μὴ τύχοι προσόμοιος ὢν τούτῳ, τὸν πατέρ᾽ ὡς ἀπέκτον᾽ ἐγὼ τὸν ἐμαυτοῦ, καὶ κατασκευάσας ἀσεβείας γραφὴν οὐκ ἐπ᾽ ἐμέ, ἀλλ᾽ ἐπὶ τὸν θεῖόν μου, γράψας ἀσεβεῖν ἐμοὶ συνιόντ᾽ εἰς ταὐτὸν ὡς πεποιηκότι ταῦτα, εἰς ἀγῶνα κατέστησεν: ὃν εἰ συνέβη τόθ᾽ ἁλῶναι, τίς ἂν ἀθλιώτερ᾽ ἐμοῦ πεπονθὼς ἦν ὑπὸ τούτου; τίς γὰρ ἂν ἢ φίλος ἢ ξένος εἰς ταὐτό ποτ᾽ ἐλθεῖν ἠθέλησεν ἐμοί; τίς δ᾽ ἂν εἴασε πόλις που παρ᾽ ἑαυτῇ γενέσθαι τὸν τὸ τοιοῦτ᾽ ἀσέβημα δοκοῦντ᾽ εἰργάσθαι; οὐκ ἔστιν οὐδὲ μία."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing___">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment</skos:prefLabel>
        <skos:definition xml:lang="en">Public lawsuits initiated by submitting a charge in writing</skos:definition>
        <rdfs:label xml:lang="grc">γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by submitting a charge in writing, in which the defendant is summoned when the prosecutor issues oral summons at the Assembly. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
        <skos:example xml:lang="grc">Antiph. 1.2: "ἡ γὰρ τύχη καὶ αὐτοὶ οὗτοι ἠνάγκασαν ἐμοὶ πρὸς τούτους αὐτοὺς τὸν ἀγῶνα καταστῆναι, οὓς εἰκὸς ἦν τῷ μὲν τεθνεῶτι τιμωροὺς γενέσθαι, τῷ δ᾽ ἐπεξιόντι βοηθούς. νῦν δὲ τούτων τἀναντία γεγένηται: αὐτοὶ γὰρ οὗτοι καθεστᾶσιν ἀντίδικοι καὶ φονῆς, ὡς καὶ ἐγὼ καὶ ἡ γραφὴ λέγει."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_prostitution_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_impiety_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_crimes_against_humanity_"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_for_maltreatment">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">impeachment for maltreatment</rdfs:label>
        <skos:prefLabel xml:lang="en">impeachment for maltreatment</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
        <rdfs:label xml:lang="grc">εἰσαγγελία κάκωσις</rdfs:label>
        <skos:prefLabel xml:lang="grc">εἰσαγγελία κάκωσις</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Private_legal_proceeding_against_an_illegal_prosecution_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">counter-indictment</rdfs:label>
        <skos:prefLabel xml:lang="en">counter-indictment</skos:prefLabel>
        <skos:definition xml:lang="en">A private legal proceeding initiated by submitting a charge in writing to block an illegal prosecution, tried before the dikasterion.</skos:definition>
        <rdfs:label xml:lang="grc">παραγραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">παραγραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A private legal proceeding initiated by submitting a charge in writing to block an illegal prosecution, tried before the dikasterion.</skos:definition>
        <skos:example xml:lang="grc">Dem. 45.42: "οὐκοῦν ἐναντία μὲν ἡ παραγραφὴ πᾶσι τοῖς μεμαρτυρημένοις, ἐναντία δ᾽ ἣν ἀνέγνων ὑμῖν ἄρτι μίσθωσιν, τῇδε τῇ διαθήκῃ: οὐδὲν δὲ τῶν πεπραγμένων οὔτ᾽ εὔλογον οὔθ᾽ ἁπλοῦν οὔθ᾽ ὁμολογούμενον αὐτὸ ἑαυτῷ φαίνεται. ἐκ δὲ τούτου τοῦ τρόπου πάντα πεπλασμένα καὶ κατεσκευασμέν᾽ ἐλέγχεται." </skos:example>
        <skos:broader rdf:resource="#Private_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Legal_proceeding">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">lawsuit</rdfs:label>
        <skos:prefLabel xml:lang="en">lawsuit</skos:prefLabel>
        <skos:definition xml:lang="en">A legal proceeding in the classical Athenian court system.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding in the classical Athenian court system.</skos:definition>
        <skos:example xml:lang="grc">Aeschin. 1.44: "ᾗ δὴ καὶ πάνυ χαίρω, ὅτι μοι γέγονεν ἡ δίκη πρὸς ἄνθρωπον οὐκ ἠγνοημένον ὑφ᾽ ὑμῶν, οὐδ᾽ ἀπ᾽ ἄλλου γιγνωσκόμενον οὐδενός, ἢ ἀπ᾽ αὐτοῦ τοῦ ἐπιτηδεύματος περὶ οὗ καὶ τὴν ψῆφον μέλλετε φέρειν."</skos:example>
        <skos:narrower rdf:resource="#Public_legal_proceeding"/>
        <skos:narrower rdf:resource="#Private_legal_proceeding"/>
        <skos:narrower rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
        <skos:narrower rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">scrutiny</rdfs:label>
        <skos:prefLabel xml:lang="en">scrutiny</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated before a magistrate's term and proceeded over by the Thesmothetae.</skos:definition>
        <rdfs:label xml:lang="grc">δοκιμασία</rdfs:label>
        <skos:prefLabel xml:lang="grc">δοκιμασία</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated before a magistrate's term and proceeded over by the Thesmothetae.</skos:definition>
        <skos:example xml:lang="grc">Aeschin. 1.28: "τίνας δ᾽ οὐκ ᾤετο δεῖν λέγειν; τοὺς αἰσχρῶς βεβιωκότας: τούτους οὐκ ἐᾷ δημηγορεῖν. καὶ ποῦ τοῦτο δηλοῖ; ‘δοκιμασία,’ φησί, ‘ῥητόρων: ἐάν τις λέγῃ ἐν τῷ δήμῳ τὸν πατέρα τύπτων ἢ τὴν μητέρα, ἢ μὴ τρέφων, ἢ μὴ παρέχων οἴκησιν:’ τοῦτον οὐκ ἐᾷ λέγειν. νὴ Δία καλῶς γε, ὡς ἔγωγέ φημι. διὰ τί; ὅτι εἴ τις, οὓς ἐξ ἴσου δεῖ τιμᾶν τοῖς θεοῖς, εἰς τούτους ἐστὶ φαῦλος, τί ποτε, φησίν, ὑπ᾽ αὐτοῦ πείσονται οἱ ἀλλότριοι καὶ ἡ πόλις ὅλη; καὶ τίσι δεύτερον ἀπεῖπε μὴ λέγειν; ‘ἢ τὰς στρατείας,’"</skos:example>
        <skos:example xml:lang="grc">Lys. 26.16: "καίτοιγε αὐτὸν ἀκούω λέξειν ὡς οὐ περὶ αὐτοῦ μόνον ἡ δοκιμασία ἐστίν, ἀλλὰ περὶ πάντων τῶν ἐν ἄστει μεινάντων, καὶ τοὺς ὅρκους καὶ τὰς συνθήκας ὑμᾶς ὑπομνήσειν, ὡς ἐκ τούτων προσληψόμενον αὐτὸν δοκιμαστὰς τοὺς ἐν ἄστει μείναντας. ἐγὼ δ᾽ ὑπὲρ τοῦ πλήθους βραχέα πρὸς αὐτὸν εἰπεῖν βούλομαι, ὅτι ὁ δῆμος οὐ τὴν αὐτὴν γνώμην ἔχει περὶ πάντων τῶν ἐν ἄστει μεινάντων, ἀλλὰ περὶ μὲν τῶν τοιαῦτα ἐξαμαρτανόντων οἵαν ἐγώ φημι δεῖν,"</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for confiscation</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for confiscation</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for withholding property from the state, proceeded over by the Eleven, and tried by the dikasterion. If convicted, the defendant pays an assessable fine and the prosecutor gets one third of the contested property.</skos:definition>
        <rdfs:label xml:lang="grc">ἀπογραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀπογραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for withholding property from the state, proceeded over by the Eleven, and tried by the dikasterion. If convicted, the defendant pays an assessable fine and the prosecutor gets one third of the contested property.</skos:definition>
        <skos:example xml:lang="grc">Dem. 53.3: "εἰ μὲν οὖν μοι ἦν ἱκανὸν τὸ ὕδωρ διηγήσασθαι πρὸς ὑμᾶς τὰ ἐξ ἀρχῆς, ὅσ᾽ ἀγαθὰ πεπονθότες ὑπ᾽ ἐμοῦ οἷά με εἰργασμένοι εἰσίν, εὖ οἶδ᾽ ὅτι ὑμεῖς τ᾽ ἄν μοι ἔτι μᾶλλον συγγνώμην εἴχετε τοῦ ὀργίζεσθαι αὐτοῖς, τούτους τ᾽ ἀνοσιωτάτους ἀνθρώπων ἡγήσασθε εἶναι: νῦν δ᾽ οὐδὲ διπλάσιόν μοι τούτου ὕδωρ ἱκανὸν ἂν γένοιτο. τὰ μὲν οὖν μέγιστα καὶ περιφανῆ τῶν ἀδικημάτων, καὶ ὁπόθεν ἡ ἀπογραφὴ αὕτη γέγονεν, ἐρῶ πρὸς ὑμᾶς, τὰ δὲ πολλὰ ἐάσω."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_by_denouncing_an_offender">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">denunciation</rdfs:label>
        <skos:prefLabel xml:lang="en">denunciation</skos:prefLabel>
        <skos:definition xml:lang="en">Public lawsuits inititated by denouncing an offender to a magistrate who carries out the arrest</skos:definition>
        <rdfs:label xml:lang="grc">ἔνδειξις</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἔνδειξις</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding inititated by denouncing an offender to a magistrate who carries out the arrest, proceeded over by the Eleven, tried in the dikasterion.</skos:definition>
        <skos:example xml:lang="grc">Andoc. 1.10: "ὥσπερ δὲ καὶ προεῖπον ὑμῖν, ὦ ἄνδρες, ἐξ ἀρχῆς περὶ πάντων ποιήσομαι τὴν ἀπολογίαν, πρῶτον μὲν περὶ αὐτῆς τῆς αἰτίας ὅθεν περ ἡ ἔνδειξις ἐγένετο, διόπερ εἰς τὸν ἀγῶνα τόνδε κατέστην, περὶ τῶν μυστηρίων"</skos:example>
        <skos:example xml:lang="grc">Dem. 24.22: "ἐὰν δ᾽ οἱ πρυτάνεις μὴ ποιήσωσι κατὰ τὰ γεγραμμένα τὴν ἐκκλησίαν ἢ οἱ πρόεδροι μὴ χρηματίσωσι, ὀφείλειν τῶν μὲν πρυτάνεων ἕκαστον χιλίας δραχμὰς ἱερὰς τῇ Ἀθηνᾷ, τῶν δὲ προέδρων ἕκαστος ὀφειλέτω τετταράκοντα δραχμὰς ἱερὰς τῇ Ἀθηνᾷ. καὶ ἔνδειξις αὐτῶν ἔστω πρὸς τοὺς θεσμοθέτας, καθάπερ ἐάν τις ἄρχῃ ὀφείλων τῷ δημοσίῳ: οἱ δὲ θεσμοθέται τοὺς ἐνδειχθέντας εἰσαγόντων εἰς τὸ δικαστήριον κατὰ τὸν νόμον, ἢ μὴ ἀνιόντων εἰς Ἄρειον πάγον, ὡς καταλύοντες τὴν ἐπανόρθωσιν τῶν νόμων."</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding"/>
        <skos:narrower rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/oratory_v.1.0"/>
        <rdfs:label xml:lang="en">indictment for illegal proposals</rdfs:label>
        <skos:prefLabel xml:lang="en">indictment for illegal proposals</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</skos:definition>
        <rdfs:label xml:lang="grc">παρανόμων γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">παρανόμων γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</skos:definition>
        <skos:example xml:lang="grc">Dem. 18.13: " ἀλλ᾽ ἐφ᾽ οἷς ἀδικοῦντά μ᾽ ἑώρα τὴν πόλιν, οὖσί γε τηλικούτοις ἡλίκα νῦν ἐτραγῴδει καὶ διεξῄει, ταῖς ἐκ τῶν νόμων τιμωρίαις παρ᾽ αὐτὰ τἀδικήματα χρῆσθαι, εἰ μὲν εἰσαγγελίας ἄξια πράττονθ᾽ ἑώρα, εἰσαγγέλλοντα καὶ τοῦτον τὸν τρόπον εἰς κρίσιν καθιστάντα παρ᾽ ὑμῖν, εἰ δὲ γράφοντα παράνομα, παρανόμων γραφόμενον"</skos:example>
        <skos:broader rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </skos:Concept>

