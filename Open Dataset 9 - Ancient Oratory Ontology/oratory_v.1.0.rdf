    <ontolex:LexicalEntry rdf:about="#review_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_review_en">
                <ontolex:writtenRep xml:lang="en">review</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_review_en">
                <ontolex:isEvokedBy rdf:resource="#review_en"/>
                <skos:definition xml:lang="en">A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#battery_suit_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_battery_suit_en">
                <ontolex:writtenRep xml:lang="en">battery suit</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_battery_suit_en">
                <ontolex:isEvokedBy rdf:resource="#battery_suit_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_battery_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#impeachment_for_maltreatment_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_impeachment_for_maltreatment_en">
                <ontolex:writtenRep xml:lang="en">impeachment for maltreatment</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_impeachment_for_maltreatment_en">
                <ontolex:isEvokedBy rdf:resource="#impeachment_for_maltreatment_en"/>
                <skos:definition xml:lang="en">A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#public_lawsuits_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_public_lawsuits_en">
                <ontolex:writtenRep xml:lang="en">public lawsuits</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_public_lawsuits_en">
                <ontolex:isEvokedBy rdf:resource="#public_lawsuits_en"/>
                <skos:definition xml:lang="en"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_acts_of_violence_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_acts_of_violence_en">
                <ontolex:writtenRep xml:lang="en">suit for acts of violence</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_acts_of_violence_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_acts_of_violence_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_forceful_acts_of_violence"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#denunciation_of_malefactors_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_denunciation_of_malefactors_en">
                <ontolex:writtenRep xml:lang="en">denunciation of malefactors</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_denunciation_of_malefactors_en">
                <ontolex:isEvokedBy rdf:resource="#denunciation_of_malefactors_en"/>
                <skos:definition xml:lang="en">A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_a_dowry_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_a_dowry_en">
                <ontolex:writtenRep xml:lang="en">suit for a dowry</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_a_dowry_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_a_dowry_en"/>
                <skos:definition xml:lang="en">A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_return_of_a_dowry_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#non-assessable_lawsuit_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_non-assessable_lawsuit_en">
                <ontolex:writtenRep xml:lang="en">non-assessable lawsuit</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_non-assessable_lawsuit_en">
                <ontolex:isEvokedBy rdf:resource="#non-assessable_lawsuit_en"/>
                <skos:definition xml:lang="en">A legal proceeding with a non-assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#defamation_suit_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_defamation_suit_en">
                <ontolex:writtenRep xml:lang="en">defamation suit</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_defamation_suit_en">
                <ontolex:isEvokedBy rdf:resource="#defamation_suit_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_illegal_defamatory_speech_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_theft_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_theft_en">
                <ontolex:writtenRep xml:lang="en">suit for theft</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_theft_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_theft_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_theft"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_false_assertion_of_citizenship_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_false_assertion_of_citizenship_en">
                <ontolex:writtenRep xml:lang="en">indictment for false assertion of citizenship</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_false_assertion_of_citizenship_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_false_assertion_of_citizenship_en"/>
                <skos:definition xml:lang="en">A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#impeachment_for_treason_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_impeachment_for_treason_en">
                <ontolex:writtenRep xml:lang="en">impeachment for treason</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_impeachment_for_treason_en">
                <ontolex:isEvokedBy rdf:resource="#impeachment_for_treason_en"/>
                <skos:definition xml:lang="en">A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_illegal_proposals_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_illegal_proposals_en">
                <ontolex:writtenRep xml:lang="en">indictment for illegal proposals</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_illegal_proposals_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_illegal_proposals_en"/>
                <skos:definition xml:lang="en">A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_impiety_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_impiety_en">
                <ontolex:writtenRep xml:lang="en">indictment for impiety</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_impiety_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_impiety_en"/>
                <skos:definition xml:lang="en">A public indictment for impiety, proceeded over by the Basileus and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death.
</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_impiety_"/>
