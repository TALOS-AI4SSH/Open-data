    <owl:Class rdf:about="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_">
        <rdfs:label xml:lang="en">intentional wounding suit</rdfs:label>
        <skos:prefLabel xml:lang="en">intentional wounding suit</skos:prefLabel>
        <skos:definition xml:lang="en">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <rdfs:label xml:lang="grc">τραύματος ἐκ προνοίας γραφή</rdfs:label>
        <skos:prefLabel xml:lang="grc">τραύματος ἐκ προνοίας γραφή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
        <skos:example xml:lang="grc">Dem 23.22: "δικάζειν δὲ τὴν βουλὴν τὴν ἐν Ἀρείῳ πάγῳ φόνου καὶ τραύματος ἐκ προνοίας καὶ πυρκαϊᾶς καὶ φαρμάκων, ἐάν τις ἀποκτείνῃ δούς."</skos:example>
        <rdfs:subClassOf rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_crimes_against_humanity_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_"/>
        <owl:disjointWith rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
