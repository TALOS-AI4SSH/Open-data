            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_scrutiny_en">
                <ontolex:isEvokedBy rdf:resource="#scrutiny_en"/>
                <skos:definition xml:lang="en">A public legal proceeding initiated before a magistrate's term and proceeded over by the Thesmothetae.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_"/>
