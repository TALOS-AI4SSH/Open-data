                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#the_Forty"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#dikasterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#prosecutor_issues_oral_summons_at_the_Assembly"/>
            </owl:Restriction>
        </rdfs:subClassOf>
