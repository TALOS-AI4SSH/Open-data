            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_presentation_en">
                <ontolex:isEvokedBy rdf:resource="#presentation_en"/>
                <skos:definition xml:lang="en">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_confiscation_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_confiscation_en">
                <ontolex:writtenRep xml:lang="en">indictment for confiscation</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_confiscation_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_confiscation_en"/>
                <skos:definition xml:lang="en">A public indictment for withholding property from the state, proceeded over by the Eleven, and tried by the dikasterion. If convicted, the defendant pays an assessable fine and the prosecutor gets one third of the contested property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_maintenance_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_maintenance_en">
