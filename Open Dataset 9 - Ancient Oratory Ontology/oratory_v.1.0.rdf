	<!--  OTV Terms -->

    <otv:Term rdf:about="#review_en">
        <rdfs:label xml:lang="en">review</rdfs:label>
        <otv:termName>review</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</otv:termDefinition>
        <skos:definition xml:lang="en">A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#battery_suit_en">
        <rdfs:label xml:lang="en">battery suit</rdfs:label>
        <otv:termName>battery suit</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Private_legal_proceeding_for_battery_"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</otv:termDefinition>
        <skos:definition xml:lang="en">A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#impeachment_for_maltreatment_en">
        <rdfs:label xml:lang="en">impeachment for maltreatment</rdfs:label>
        <otv:termName>impeachment for maltreatment</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</otv:termDefinition>
        <skos:definition xml:lang="en">A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#public_lawsuits_en">
        <rdfs:label xml:lang="en">public lawsuits</rdfs:label>
        <otv:termName>public lawsuits</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition> A legal proceeding brought forward by any adult male citizen who wishes.</otv:termDefinition>
        <skos:definition xml:lang="en"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#suit_for_acts_of_violence_en">
        <rdfs:label xml:lang="en">suit for acts of violence</rdfs:label>
        <otv:termName>suit for acts of violence</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Private_legal_proceeding_against_forceful_acts_of_violence"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</otv:termDefinition>
        <skos:definition xml:lang="en">A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#denunciation_of_malefactors_en">
        <rdfs:label xml:lang="en">denunciation of malefactors</rdfs:label>
        <otv:termName>denunciation of malefactors</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death</otv:termDefinition>
        <skos:definition xml:lang="en">A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#suit_for_a_dowry_en">
        <rdfs:label xml:lang="en">suit for a dowry</rdfs:label>
        <otv:termName>suit for a dowry</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Private_legal_proceeding_for_return_of_a_dowry_"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</otv:termDefinition>
        <skos:definition xml:lang="en">A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
    </otv:Term>

