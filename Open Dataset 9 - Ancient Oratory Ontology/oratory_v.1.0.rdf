            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_intentional_wounding_suit_en">
                <ontolex:isEvokedBy rdf:resource="#intentional_wounding_suit_en"/>
                <skos:definition xml:lang="en">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#summary_arrest_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_summary_arrest_en">
                <ontolex:writtenRep xml:lang="en">summary arrest</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_summary_arrest_en">
                <ontolex:isEvokedBy rdf:resource="#summary_arrest_en"/>
                <skos:definition xml:lang="en">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_by_an_arrest_"/>
    </ontolex:LexicalEntry>

