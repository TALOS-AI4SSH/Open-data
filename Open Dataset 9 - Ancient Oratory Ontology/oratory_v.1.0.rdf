                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#the_Assembly_or_the_Council_of_500"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#prosecutor_issues_oral_summons_at_the_Assembly"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#for_major_offenses_against_the_state"/>
            </owl:Restriction>
        </rdfs:subClassOf>
