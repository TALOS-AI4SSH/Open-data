        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_private_lawsuits_en">
                <ontolex:isEvokedBy rdf:resource="#private_lawsuits_en"/>
                <skos:definition xml:lang="en">A legal proceeding brought forward by the injured party or a guardian.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#intentional_homicide_suit_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_intentional_homicide_suit_en">
                <ontolex:writtenRep xml:lang="en">intentional homicide suit</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_intentional_homicide_suit_en">
                <ontolex:isEvokedBy rdf:resource="#intentional_homicide_suit_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for intentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the Council of the Areopagus. If convicted, the defendant receives the non-assessable penalty of death and confiscation.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_intentional_homicide"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_prostitution_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_prostitution_en">
                <ontolex:writtenRep xml:lang="en">indictment for prostitution</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_prostitution_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_prostitution_en"/>
                <skos:definition xml:lang="en">A public indictment for exercising citizenship rights having engaged in prostitution, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_prostitution_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_seduction_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_seduction_en">
                <ontolex:writtenRep xml:lang="en">indictment for seduction</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_seduction_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_seduction_en"/>
                <skos:definition xml:lang="en">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_ejectment_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_ejectment_en">
                <ontolex:writtenRep xml:lang="en">suit for ejectment</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_ejectment_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_ejectment_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for physically obstructing someone from their inheritance, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of restoring the property to the heir and paying its value to the state. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_obstructing_an_heir_"/>
    </ontolex:LexicalEntry>

