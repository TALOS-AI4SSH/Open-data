            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_maintenance_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_maintenance_en"/>
                <skos:definition xml:lang="en">A private legal proceeding to claim interest owed on a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_interest_on_dowry_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_accepting_bribes_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_accepting_bribes_en">
                <ontolex:writtenRep xml:lang="en">indictment for accepting bribes</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_accepting_bribes_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_accepting_bribes_en"/>
                <skos:definition xml:lang="en">A public indictment for accepting bribes, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of death or a fine ten times the bribe.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_"/>
    </ontolex:LexicalEntry>

