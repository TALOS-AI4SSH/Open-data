    <owl:Class rdf:about="#Legal_proceeding_with_an_assessable_penalty">
        <rdfs:label xml:lang="en">assessable lawsuit</rdfs:label>
        <skos:prefLabel xml:lang="en">assessable lawsuit</skos:prefLabel>
        <skos:definition xml:lang="en">Lawsuit with assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη τιμητή</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη τιμητή</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding with an assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 27.67: "καὶ νῦν κομίσασθαι τἀμαυτοῦ ζητῶν εἰς κίνδυνον καθέστηκα τὸν μέγιστον. ἂν γὰρ ἀποφύγῃ μ᾽ οὗτος, ὃ μὴ γένοιτο, τὴν ἐπωβελίαν ὀφλήσω μνᾶς ἑκατόν. καὶ τούτῳ μέν, ἐὰν καταψηφίσησθε, τιμητόν, κοὐκ ἐκ τῶν ἑαυτοῦ χρημάτων, ἀλλ᾽ ἐκ τῶν ἐμῶν ποιήσεται τὴν ἔκτεισιν: ἐμοὶ δ᾽ ἀτίμητον τοῦτ᾽ ἔστιν, ὥστ᾽ οὐ μόνον ἔσομαι τῶν πατρῴων ἀπεστερημένος, ἀλλὰ καὶ πρὸς ἠτιμωμένος, ἂν μὴ νῦν ἡμᾶς ὑμεῖς ἐλεήσητε."</skos:example>
        <rdfs:label xml:lang="grc">ἀγών τιμητός</rdfs:label>
        <skos:altLabel xml:lang="grc">ἀγών τιμητός</skos:altLabel>
        <rdfs:subClassOf rdf:resource="#Legal_proceeding"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_unintentional_homicide"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_prostitution_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_illegal_defamatory_speech_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_by_an_arrest_"/>
        <owl:disjointWith rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_intentional_homicide"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_impiety_"/>
