    </owl:Class>

    <owl:Class rdf:about="#Public_legal_proceeding_initiated_by_an_arrest_">
        <rdfs:label xml:lang="en">summary arrest</rdfs:label>
        <skos:prefLabel xml:lang="en">summary arrest</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
        <rdfs:label xml:lang="grc">ἀπαγωγή</rdfs:label>
        <skos:prefLabel xml:lang="grc">ἀπαγωγή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 24.146: "ὡς δὲ σαφῶς γνώσεσθ᾽ ὅτι ἀληθῆ λέγω, ἐγὼ ὑμῖν ἐρῶ. οὔτε γὰρ ἄν, ὦ ἄνδρες δικασταί, τιμᾶν ἐξῆν ὑμῖν ὅ τι χρὴ παθεῖν ἢ ἀποτεῖσαι （ἐν γὰρ τῷ παθεῖν καὶ ὁ δεσμὸς ἔνι: οὐκ ἂν οὖν ἐξῆν δεσμοῦ τιμῆσαι）, οὔθ᾽ ὅσων ἔνδειξίς ἐστιν ἢ ἀπαγωγὴ προσεγέγραπτ᾽ ἂν ἐν τοῖς νόμοις ‘τὸν δ᾽ ἐνδειχθέντα ἢ ἀπαχθέντα δησάντων οἱ ἕνδεκα ἐν τῷ ξύλῳ,’ εἴπερ μὴ ἐξῆν ἄλλους ἢ τοὺς ἐπὶ προδοσίᾳ τῆς πόλεως ἢ ἐπὶ καταλύσει τοῦ δήμου συνιόντας ἢ τοὺς τὰ τέλη ὠνουμένους καὶ μὴ καταβάλλοντας δῆσαι."σει τοῦ δήμου συνιόντας ἢ τοὺς τὰ τέλη ὠνουμένους καὶ μὴ καταβάλλοντας δῆσαι.</skos:example>
        <rdfs:subClassOf rdf:resource="#Public_legal_proceeding"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
        <owl:disjointWith rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#initiated_by_arresting_an_offender_and_bringing_to_a_magistrate__"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#the_Eleven"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#dikasterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#arrest"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#non-assessable_penalty"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#penalty_of_1000_drachmas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#death"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Public_legal_proceeding">
        <rdfs:label xml:lang="en">public lawsuits</rdfs:label>
        <skos:prefLabel xml:lang="en">public lawsuits</skos:prefLabel>
        <skos:definition xml:lang="en"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
        <rdfs:label xml:lang="grc">δίκαι δημόσιαι</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκαι δημόσιαι</skos:prefLabel>
        <skos:definition xml:lang="grc"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
        <skos:example xml:lang="grc">Andoc. 1.9: " ὁρῶν ὑμᾶς καὶ ἐν τοῖς ἰδίοις καὶ ἐν τοῖς δημοσίοις περὶ πλείστου τοῦτο ποιουμένους"</skos:example>
        <rdfs:subClassOf rdf:resource="#Legal_proceeding"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#brought_forward_by_anyone_who_wishes"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_">
        <rdfs:label xml:lang="en">presentation</rdfs:label>
        <skos:prefLabel xml:lang="en">presentation</skos:prefLabel>
        <skos:definition xml:lang="en">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
        <rdfs:label xml:lang="grc">προβολή</rdfs:label>
        <skos:prefLabel xml:lang="grc">προβολή</skos:prefLabel>
        <skos:definition xml:lang="grc">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
        <skos:example xml:lang="grc">Dem. 21.193: "οἶμαι τοίνυν αὐτὸν οὐδὲ τοῦ δήμου κατηγορεῖν ὀκνήσειν οὐδὲ τῆς ἐκκλησίας, ἀλλ᾽ ἅπερ τότ᾽ ἐτόλμα λέγειν ὅτ᾽ ἦν ἡ προβολή, ταῦτα καὶ νῦν ἐρεῖν, ὡς ὅσοι δέον ἐξιέναι κατέμενον καὶ ὅσοι τὰ φρούρι᾽ ἦσαν ἔρημα λελοιπότες, ἐξεκλησίασαν, καὶ χορευταὶ καὶ ξένοι καὶ τοιοῦτοί τινες ἦσαν οἳ κατεχειροτόνησαν αὐτοῦ."</skos:example>
        <rdfs:subClassOf rdf:resource="#Public_legal_proceeding"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_by_an_arrest_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#initiated_by_a_vote_before_the_Assembly_to_condemn_or_acquit_the_offender_"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#the_Assembly"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#prosecutor_issues_oral_summons_at_the_Assembly"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#formal_sanction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#penalty_of_1000_drachmas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Legal_proceeding_with_a_fixed_penalty">
        <rdfs:label xml:lang="en">non-assessable lawsuit</rdfs:label>
        <skos:prefLabel xml:lang="en">non-assessable lawsuit</skos:prefLabel>
        <skos:definition xml:lang="en">A legal proceeding with a non-assessable penalty.</skos:definition>
        <rdfs:label xml:lang="grc">δίκη ἀτίμητη</rdfs:label>
        <skos:prefLabel xml:lang="grc">δίκη ἀτίμητη</skos:prefLabel>
        <skos:definition xml:lang="grc">A legal proceeding with a non-assessable penalty.</skos:definition>
        <skos:example xml:lang="grc">Dem. 27.67: "καὶ νῦν κομίσασθαι τἀμαυτοῦ ζητῶν εἰς κίνδυνον καθέστηκα τὸν μέγιστον. ἂν γὰρ ἀποφύγῃ μ᾽ οὗτος, ὃ μὴ γένοιτο, τὴν ἐπωβελίαν ὀφλήσω μνᾶς ἑκατόν. καὶ τούτῳ μέν, ἐὰν καταψηφίσησθε, τιμητόν, κοὐκ ἐκ τῶν ἑαυτοῦ χρημάτων, ἀλλ᾽ ἐκ τῶν ἐμῶν ποιήσεται τὴν ἔκτεισιν: ἐμοὶ δ᾽ ἀτίμητον τοῦτ᾽ ἔστιν, ὥστ᾽ οὐ μόνον ἔσομαι τῶν πατρῴων ἀπεστερημένος, ἀλλὰ καὶ πρὸς ἠτιμωμένος, ἂν μὴ νῦν ἡμᾶς ὑμεῖς ἐλεήσητε."</skos:example>
        <rdfs:label xml:lang="grc">ἀγών ἀτίμητος</rdfs:label>
        <skos:altLabel xml:lang="grc">ἀγών ἀτίμητος</skos:altLabel>
        <rdfs:subClassOf rdf:resource="#Legal_proceeding"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_battery_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_return_of_a_dowry_"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_against_obstructing_an_heir_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_crimes_against_humanity_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_against_guardian_withholding_property_from_ward_"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_against_theft"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_against_forceful_acts_of_violence"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_wrongful_financial_loss"/>
        <owl:disjointWith rdf:resource="#Private_legal_proceeding_for_interest_on_dowry_"/>
        <owl:disjointWith rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_"/>
        <owl:disjointWith rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
        <rdfs:subClassOf>
            <owl:Restriction>
