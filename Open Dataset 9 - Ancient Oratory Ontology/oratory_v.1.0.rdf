            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_avoiding_military_service_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_avoiding_military_service_en"/>
                <skos:definition xml:lang="en">A public indictment for avoiding military service, proceeded over by the Strategoi and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of disenfranchisement.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service"/>
    </ontolex:LexicalEntry>

