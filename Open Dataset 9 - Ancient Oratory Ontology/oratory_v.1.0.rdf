        <skos:definition xml:lang="en">A legal proceeding with a non-assessable penalty.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#defamation_suit_en">
        <rdfs:label xml:lang="en">defamation suit</rdfs:label>
        <otv:termName>defamation suit</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Private_legal_proceeding_for_illegal_defamatory_speech_"/>
