            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#for_maltreatment_of_parents_orphans_and_heiresses"/>
            </owl:Restriction>
        </rdfs:subClassOf>
