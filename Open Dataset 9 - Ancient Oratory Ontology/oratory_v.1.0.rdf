    <ontolex:LexicalEntry rdf:about="#suit_over_a_guardianship_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_over_a_guardianship_en">
                <ontolex:writtenRep xml:lang="en">suit over a guardianship</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_over_a_guardianship_en">
                <ontolex:isEvokedBy rdf:resource="#suit_over_a_guardianship_en"/>
                <skos:definition xml:lang="en">A private legal proceeding against guardian witholding property from ward, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_guardian_withholding_property_from_ward_"/>
    </ontolex:LexicalEntry>

