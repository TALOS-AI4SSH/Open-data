        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</otv:termDefinition>
        <skos:definition xml:lang="en">A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#suit_for_theft_en">
        <rdfs:label xml:lang="en">suit for theft</rdfs:label>
        <otv:termName>suit for theft</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Private_legal_proceeding_against_theft"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</otv:termDefinition>
        <skos:definition xml:lang="en">A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#indictment_for_false_assertion_of_citizenship_en">
        <rdfs:label xml:lang="en">indictment for false assertion of citizenship</rdfs:label>
        <otv:termName>indictment for false assertion of citizenship</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</otv:termDefinition>
        <skos:definition xml:lang="en">A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#impeachment_for_treason_en">
        <rdfs:label xml:lang="en">impeachment for treason</rdfs:label>
        <otv:termName>impeachment for treason</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</otv:termDefinition>
        <skos:definition xml:lang="en">A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
    </otv:Term>

    <otv:Term rdf:about="#indictment_for_illegal_proposals_en">
        <rdfs:label xml:lang="en">indictment for illegal proposals</rdfs:label>
        <otv:termName>indictment for illegal proposals</otv:termName>
        <otv:language>en</otv:language>
        <otv:denotedConcept rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
        <otv:termStatus>preferred</otv:termStatus>
        <otv:partOfSpeech>none</otv:partOfSpeech>
        <otv:gender>none</otv:gender>
        <otv:termDefinition>A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</otv:termDefinition>
        <skos:definition xml:lang="en">A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</skos:definition>
    </otv:Term>

