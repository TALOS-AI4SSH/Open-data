            <ontolex:LexicalConcept rdf:about="#lexical_concept_φόνος ἀκούσιος_δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#φόνος ἀκούσιος_δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for unintentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the 51 Ephetai. If convicted, the defendant receives the non-assessable penalty of exile.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_unintentional_homicide"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἐξούλης δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἐξούλης δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">ἐξούλης δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἐξούλης δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#ἐξούλης δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for physically obstructing someone from their inheritance, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of restoring the property to the heir and paying its value to the state. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_obstructing_an_heir_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ψευδομαρτυριῶν_δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ψευδομαρτυριῶν_δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">ψευδομαρτυριῶν δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ψευδομαρτυριῶν_δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#ψευδομαρτυριῶν_δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for providing false witness testimony, tried before the dikasterion.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_providing_false_witness_testimony_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀστρατείας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀστρατείας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ἀστρατείας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀστρατείας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀστρατείας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for avoiding military service, proceeded over by the Strategoi and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of disenfranchisement.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_avoiding_military_service"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀγών_τιμητός_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀγών_τιμητός_grc">
                <ontolex:writtenRep xml:lang="grc">ἀγών τιμητός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀγών_τιμητός_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀγών_τιμητός_grc"/>
                <skos:definition xml:lang="grc"></skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#αἰκίας δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_αἰκίας δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">αἰκίας δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_αἰκίας δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#αἰκίας δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for starting a physical fight without justification, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_battery_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δοκιμασία_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δοκιμασία_grc">
                <ontolex:writtenRep xml:lang="grc">δοκιμασία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δοκιμασία_grc">
                <ontolex:isEvokedBy rdf:resource="#δοκιμασία_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated before a magistrate's term and proceeded over by the Thesmothetae.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_before_a_magistrate_begins_term_in_office_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀγών_ἀτίμητος_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀγών_ἀτίμητος_grc">
                <ontolex:writtenRep xml:lang="grc">ἀγών ἀτίμητος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀγών_ἀτίμητος_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀγών_ἀτίμητος_grc"/>
                <skos:definition xml:lang="grc"></skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#προβολή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_προβολή_grc">
                <ontolex:writtenRep xml:lang="grc">προβολή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_προβολή_grc">
                <ontolex:isEvokedBy rdf:resource="#προβολή_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated by a vote before the Assembly to condemn the offender with a formal sanction.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceedings_to_present_an_offender_for_formal_sanctions_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#διαδικασία_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_διαδικασία_grc">
                <ontolex:writtenRep xml:lang="grc">διαδικασία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_διαδικασία_grc">
                <ontolex:isEvokedBy rdf:resource="#διαδικασία_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding initiated by competing claims for inheritance with no defendant or prosecutor, proceeded over by the Eponymous Archon and tried by the dikasterion. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the contested sum.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_competing_inheritance_claims_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#παραγραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_παραγραφή_grc">
                <ontolex:writtenRep xml:lang="grc">παραγραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_παραγραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#παραγραφή_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding initiated by submitting a charge in writing to block an illegal prosecution, tried before the dikasterion.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_an_illegal_prosecution_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#εἰσαγγελία_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_εἰσαγγελία_grc">
                <ontolex:writtenRep xml:lang="grc">εἰσαγγελία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_εἰσαγγελία_grc">
                <ontolex:isEvokedBy rdf:resource="#εἰσαγγελία_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding for major offenses against the state. Can be proceeded over by the Assembly or the Council of 500, and can be tried before the Council or the Assembly or the dikasterion. If convicted, defendant receives the non-assesable penalty of death and confiscation. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_against_official_for_offenses_against_the_state"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#παρανόμων γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_παρανόμων γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">παρανόμων γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_παρανόμων γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#παρανόμων γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for proposing or enacting an illegal law, proceeded over by the Assembly and tried by the dikasterion. If convicted, defendant receives the assessable penalty of the annulment of their law and disenfranchisement if convicted three times.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_the_proposal_or_enactment_of_an_illegal_law_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκη_ἀτίμητη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκη_ἀτίμητη_grc">
                <ontolex:writtenRep xml:lang="grc">δίκη ἀτίμητη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκη_ἀτίμητη_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκη_ἀτίμητη_grc"/>
                <skos:definition xml:lang="grc">A legal proceeding with a non-assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_a_fixed_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκη ἐπιτροπῆς_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκη ἐπιτροπῆς_grc">
                <ontolex:writtenRep xml:lang="grc">δίκη ἐπιτροπῆς</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκη ἐπιτροπῆς_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκη ἐπιτροπῆς_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding against guardian witholding property from ward, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_guardian_withholding_property_from_ward_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μοιχείας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μοιχείας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">μοιχείας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μοιχείας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#μοιχείας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for illicit consensual sex with a woman, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_illegal_consensual_sex_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#κλοπῆς δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_κλοπῆς δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">κλοπῆς δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_κλοπῆς δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#κλοπῆς δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for theft of private property, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the assessable penalty of double damages. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_theft"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκαι_δημόσιαι_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκαι_δημόσιαι_grc">
                <ontolex:writtenRep xml:lang="grc">δίκαι δημόσιαι</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκαι_δημόσιαι_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκαι_δημόσιαι_grc"/>
                <skos:definition xml:lang="grc"> A legal proceeding brought forward by any adult male citizen who wishes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#τραύματος ἐκ προνοίας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_τραύματος ἐκ προνοίας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">τραύματος ἐκ προνοίας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_τραύματος ἐκ προνοίας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#τραύματος ἐκ προνοίας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for intentional wounding with a weapon, tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_intentional_wounding_with_a_weapon_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἔνδειξις_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἔνδειξις_grc">
                <ontolex:writtenRep xml:lang="grc">ἔνδειξις</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἔνδειξις_grc">
                <ontolex:isEvokedBy rdf:resource="#ἔνδειξις_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding inititated by denouncing an offender to a magistrate who carries out the arrest, proceeded over by the Eleven, tried in the dikasterion.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ὕβρεως_γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ὕβρεως_γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ὕβρεως γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ὕβρεως_γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ὕβρεως_γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for crimes of hubris, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives an assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_against_crimes_against_humanity_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀσεβείας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀσεβείας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ἀσεβείας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀσεβείας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀσεβείας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for impiety, proceeded over by the Basileus and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death.
</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_impiety_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκη_τιμητή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκη_τιμητή_grc">
                <ontolex:writtenRep xml:lang="grc">δίκη τιμητή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκη_τιμητή_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκη_τιμητή_grc"/>
                <skos:definition xml:lang="grc">A legal proceeding with an assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#σίτου δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_σίτου δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">σίτου δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_σίτου δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#σίτου δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding to claim interest owed on a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_interest_on_dowry_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#φόνος ἑκούσιος_δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_φόνος ἑκούσιος_δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">φόνος ἑκούσιος δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_φόνος ἑκούσιος_δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#φόνος ἑκούσιος_δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for intentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the Council of the Areopagus. If convicted, the defendant receives the non-assessable penalty of death and confiscation.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_intentional_homicide"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἑταιρήσεως γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἑταιρήσεως γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ἑταιρήσεως γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἑταιρήσεως γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἑταιρήσεως γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for exercising citizenship rights having engaged in prostitution, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_prostitution_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#βιαίων δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_βιαίων δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">βιαίων δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_βιαίων δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#βιαίων δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for violent acts such as rape, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_forceful_acts_of_violence"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκη_grc"/>
                <skos:definition xml:lang="grc">A legal proceeding in the classical Athenian court system.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἔνδειξις_τῶν κακούργων_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἔνδειξις_τῶν κακούργων_grc">
                <ontolex:writtenRep xml:lang="grc">ἔνδειξις τῶν κακούργων</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἔνδειξις_τῶν κακούργων_grc">
                <ontolex:isEvokedBy rdf:resource="#ἔνδειξις_τῶν κακούργων_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated by a denouncement before a magistrate for crimes against others. If convicted, defendant is sentenced to the non-assessable penalty of death.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_by_denouncing_an_offender_for_antisocial_behavior_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#βλάβης δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_βλάβης δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">βλάβης δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_βλάβης δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#βλάβης δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for causing financial loss, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the sum in question.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_wrongful_financial_loss"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#κακηγορίας δίκη_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_κακηγορίας δίκη_grc">
                <ontolex:writtenRep xml:lang="grc">κακηγορίας δίκη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_κακηγορίας δίκη_grc">
                <ontolex:isEvokedBy rdf:resource="#κακηγορίας δίκη_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding for illegal defamatory speech, proceeded over by the Forty and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of a fine.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_illegal_defamatory_speech_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#γραφή_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated by submitting a charge in writing, in which the defendant is summoned when the prosecutor issues oral summons at the Assembly. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing___"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#εἰσαγγελία_κάκωσις_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_εἰσαγγελία_κάκωσις_grc">
                <ontolex:writtenRep xml:lang="grc">εἰσαγγελία κάκωσις</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_εἰσαγγελία_κάκωσις_grc">
                <ontolex:isEvokedBy rdf:resource="#εἰσαγγελία_κάκωσις_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding for maltreatment of parents, orphans, and heiresses, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant receives an assesable penalty ranging from a fine to a death sentence. There is no penalty for prosecutors who fail to get one-fifth of the votes.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_for_maltreatment"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#εὔθυναι_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_εὔθυναι_grc">
                <ontolex:writtenRep xml:lang="grc">εὔθυναι</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_εὔθυναι_grc">
                <ontolex:isEvokedBy rdf:resource="#εὔθυναι_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated after a magistrates term for theft of sacred or public property, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of tenfold damages.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_at_the_end_of_the_term_of_a_magistrate_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δωροδοκίας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δωροδοκίας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">δωροδοκίας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δωροδοκίας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#δωροδοκίας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for accepting bribes, proceeded over by the Thesmothetae and tried before the dikasterion. If convicted, defendant receives the assessable penalty of death or a fine ten times the bribe.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_accepting_bribes_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ξενίας γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ξενίας γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ξενίας γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ξενίας γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ξενίας γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for exercising citizenship rights as a noncitizen, proceeded over by the Thesmothetae and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of enslavement.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_citizenship_violations"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀσεβείας_τοῦ_σηκοῦ γραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀσεβείας_τοῦ_σηκοῦ γραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ἀσεβείας τοῦ σηκοῦ γραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀσεβείας_τοῦ_σηκοῦ γραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀσεβείας_τοῦ_σηκοῦ γραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for the destruction of sacred olive trees, proceeded over by the Basileus and tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκη_προικός_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκη_προικός_grc">
                <ontolex:writtenRep xml:lang="grc">δίκη προικός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκη_προικός_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκη_προικός_grc"/>
                <skos:definition xml:lang="grc">A private legal proceeding to claim full amount of a dowry, proceeded over by the Eponymous Archon and tried before the dikasterion. If convicted, defendant recives the assessable pentalty of a fine. If prosecutor fails to get one-fifth of the votes, he faces the penalty of one-sixth of the sum at issue.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_return_of_a_dowry_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀπογραφή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀπογραφή_grc">
                <ontolex:writtenRep xml:lang="grc">ἀπογραφή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀπογραφή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀπογραφή_grc"/>
                <skos:definition xml:lang="grc">A public indictment for withholding property from the state, proceeded over by the Eleven, and tried by the dikasterion. If convicted, the defendant pays an assessable fine and the prosecutor gets one third of the contested property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_debts_to_the_state_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ἀπαγωγή_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ἀπαγωγή_grc">
                <ontolex:writtenRep xml:lang="grc">ἀπαγωγή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ἀπαγωγή_grc">
                <ontolex:isEvokedBy rdf:resource="#ἀπαγωγή_grc"/>
                <skos:definition xml:lang="grc">A public legal proceeding initiated by arresting an offender and bringing them before a magistrate, overseen by the Eleven and tried before the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If prosecutor fails to receive one-fifth of the votes, he faces a one thousand drachma penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_by_an_arrest_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δίκαι_ἴδιαι_grc">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δίκαι_ἴδιαι_grc">
                <ontolex:writtenRep xml:lang="grc">δίκαι ἴδιαι</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δίκαι_ἴδιαι_grc">
                <ontolex:isEvokedBy rdf:resource="#δίκαι_ἴδιαι_grc"/>
                <skos:definition xml:lang="grc">A legal proceeding brought forward by the injured party or a guardian.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding"/>
    </ontolex:LexicalEntry>


