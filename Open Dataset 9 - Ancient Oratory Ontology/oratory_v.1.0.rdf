                <owl:hasValue rdf:resource="#for_illicit_consensual_sex_with_a_woman"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ownDifference"/>
                <owl:hasValue rdf:resource="#assessable_penalty"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
