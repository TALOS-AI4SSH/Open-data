        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_counter-indictment_en">
                <ontolex:isEvokedBy rdf:resource="#counter-indictment_en"/>
                <skos:definition xml:lang="en">A private legal proceeding initiated by submitting a charge in writing to block an illegal prosecution, tried before the dikasterion.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_against_an_illegal_prosecution_"/>
    </ontolex:LexicalEntry>

