        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_assessable_lawsuit_en">
                <ontolex:isEvokedBy rdf:resource="#assessable_lawsuit_en"/>
                <skos:definition xml:lang="en">Lawsuit with assessable penalty.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_proceeding_with_an_assessable_penalty"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#unintentional_homicide_suit_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_unintentional_homicide_suit_en">
                <ontolex:writtenRep xml:lang="en">unintentional homicide suit</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_unintentional_homicide_suit_en">
                <ontolex:isEvokedBy rdf:resource="#unintentional_homicide_suit_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for unintentional homicide, initiated with a proclamation at funeral of victim, proceeded over by the Basileus and tried before the 51 Ephetai. If convicted, the defendant receives the non-assessable penalty of exile.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_unintentional_homicide"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#suit_for_damages_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_suit_for_damages_en">
                <ontolex:writtenRep xml:lang="en">suit for damages</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_suit_for_damages_en">
                <ontolex:isEvokedBy rdf:resource="#suit_for_damages_en"/>
                <skos:definition xml:lang="en">A private legal proceeding for causing financial loss, proceeded over by the Forty and tried by the dikasterion. If convicted, defendant receives the non-assessable penalty of death. If convicted, defendant receives the assessable penalty of a fine. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the sum in question.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_wrongful_financial_loss"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#indictment_for_removal_of_sacred_olive_tree_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_indictment_for_removal_of_sacred_olive_tree_en">
                <ontolex:writtenRep xml:lang="en">indictment for removal of sacred olive tree</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_indictment_for_removal_of_sacred_olive_tree_en">
                <ontolex:isEvokedBy rdf:resource="#indictment_for_removal_of_sacred_olive_tree_en"/>
                <skos:definition xml:lang="en">A public indictment for the destruction of sacred olive trees, proceeded over by the Basileus and tried by the Council of the Areopagus. If convicted, defendant receives the non-assessable penalty of exile and confiscation of property.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Public_legal_proceeding_initiated_in_writing_for_destruction_of_sacred_olive_trees_"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#lawsuit_for_adjudication_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_lawsuit_for_adjudication_en">
                <ontolex:writtenRep xml:lang="en">lawsuit for adjudication</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_lawsuit_for_adjudication_en">
                <ontolex:isEvokedBy rdf:resource="#lawsuit_for_adjudication_en"/>
                <skos:definition xml:lang="en">A private legal proceeding initiated by competing claims for inheritance with no defendant or prosecutor, proceeded over by the Eponymous Archon and tried by the dikasterion. If prosecutor fails to receive one-fifth of the votes, he faces a fine of one-sixth the contested sum.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Private_legal_proceeding_for_competing_inheritance_claims_"/>
    </ontolex:LexicalEntry>

