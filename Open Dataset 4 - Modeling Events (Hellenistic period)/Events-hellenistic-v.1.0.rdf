        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_αυτοκράτορας_el">
                <ontolex:isEvokedBy rdf:resource="#αυτοκράτορας_el"/>
                <skos:definition xml:lang="el">Ιδιότηταρόλος κυβερνήτης μιας αυτοκρατορίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Emperor"/>
