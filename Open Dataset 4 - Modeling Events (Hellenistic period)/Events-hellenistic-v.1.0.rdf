    <owl:NamedIndividual rdf:about="#battle_of_pharsalus">
        <rdfs:label xml:lang="en">battle of pharsalus</rdfs:label>
        <skos:prefLabel xml:lang="en">battle of pharsalus</skos:prefLabel>
        <rdf:type rdf:resource="#Event_military_violent_single_time_single_location"/>
        <skos:note>In the Battle of Pharsalus, on 9 August 48 BCE, the Roman general Julius Caesar defeated the troops of the Roman Senate, commanded by his rival Pompey the Great. Caesar's victory marked the end of the Roman republic, whereas Pompey hid away in Egypt, where he was assasinated (https:www.livius.orgarticlesbattlepharsalus-48-bce, Accessed on 09082024).</skos:note>
        <begin_date_month rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8</begin_date_month>
        <end_date_year rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-48</end_date_year>
        <begin_date_year rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-48</begin_date_year>
        <hasLocation rdf:resource="#thessaly"/>        <hasLocation rdf:resource="#pharsalus"/>        <hasAgent rdf:resource="#pompey"/>        <hasAgent rdf:resource="#gaius_julius_caesar"/>        <hasAgent rdf:resource="#marcus_antonius"/>        <appearesInTheSourceOf rdf:resource="#commentaries_on_the_civil_war"/>        <isRelatedTo rdf:resource="#caesars_civil_war"/>        <foaf:depiction rdf:resource="https://upload.wikimedia.org/wikipedia/commons/a/a9/Battle_of_Pharsalus%2C_48_BC.png"/>
        <foaf:depiction rdf:resource="https://commons.wikimedia.org/wiki/Category:Battle_of_Pharsalus#/media/File:Apollonio_di_Giovanni_-_The_Battle_of_Pharsalus_and_the_Death_of_Pompey_-_1974.394_-_Art_Institute_of_Chicago.jpg"/>
    </owl:NamedIndividual>

