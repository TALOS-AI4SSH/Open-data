        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_violent_single_time_single_location_land"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#political_event_en">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_political_event_en">
                <ontolex:writtenRep xml:lang="en">political event</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_political_event_en">
                <ontolex:isEvokedBy rdf:resource="#political_event_en"/>
                <skos:definition xml:lang="en">Any occurrence or activity related to politics that involves the exercise, expression, or impact of political power, policy, or governance. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#military_event_multi-location_multi-time_en">
        <ontolex:lexicalForm>
