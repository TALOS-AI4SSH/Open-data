            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πάπυρος__el">
                <ontolex:isEvokedBy rdf:resource="#πάπυρος__el"/>
                <skos:definition xml:lang="el">Λέξεις, κείμενο, ή σύμβολα πάνω σε φύλλα του φυτού πάπυρος. Αποτελεί βασική γραπτή ιστορική πηγή.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Papyrus"/>
    </ontolex:LexicalEntry>

