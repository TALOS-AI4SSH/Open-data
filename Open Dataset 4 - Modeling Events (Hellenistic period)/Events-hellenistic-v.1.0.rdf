    <owl:NamedIndividual rdf:about="#battle_of_magnesia">
        <rdfs:label xml:lang="en">battle of magnesia</rdfs:label>
        <skos:prefLabel xml:lang="en">battle of magnesia</skos:prefLabel>
        <rdf:type rdf:resource="#Event_military_violent_single_time_single_location_land"/>
        <skos:note>Antiochus the Great was defeated in the battle of Magnesia near Mt. Sipylus, where he fought against Romans and their allies. He was obliged to pay an indemnity of 15,000 talants over a period of 12 years, surrender his elephants and his fleet, and furnish hostages, including his son Antiochus IV. His kingdom was reduced to Syria, Mesopotamia and eastern Iran (https:www.britannica.combiographyAntiochus-III-the-Great#ref146979, Accesed on 09082024).</skos:note>
        <end_date_year rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-189</end_date_year>
        <begin_date_year rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-189</begin_date_year>
        <hasAgent rdf:resource="#roman_republicempire"/>        <hasAgent rdf:resource="#antiochus_III_the_great"/>        <hasLocation rdf:resource="#thessaly"/>        <hasLocation rdf:resource="#magnesia"/>        <foaf:depiction rdf:resource="https://upload.wikimedia.org/wikipedia/commons/2/2f/Battle_of_Magnesia.jpg"/>
    </owl:NamedIndividual>

