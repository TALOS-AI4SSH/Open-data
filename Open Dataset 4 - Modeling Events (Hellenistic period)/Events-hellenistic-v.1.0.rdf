        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ναυμαχία_el">
                <ontolex:isEvokedBy rdf:resource="#ναυμαχία_el"/>
                <skos:definition xml:lang="el">Ένοπλη σύγκρουση στη θάλασσα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_violent_single_time_single_location_sea"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#άνθρωπος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_άνθρωπος_el">
                <ontolex:writtenRep xml:lang="el">άνθρωπος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_άνθρωπος_el">
                <ontolex:isEvokedBy rdf:resource="#άνθρωπος_el"/>
                <skos:definition xml:lang="el">Ένα πρόσωπο ή μια οντότητα που ενεργεί.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_human_one_person"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ένωση_πόλεων_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ένωση_πόλεων_el">
                <ontolex:writtenRep xml:lang="el">ένωση πόλεων</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ένωση_πόλεων_el">
                <ontolex:isEvokedBy rdf:resource="#ένωση_πόλεων_el"/>
                <skos:definition xml:lang="el">Σύνδεση πόλεων ώστε να αποτελούν ένα ενιαίο πολιτικό σύνολο.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_organised_group_union_made_of_smaller_political_entities_or_states"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ύπατος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ύπατος_el">
                <ontolex:writtenRep xml:lang="el">ύπατος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ύπατος_el">
                <ontolex:isEvokedBy rdf:resource="#ύπατος_el"/>
                <skos:definition xml:lang="el">Ιδιότηταρόλος ενός από τους δύο ετησίως επιλεγμένους στρατηγούς που κυβερνούσαν από κοινού την ρωμαϊκή δημοκρατία.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Consul"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#κείμενο_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_κείμενο_el">
                <ontolex:writtenRep xml:lang="el">κείμενο</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_κείμενο_el">
                <ontolex:isEvokedBy rdf:resource="#κείμενο_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολολογίας το κείμενο είναι η γραπτή πηγή που χρησιμοποιείται για τη μελέτη των ιστορικών γεγονότων.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Text"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#άνομο_θρησκευτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_άνομο_θρησκευτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">άνομο θρησκευτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_άνομο_θρησκευτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#άνομο_θρησκευτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Θρησκευτικό γεγονός άνομο.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_religious_unlawful"/>
    </ontolex:LexicalEntry>


