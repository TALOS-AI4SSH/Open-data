            <ontolex:Form rdf:about="#form_ανθρώπινος_παράγοντας_el">
                <ontolex:writtenRep xml:lang="el">ανθρώπινος παράγοντας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ανθρώπινος_παράγοντας_el">
                <ontolex:isEvokedBy rdf:resource="#ανθρώπινος_παράγοντας_el"/>
                <skos:definition xml:lang="el">Ανθρώπινη ενέργεια που επηρεάζει τα γεγονότα. Αντιδιαστέλλεται προς τον φυσικό παράγοντα. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_human"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#εκστρατεία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_εκστρατεία_el">
                <ontolex:writtenRep xml:lang="el">εκστρατεία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_εκστρατεία_el">
                <ontolex:isEvokedBy rdf:resource="#εκστρατεία_el"/>
                <skos:definition xml:lang="el">Σειρά πολεμικών επιχειρήσεων με σκοπό την εκπλήρωση συγκεκριμένου στόχου. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα }.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Series_of_military_operations"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#νομική_καταστολή_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_νομική_καταστολή_el">
                <ontolex:writtenRep xml:lang="el">νομική καταστολή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_νομική_καταστολή_el">
                <ontolex:isEvokedBy rdf:resource="#νομική_καταστολή_el"/>
                <skos:definition xml:lang="el">Xρήση νόμων και νομικών μηχανισμών από τις αρχές για την καταστολή της διαφωνίας, τον περιορισμό των ελευθεριών ή τον έλεγχο ορισμένων ομάδων ή δραστηριοτήτων.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Legal_repression"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πνευματική_λειτουργία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πνευματική_λειτουργία_el">
                <ontolex:writtenRep xml:lang="el">πνευματική λειτουργία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πνευματική_λειτουργία_el">
                <ontolex:isEvokedBy rdf:resource="#πνευματική_λειτουργία_el"/>
                <skos:definition xml:lang="el">Ρόλος, ιδιότητα, θέση που αφορά την πνευματική ζωή της κοινωνίας.
</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Function_intellectual"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#θρησκευτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_θρησκευτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">θρησκευτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_θρησκευτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#θρησκευτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Εκδήλωση ή τελετή που έχει ιδιαίτερη σημασία για μια θρησκεία. Αυτά τα γεγονότα μπορεί να περιλαμβάνουν γιορτές, τελετές λατρείας, μυστήρια.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_religious"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δούλος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δούλος_el">
                <ontolex:writtenRep xml:lang="el">δούλος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δούλος_el">
                <ontolex:isEvokedBy rdf:resource="#δούλος_el"/>
                <skos:definition xml:lang="el">Άνθρωπος αναγκασμένος να λογοδοτεί και να υπακούει έναν άλλον άνθρωπο, του οποίου θεωρείται ιδιοκτησία.
</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Slave"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ενδοχώρα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ενδοχώρα_el">
                <ontolex:writtenRep xml:lang="el">ενδοχώρα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ενδοχώρα_el">
                <ontolex:isEvokedBy rdf:resource="#ενδοχώρα_el"/>
                <skos:definition xml:lang="el">Χερσαία τοποθεσία που δεν βρέχεται από θάλασσα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Inland_Location"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μυθολογικός_παράγοντας_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μυθολογικός_παράγοντας_el">
                <ontolex:writtenRep xml:lang="el">μυθολογικός παράγοντας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μυθολογικός_παράγοντας_el">
                <ontolex:isEvokedBy rdf:resource="#μυθολογικός_παράγοντας_el"/>
                <skos:definition xml:lang="el">Στοιχείο της φύσης που επηρεάζει τα γεγονότα και εμπεριέχει μύθους.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Mythological_Agent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#γεγονός_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, εξετάζονται ιστορικά γεγονότα και ο όρος 'γεγονός' δηλώνει το ιστορικό γεγονός.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#υποχώρηση_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_υποχώρηση_el">
                <ontolex:writtenRep xml:lang="el">υποχώρηση</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_υποχώρηση_el">
                <ontolex:isEvokedBy rdf:resource="#υποχώρηση_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας κατηγοριοποιείται ως μη βίαιο στρατιωτικό γεγονός που σημαίνει το τέλος στρατιωτικής δραστηριότητας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Withdrawal"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#τοποθεσία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_τοποθεσία_el">
                <ontolex:writtenRep xml:lang="el">τοποθεσία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_τοποθεσία_el">
                <ontolex:isEvokedBy rdf:resource="#τοποθεσία_el"/>
                <skos:definition xml:lang="el">Θέση όπου βρίσκεται ένας ορισμένος τόπος, άνθρωποι, κατασκευές, αντικείμενα του φυσικού ή του ανθρωπογενούς περιβάλλοντος.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Location"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτική_ομάδα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτική_ομάδα_el">
                <ontolex:writtenRep xml:lang="el">πολιτική ομάδα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτική_ομάδα_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτική_ομάδα_el"/>
                <skos:definition xml:lang="el">Oργανωμένη ομάδα ατόμων που μοιράζονται κοινούς πολιτικούς στόχους ή ιδεολογίες και συνεργάζονται για να επηρεάσουν τη δημόσια πολιτική ή να αποκτήσουν πολιτική εξουσία.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_organised_group_of_people_with_the_same_ideology_who_want_to_exercise_political_power"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#νησί_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_νησί_el">
                <ontolex:writtenRep xml:lang="el">νησί</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_νησί_el">
                <ontolex:isEvokedBy rdf:resource="#νησί_el"/>
                <skos:definition xml:lang="el">Χερσαία τοποθεσία που περιβρέχεται από υγρό στοιχείο (θάλασσα, λίμνη, ποταμό).</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Island"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ιδιότηταρόλος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ιδιότηταρόλος_el">
                <ontolex:writtenRep xml:lang="el">ιδιότηταρόλος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ιδιότηταρόλος_el">
                <ontolex:isEvokedBy rdf:resource="#ιδιότηταρόλος_el"/>
                <skos:definition xml:lang="el">Λειτουργία ή καθήκοντα που αναλαμβάνει ένα άτομο μέσα σε μια πολιτική, στρατιωτική, κοινωνική ή επαγγελματική δομή.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Role"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#λειτουργία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_λειτουργία_el">
                <ontolex:writtenRep xml:lang="el">λειτουργία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_λειτουργία_el">
                <ontolex:isEvokedBy rdf:resource="#λειτουργία_el"/>
                <skos:definition xml:lang="el">Τα συγκεκριμένα καθήκοντα, καθήκοντα ή δραστηριότητες που αναμένεται να εκτελέσει ή να εκτελέσει ένα άτομο, αντικείμενο ή σύστημα. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Function"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μάχη_ξηράς_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μάχη_ξηράς_el">
                <ontolex:writtenRep xml:lang="el">μάχη ξηράς</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μάχη_ξηράς_el">
                <ontolex:isEvokedBy rdf:resource="#μάχη_ξηράς_el"/>
                <skos:definition xml:lang="el">Στρατιωτική σύγκρουση που λαμβάνει χώρα στην ξηρά.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_violent_single_time_single_location_land"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μη_βίαιο_στρατιωτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μη_βίαιο_στρατιωτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">μη βίαιο στρατιωτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μη_βίαιο_στρατιωτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#μη_βίαιο_στρατιωτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Συμβάν που αφορά στρατιωτικές δυνάμεις και δεν εμπεριέχει τη χρήση βίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_non-violent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#νόμιμο_πολτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_νόμιμο_πολτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">νόμιμο πολτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_νόμιμο_πολτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#νόμιμο_πολτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας εκφράζει την έννοια  {πολιτικό γεγονός, νόμιμο}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political_lawful"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτική_λειτουργία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτική_λειτουργία_el">
                <ontolex:writtenRep xml:lang="el">πολιτική λειτουργία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτική_λειτουργία_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτική_λειτουργία_el"/>
                <skos:definition xml:lang="el">Ρόλος, ιδιότητα, θέση που αφορά την πολιτική ζωή της κοινωνίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Function_political"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτικός__el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτικός__el">
                <ontolex:writtenRep xml:lang="el">πολιτικός </ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτικός__el">
                <ontolex:isEvokedBy rdf:resource="#πολιτικός__el"/>
                <skos:definition xml:lang="el">Άνθρωπος που δραστηριοποιείται στον τομέα της πολιτικής, είτε μέσω συμμετοχής στη διακυβέρνηση, είτε μέσω της ενεργού συμμετοχής του σε ένα πολιτικό κόμμα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Politician"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#εκλογή_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_εκλογή_el">
                <ontolex:writtenRep xml:lang="el">εκλογή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_εκλογή_el">
                <ontolex:isEvokedBy rdf:resource="#εκλογή_el"/>
                <skos:definition xml:lang="el">Ανάδειξη σε ένα αξίωμα μέσω ψηφοφορίας. Στο πλαίσιο της παρούσας οντοορολογίας κατατάσσεται στην κατηγορία {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Election"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#κυβερνήτης_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_κυβερνήτης_el">
                <ontolex:writtenRep xml:lang="el">κυβερνήτης</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_κυβερνήτης_el">
                <ontolex:isEvokedBy rdf:resource="#κυβερνήτης_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας είναι η Ιδιότηταρόλος του ηγέτη ή διοικητή συγκεκριμένης περιοχής.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Governor"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#θαλάσσια_τοποθεσία_el">
