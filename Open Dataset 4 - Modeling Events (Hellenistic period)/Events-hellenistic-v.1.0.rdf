            <ontolex:Form rdf:about="#form_μεταβίβαση_εξουσίας_el">
                <ontolex:writtenRep xml:lang="el">μεταβίβαση εξουσίας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μεταβίβαση_εξουσίας_el">
                <ontolex:isEvokedBy rdf:resource="#μεταβίβαση_εξουσίας_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, η έννοια που εκφράζει ο όρος 'μεταβίβαση εξουσίας' κατηγοροποιείται ως {πολιτικό γεγονός, νόμιμο, βίαιο}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political_lawful_violent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ανακωχή_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ανακωχή_el">
                <ontolex:writtenRep xml:lang="el">ανακωχή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ανακωχή_el">
                <ontolex:isEvokedBy rdf:resource="#ανακωχή_el"/>
                <skos:definition xml:lang="el">Συμφωνία μεταξύ αντίθετων πλευρών σε ένα πόλεμο για να σταματήσουν οι μάχες για συγκεκριμένο χρονικό διάστημα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Armistice"/>
    </ontolex:LexicalEntry>

