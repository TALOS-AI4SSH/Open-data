	<!--  SKOS Concept Scheme -->

    <skos:ConceptScheme rdf:about="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0">
        <dc:title>EventOntoHellenistic</dc:title>
        <dc:description>This is version 1.0 of an ontoterminology about events taking place in the Hellenistic World. The Hellenistic times extend from the death of Alexander the Great (323 BC) until the Naval Battle of Actium (31 BC). It is a period that concludes the Wars of the Successors of Alexander to the creation of the Hellenistic Kingdoms and Dynasties and the extension of power of the Romans in the Mediterranean. The ontology aims to include the most important agents-persons of the period in relation with the events that formed it. Another significant purpose of the data set is to connect the people and the events with their primary sources and the writers that have chronicled them.
The ontoterminology was created by Tonia Lourentzaki (Department of History and Archaeology, University of Crete) under the supervision of Dr. Maria Papadopoulou (Department of Philology, University of Crete) and Professor Christophe Roche (TALOS ERA Professor, University of Crete).

We gratefully acknowledge the generous funding of the European Commission in the context of the TALOS AI for SSH project (Grant agreement ID: 101087269).
</dc:description>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-4-25</dc:issued>
        <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-8-25</dc:modified>
        <dc:creator>Antonia Lourentzaki</dc:creator>
        <dc:publisher>University of Crete, Gallos, Rethymno</dc:publisher>
    </skos:ConceptScheme>

	<!--  SKOS Concepts -->

    <skos:Concept rdf:about="#Truce">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">truce</rdfs:label>
        <skos:prefLabel xml:lang="en">truce</skos:prefLabel>
        <skos:definition xml:lang="en">A cease-fire, an agreement between opposite sides in a war to stop fighting for a certain period of time.</skos:definition>
        <rdfs:label xml:lang="el">εκεχειρία</rdfs:label>
        <skos:prefLabel xml:lang="el">εκεχειρία</skos:prefLabel>
        <skos:definition xml:lang="el">Συμφωνία μεταξύ αντίθετων πλευρών σε ένα πόλεμο για να σταματήσουν οι μάχες για συγκεκριμένο χρονικό διάστημα. Στο πλαίσιο της παρούσας οντοορολογίας κατατάσσεται στην κατηγορία {μη βίαιο στρατιωτικό γεγονός}.</skos:definition>
        <skos:broader rdf:resource="#Event_military_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military event</rdfs:label>
        <skos:prefLabel xml:lang="en">military event</skos:prefLabel>
        <skos:definition xml:lang="en">Any activity involving armed forces, typically related to warfare, defense, or strategic operations.</skos:definition>
        <rdfs:label xml:lang="el">στρατιωτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">στρατιωτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Συμβάν που περιλαμβάνει τις ένοπλες δυνάμεις και συνήθως συνδέεται με πολεμικές επιχειρήσεις, συγκρούσεις ή στρατιωτικές ασκήσεις. Αυτά τα γεγονότα μπορεί να ποικίλουν σε κλίμακα και σημασία, από μικρές αψιμαχίες μέχρι μεγάλες μάχες, πολέμους ή στρατιωτικές επιχειρήσεις.</skos:definition>
        <skos:broader rdf:resource="#Event"/>
        <skos:narrower rdf:resource="#Event_military_non-violent"/>
        <skos:narrower rdf:resource="#Event_military_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Function">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">function</rdfs:label>
        <skos:prefLabel xml:lang="en">function</skos:prefLabel>
        <skos:definition xml:lang="en">The specific tasks, duties, or activities that a person, object, or system is expected to perform or carry out. </skos:definition>
        <rdfs:label xml:lang="el">λειτουργία</rdfs:label>
        <skos:prefLabel xml:lang="el">λειτουργία</skos:prefLabel>
        <skos:definition xml:lang="el">Τα συγκεκριμένα καθήκοντα, καθήκοντα ή δραστηριότητες που αναμένεται να εκτελέσει ή να εκτελέσει ένα άτομο, αντικείμενο ή σύστημα. </skos:definition>
        <skos:narrower rdf:resource="#Function_intellectual"/>
        <skos:narrower rdf:resource="#Function_military"/>
        <skos:narrower rdf:resource="#Function_political"/>
        <skos:narrower rdf:resource="#Function_religious"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Function_military">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military function</rdfs:label>
        <skos:prefLabel xml:lang="en">military function</skos:prefLabel>
        <skos:definition xml:lang="en">Roles, responsibilities, and activities performed by a person or a group belonging to the armed forces,</skos:definition>
        <rdfs:label xml:lang="el">στρατιωτική λειτουργία</rdfs:label>
        <skos:prefLabel xml:lang="el">στρατιωτική λειτουργία</skos:prefLabel>
        <skos:definition xml:lang="el">Στρατιωτικό αξίωμα.</skos:definition>
        <skos:broader rdf:resource="#Function"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Demonstration">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">demonstration</rdfs:label>
        <skos:prefLabel xml:lang="en">demonstration</skos:prefLabel>
        <skos:definition xml:lang="en">A public display of goup opinion or protest expressing views on a political or social issue.</skos:definition>
        <rdfs:label xml:lang="el">διαδήλωση</rdfs:label>
        <skos:prefLabel xml:lang="el">διαδήλωση</skos:prefLabel>
        <skos:definition xml:lang="el">Δημόσια συγκέντρωση ή διαμαρτυρία σχετικά με ένα πολιτικό ή κοινωνικό θέμα. Στο πλαίσιο της παρούσας οντοορολογίας κατατάσσεται στην κατηγορία {πολιτικό γεγονός, άνομο, 'βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_religious_unlawful">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">religious event unlawful</rdfs:label>
        <skos:prefLabel xml:lang="en">religious event unlawful</skos:prefLabel>
        <skos:definition xml:lang="en">An unlawful religious event refers to a gathering, ceremony, or observance that is conducted in violation of legal regulations or prohibitions.</skos:definition>
        <rdfs:label xml:lang="el">άνομο θρησκευτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">άνομο θρησκευτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Θρησκευτικό γεγονός άνομο.</skos:definition>
        <skos:broader rdf:resource="#Event_religious"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Papyrus">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">papyrus</rdfs:label>
        <skos:prefLabel xml:lang="en">papyrus</skos:prefLabel>
        <skos:definition xml:lang="en">A type of material that was used in ancient times as a writing surface, similar to paper. </skos:definition>
        <rdfs:label xml:lang="el">πάπυρος </rdfs:label>
        <skos:prefLabel xml:lang="el">πάπυρος </skos:prefLabel>
        <skos:definition xml:lang="el">Λέξεις, κείμενο, ή σύμβολα πάνω σε φύλλα του φυτού πάπυρος. Αποτελεί βασική γραπτή ιστορική πηγή.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_intellectual">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">intellectual event</rdfs:label>
        <skos:prefLabel xml:lang="en">intellectual event</skos:prefLabel>
        <skos:definition xml:lang="en">An occurrence that influences, shapes, or transforms the way individuals or collective entities think, learn, reason, or understand the world.</skos:definition>
        <rdfs:label xml:lang="el">πνευματικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">πνευματικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Mια συγκέντρωση, τελετή ή εμπειρία που έχει βαθιά πνευματική σημασία για τους συμμετέχοντες.</skos:definition>
        <skos:broader rdf:resource="#Event"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Author">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <skos:prefLabel xml:lang="en">author</skos:prefLabel>
        <skos:definition xml:lang="en">Someone who writes books and conveys ideas, images and information through the written word.</skos:definition>
        <rdfs:label xml:lang="el">συγγραφέας</rdfs:label>
        <skos:prefLabel xml:lang="el">συγγραφέας</skos:prefLabel>
        <skos:definition xml:lang="el">Δημιουργός γραπτού λόγου.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
        <skos:narrower rdf:resource="#Philosopher"/>
        <skos:narrower rdf:resource="#Orator"/>
        <skos:narrower rdf:resource="#Historian"/>
        <skos:narrower rdf:resource="#Historiographer"/>
        <skos:narrower rdf:resource="#Geographer"/>
        <skos:narrower rdf:resource="#Biographer"/>
        <skos:narrower rdf:resource="#Politician"/>
        <skos:related rdf:resource="#Text"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Politician">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">politician</rdfs:label>
        <skos:prefLabel xml:lang="en">politician</skos:prefLabel>
        <skos:definition xml:lang="en">Someone who is actively involved in the governance of a country, state, or community, </skos:definition>
        <rdfs:label xml:lang="el">πολιτικός </rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτικός </skos:prefLabel>
        <skos:definition xml:lang="el">Άνθρωπος που δραστηριοποιείται στον τομέα της πολιτικής, είτε μέσω συμμετοχής στη διακυβέρνηση, είτε μέσω της ενεργού συμμετοχής του σε ένα πολιτικό κόμμα.</skos:definition>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Location_land">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">land</rdfs:label>
        <skos:prefLabel xml:lang="en">land</skos:prefLabel>
        <skos:definition xml:lang="en">The solid surface of the Earth, including all the natural features and resources that exist upon it. It encompasses various types of terrain, ecosystems, and geological formations.</skos:definition>
        <rdfs:label xml:lang="el">χερσαία τοποθεσία</rdfs:label>
        <skos:prefLabel xml:lang="el">χερσαία τοποθεσία</skos:prefLabel>
        <skos:definition xml:lang="el">Τοποθεσία που βρίσκεται στην ξηρά.</skos:definition>
        <skos:broader rdf:resource="#Location"/>
        <skos:narrower rdf:resource="#City"/>
        <skos:narrower rdf:resource="#Inland_Location"/>
        <skos:narrower rdf:resource="#Island"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_lawful_violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">ascesion of power</rdfs:label>
        <skos:prefLabel xml:lang="en">ascesion of power</skos:prefLabel>
        <skos:definition xml:lang="en">The process by which an individual or group rises to a position of authority, influence, or control, typically within a political, social, or organizational context.</skos:definition>
        <rdfs:label xml:lang="el">μεταβίβαση εξουσίας</rdfs:label>
        <skos:prefLabel xml:lang="el">μεταβίβαση εξουσίας</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, η έννοια που εκφράζει ο όρος 'μεταβίβαση εξουσίας' κατηγοροποιείται ως {πολιτικό γεγονός, νόμιμο, βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful"/>
        <skos:narrower rdf:resource="#Expulsion"/>
        <skos:narrower rdf:resource="#Legal_repression"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Role">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:prefLabel xml:lang="en">role</skos:prefLabel>
        <skos:definition xml:lang="en">A set of behaviors, duties, and expectations associated with a particular position or function in society, an organization, or a specific context.</skos:definition>
        <rdfs:label xml:lang="el">ιδιότηταρόλος</rdfs:label>
        <skos:prefLabel xml:lang="el">ιδιότηταρόλος</skos:prefLabel>
        <skos:definition xml:lang="el">Λειτουργία ή καθήκοντα που αναλαμβάνει ένα άτομο μέσα σε μια πολιτική, στρατιωτική, κοινωνική ή επαγγελματική δομή.</skos:definition>
        <skos:narrower rdf:resource="#General"/>
        <skos:narrower rdf:resource="#Satrap"/>
        <skos:narrower rdf:resource="#King-Queen"/>
        <skos:narrower rdf:resource="#Slave"/>
        <skos:narrower rdf:resource="#Pharaoh"/>
        <skos:narrower rdf:resource="#Prince-Princess"/>
        <skos:narrower rdf:resource="#Priest"/>
        <skos:narrower rdf:resource="#Governor"/>
        <skos:narrower rdf:resource="#Tyrant"/>
        <skos:narrower rdf:resource="#Consul"/>
        <skos:narrower rdf:resource="#Emperor"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent_single_time_single_location_sea">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">naval battle</rdfs:label>
        <skos:prefLabel xml:lang="en">naval battle</skos:prefLabel>
        <skos:definition xml:lang="en">Battle taking place at sea.</skos:definition>
        <rdfs:label xml:lang="el">ναυμαχία</rdfs:label>
        <skos:prefLabel xml:lang="el">ναυμαχία</skos:prefLabel>
        <skos:definition xml:lang="el">Ένοπλη σύγκρουση στη θάλασσα.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent_single_time_single_location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_lawful_non-violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political event lawful non-violent</rdfs:label>
        <skos:prefLabel xml:lang="en">political event lawful non-violent</skos:prefLabel>
        <skos:definition xml:lang="en">A political activity or occurrence that is conducted in compliance with legal regulations and without the use of violence. </skos:definition>
        <rdfs:label xml:lang="el">πολιτικό γεγονός νόμιμο μη βίαιο</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτικό γεγονός νόμιμο μη βίαιο</skos:prefLabel>
        <skos:definition xml:lang="el">Πολιτικό γεγονός που δεν συμμορφώνεται με τους ισχύοντεις νόμους και δεν περιλαμβάνει τη χρήση βίας.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful"/>
        <skos:narrower rdf:resource="#Assembly_vote"/>
        <skos:narrower rdf:resource="#Election"/>
        <skos:narrower rdf:resource="#Reform"/>
        <skos:narrower rdf:resource="#Trial"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Monument">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">monument</rdfs:label>
        <skos:prefLabel xml:lang="en">monument</skos:prefLabel>
        <skos:definition xml:lang="en">A structure or statue created to commemorate a person, event, or significant historical moment.</skos:definition>
        <rdfs:label xml:lang="el">μνημείο </rdfs:label>
        <skos:prefLabel xml:lang="el">μνημείο </skos:prefLabel>
        <skos:definition xml:lang="el">Κατασκευή στην μνήμη ενός γεγονότος ή προσώπου. Αποτελεί ιστορική πηγή.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_unlawful">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political unlawful event</rdfs:label>
        <skos:prefLabel xml:lang="en">political unlawful event</skos:prefLabel>
        <skos:definition xml:lang="en">A political activity or occurrence that is not permitted by law.</skos:definition>
        <rdfs:label xml:lang="el">άνομο πολιτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">άνομο πολιτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Πολιτικό γεγονός άνομο.</skos:definition>
        <skos:broader rdf:resource="#Event_political"/>
        <skos:narrower rdf:resource="#Event_political_unlawful_violent"/>
        <skos:narrower rdf:resource="#Event_political_unlawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Inscription">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">inscription</rdfs:label>
        <skos:prefLabel xml:lang="en">inscription</skos:prefLabel>
        <skos:definition xml:lang="en">A form of writing that is engraved, etched or otherwise permanently marked on a durable surface such as stone, metal, wood or clay. Inscriptions are often created to memorialize, document or transmit information in a enduring way. </skos:definition>
        <rdfs:label xml:lang="el">επιγραφή</rdfs:label>
        <skos:prefLabel xml:lang="el">επιγραφή</skos:prefLabel>
        <skos:definition xml:lang="el">Κείμενο ή σύμβολο χαραγμένο σε σκληρή επιφάνεια, όπως πέτρα, μέταλλο ή ξύλο, που συνήθως αποτυπώνει ένα μήνυμα, ένα όνομα ή μια σημαντική πληροφορία. </skos:definition>
        <skos:broader rdf:resource="#Source"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Natural_Agent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">natural agent </rdfs:label>
        <skos:prefLabel xml:lang="en">natural agent </skos:prefLabel>
        <skos:definition xml:lang="en">Entity or force in the natural world that causes change or has an effect on the environment or other living organisms. </skos:definition>
        <rdfs:label xml:lang="el">φυσικός παράγοντας</rdfs:label>
        <skos:prefLabel xml:lang="el">φυσικός παράγοντας</skos:prefLabel>
        <skos:definition xml:lang="el">Στοιχείο της φύσης που επηρεάζει τα γεγονότα. Αντιδιαστέλλεται προς τον ανθρώπινο παράγοντα. </skos:definition>
        <skos:broader rdf:resource="#Agent_non_human"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Secondary_">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">secondary source</rdfs:label>
        <skos:prefLabel xml:lang="en">secondary source</skos:prefLabel>
        <skos:definition xml:lang="en">A written work that analyzes, interprets, or comments on primary sources or historical events.</skos:definition>
        <rdfs:label xml:lang="el">δευτερογενής πηγή</rdfs:label>
        <skos:prefLabel xml:lang="el">δευτερογενής πηγή</skos:prefLabel>
        <skos:definition xml:lang="el">Κείμενο δίνει πληροφορίες για πρωτογενή πηγή.</skos:definition>
        <skos:broader rdf:resource="#Text"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_unlawful_violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political event unlawful violent</rdfs:label>
        <skos:prefLabel xml:lang="en">political event unlawful violent</skos:prefLabel>
        <skos:definition xml:lang="en">A political activity or occurrence that is not permitted by law and is conducted without the use of violence.</skos:definition>
        <rdfs:label xml:lang="el">πολιτικό γεγονός άνομο βίαιο</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτικό γεγονός άνομο βίαιο</skos:prefLabel>
        <skos:definition xml:lang="el">Πολιτικό γεγονός που χαρακτηρίζεται από τον παράνομο χαρακτήρα του και τη χρήση βίας. </skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful"/>
        <skos:narrower rdf:resource="#Assasination"/>
        <skos:narrower rdf:resource="#Coup"/>
        <skos:narrower rdf:resource="#Demonstration"/>
        <skos:narrower rdf:resource="#Revolt"/>
        <skos:narrower rdf:resource="#Sedition"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Greek_Historian">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">greek historian</rdfs:label>
        <skos:prefLabel xml:lang="en">greek historian</skos:prefLabel>
        <skos:definition xml:lang="en">A historian who studies, analyzes, and interprets the history of ancient Greece, its people, culture, political systems, and events.</skos:definition>
        <rdfs:label xml:lang="el">έλληνας ιστορικός</rdfs:label>
        <skos:prefLabel xml:lang="el">έλληνας ιστορικός</skos:prefLabel>
        <skos:definition xml:lang="el">Ιστορικός ελληνικής καταγωγής.</skos:definition>
        <skos:broader rdf:resource="#Historian"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_religious">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">religious event</rdfs:label>
        <skos:prefLabel xml:lang="en">religious event</skos:prefLabel>
        <skos:definition xml:lang="en">A gathering, ceremony, or observance that holds spiritual significance for a particular religious community.</skos:definition>
        <rdfs:label xml:lang="el">θρησκευτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">θρησκευτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Εκδήλωση ή τελετή που έχει ιδιαίτερη σημασία για μια θρησκεία. Αυτά τα γεγονότα μπορεί να περιλαμβάνουν γιορτές, τελετές λατρείας, μυστήρια.</skos:definition>
        <skos:broader rdf:resource="#Event"/>
        <skos:narrower rdf:resource="#Event_religious_lawful"/>
        <skos:narrower rdf:resource="#Event_religious_unlawful"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">violent event</rdfs:label>
        <skos:prefLabel xml:lang="en">violent event</skos:prefLabel>
        <skos:definition xml:lang="en">An event characterized by violence can take many forms, depending on the context, e.g. military (battle, skirmish, insurgency), criminal (assault, murder), social (civil unrest, lynching), domestic, interpersonal, political (revolution).</skos:definition>
        <rdfs:label xml:lang="el">βίαιο γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">βίαιο γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Γεγονός βίαιο.</skos:definition>
        <skos:broader rdf:resource="#Event"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Armistice">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">armistice</rdfs:label>
        <skos:prefLabel xml:lang="en">armistice</skos:prefLabel>
        <skos:definition xml:lang="en">Military event non-violent, an agreement between opposite sides in a war to stop fighting for a certain period of time.</skos:definition>
        <rdfs:label xml:lang="el">ανακωχή</rdfs:label>
        <skos:prefLabel xml:lang="el">ανακωχή</skos:prefLabel>
        <skos:definition xml:lang="el">Συμφωνία μεταξύ αντίθετων πλευρών σε ένα πόλεμο για να σταματήσουν οι μάχες για συγκεκριμένο χρονικό διάστημα.</skos:definition>
        <skos:broader rdf:resource="#Event_military_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Source">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">source</rdfs:label>
        <skos:prefLabel xml:lang="en">source</skos:prefLabel>
        <skos:definition xml:lang="en">Any material or information that provides evidence or insights about past events, people, cultures, or societies. Sources are crucial for understanding and interpreting the past. </skos:definition>
        <rdfs:label xml:lang="el">πηγή</rdfs:label>
        <skos:prefLabel xml:lang="el">πηγή</skos:prefLabel>
        <skos:definition xml:lang="el">Κείμενο ή αντικείμενο από όπου αντλούνται άμεσα πληροφορίες, στοιχεία κτλ. για τους σκοπούς της Ιστορίας.</skos:definition>
        <skos:narrower rdf:resource="#Author"/>
        <skos:narrower rdf:resource="#Papyrus"/>
        <skos:narrower rdf:resource="#Coin"/>
        <skos:narrower rdf:resource="#Text"/>
        <skos:narrower rdf:resource="#Artifact"/>
        <skos:narrower rdf:resource="#Monument"/>
        <skos:narrower rdf:resource="#Inscription"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_human">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">human agent</rdfs:label>
        <skos:prefLabel xml:lang="en">human agent</skos:prefLabel>
        <skos:definition xml:lang="en">An individual who acts on behalf of themselves or others, making decisions, performing actions, or negotiating within a specific context or environment.</skos:definition>
        <rdfs:label xml:lang="el">ανθρώπινος παράγοντας</rdfs:label>
        <skos:prefLabel xml:lang="el">ανθρώπινος παράγοντας</skos:prefLabel>
        <skos:definition xml:lang="el">Ανθρώπινη ενέργεια που επηρεάζει τα γεγονότα. Αντιδιαστέλλεται προς τον φυσικό παράγοντα. </skos:definition>
        <skos:broader rdf:resource="#Agent"/>
        <skos:narrower rdf:resource="#Agent_human_more_than_one_person"/>
        <skos:narrower rdf:resource="#Agent_human_one_person"/>
        <skos:narrower rdf:resource="#Agent_human_non-organised_group"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military event violent</rdfs:label>
        <skos:prefLabel xml:lang="en">military event violent</skos:prefLabel>
        <skos:definition xml:lang="en">An occurrence or activity involving armed forces that results in the use of force, combat, and typically, casualties.</skos:definition>
        <rdfs:label xml:lang="el">βίαιο στρατιωτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">βίαιο στρατιωτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Στρατιωτικό γεγονός βίαιο.</skos:definition>
        <skos:broader rdf:resource="#Event_military"/>
        <skos:narrower rdf:resource="#Event_military_violent_multi-location_multi-time"/>
        <skos:narrower rdf:resource="#Event_military_violent_single_time"/>
        <skos:narrower rdf:resource="#Event_military_multi-time_single_location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Armed_conflict">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">war</rdfs:label>
        <skos:prefLabel xml:lang="en">war</skos:prefLabel>
        <skos:definition xml:lang="en">Military event multi-location multi-time a state of armed conflict between different nations or states or different groups within a country or state.</skos:definition>
        <rdfs:label xml:lang="el">πόλεμος</rdfs:label>
        <skos:prefLabel xml:lang="el">πόλεμος</skos:prefLabel>
        <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα κατάσταση ένοπλης διαμάχης μεταξύ διαφορετικών εθνών ή πόλεων ή μεταξύ διαφορετικών ομάδων σε μια πόλη ή χώρα.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent_multi-location_multi-time"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Inland_Location">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">inland </rdfs:label>
        <skos:prefLabel xml:lang="en">inland </skos:prefLabel>
        <skos:definition xml:lang="en">The interior part of a country, continent, or region, located away from the coast or border. </skos:definition>
        <rdfs:label xml:lang="el">ενδοχώρα</rdfs:label>
        <skos:prefLabel xml:lang="el">ενδοχώρα</skos:prefLabel>
        <skos:definition xml:lang="el">Χερσαία τοποθεσία που δεν βρέχεται από θάλασσα.</skos:definition>
        <skos:broader rdf:resource="#Location_land"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Location">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">location</rdfs:label>
        <skos:prefLabel xml:lang="en">location</skos:prefLabel>
        <skos:definition xml:lang="en">A specific place or position on the Earth's surface, defined by its geographical coordinates, address, or other identifying characteristics.</skos:definition>
        <rdfs:label xml:lang="el">τοποθεσία</rdfs:label>
        <skos:prefLabel xml:lang="el">τοποθεσία</skos:prefLabel>
        <skos:definition xml:lang="el">Θέση όπου βρίσκεται ένας ορισμένος τόπος, άνθρωποι, κατασκευές, αντικείμενα του φυσικού ή του ανθρωπογενούς περιβάλλοντος.</skos:definition>
        <skos:narrower rdf:resource="#Location_land"/>
        <skos:narrower rdf:resource="#Location_sea"/>
        <skos:related rdf:resource="#Event"/>
        <skos:related rdf:resource="#Location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Text">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">text</rdfs:label>
        <skos:prefLabel xml:lang="en">text</skos:prefLabel>
        <skos:definition xml:lang="en">A piece of written material, typically consisting of words, sentences, and paragraphs, that conveys information, ideas, or stories.</skos:definition>
        <rdfs:label xml:lang="el">κείμενο</rdfs:label>
        <skos:prefLabel xml:lang="el">κείμενο</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολολογίας το κείμενο είναι η γραπτή πηγή που χρησιμοποιείται για τη μελέτη των ιστορικών γεγονότων.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
        <skos:narrower rdf:resource="#Primary"/>
        <skos:narrower rdf:resource="#Secondary_"/>
        <skos:related rdf:resource="#Event"/>
        <skos:related rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Expulsion">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">expulsion</rdfs:label>
        <skos:prefLabel xml:lang="en">expulsion</skos:prefLabel>
        <skos:definition xml:lang="en">The act of forcing someone out of a place, organization, or group, often as a punishment or consequence for violating rules, norms, or expectations.</skos:definition>
        <rdfs:label xml:lang="el">απέλαση</rdfs:label>
        <skos:prefLabel xml:lang="el">απέλαση</skos:prefLabel>
        <skos:definition xml:lang="el">Μεταβίβαση εξουσίας .</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Trial">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">trial</rdfs:label>
        <skos:prefLabel xml:lang="en">trial</skos:prefLabel>
        <skos:definition xml:lang="en">A formal examination of evidence in order for a person to be judged guilty or innocent.</skos:definition>
        <rdfs:label xml:lang="el">δίκη</rdfs:label>
        <skos:prefLabel xml:lang="el">δίκη</skos:prefLabel>
        <skos:definition xml:lang="el">Η δικαστική διαδικασία. Στο πλαίσιο της παρούσας οντοορολογίας κατατάσσεται στην κατηγορία {πολιτικό γεγονός,  νόμιμο, μη βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent_single_time">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">violent military event single time</rdfs:label>
        <skos:prefLabel xml:lang="en">violent military event single time</skos:prefLabel>
        <skos:definition xml:lang="en">A type of military event that is violent and occurs at a single point in time. This could be described as a military battle or engagement.</skos:definition>
        <rdfs:label xml:lang="el">βίαιο στρατιωτικό γεγονός που συνέβη μια φορά</rdfs:label>
        <skos:prefLabel xml:lang="el">βίαιο στρατιωτικό γεγονός που συνέβη μια φορά</skos:prefLabel>
        <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός που συνέβη μία φορά.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent"/>
        <skos:narrower rdf:resource="#Event_military_violent_single_time_single_location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Roman_Historian">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">roman historian</rdfs:label>
        <skos:prefLabel xml:lang="en">roman historian</skos:prefLabel>
        <skos:definition xml:lang="en">Someone who studies, analyzes, and interprets the history of ancient Rome, its people, culture, political systems, and events.</skos:definition>
        <rdfs:label xml:lang="el">ρωμαίος ιστορικός</rdfs:label>
        <skos:prefLabel xml:lang="el">ρωμαίος ιστορικός</skos:prefLabel>
        <skos:definition xml:lang="el">Ιστορικός ρωμαϊκής καταγωγής.</skos:definition>
        <skos:broader rdf:resource="#Historian"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Coup">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">coup</rdfs:label>
        <skos:prefLabel xml:lang="en">coup</skos:prefLabel>
        <skos:definition xml:lang="en">A sudden, illegal, and often violent seizure of power from a government or ruler by a small group of conspirators.</skos:definition>
        <rdfs:label xml:lang="el">πραξικόπημα</rdfs:label>
        <skos:prefLabel xml:lang="el">πραξικόπημα</skos:prefLabel>
        <skos:definition xml:lang="el">Αιφνιδιαστική ενέργεια ομάδας ενόπλων που ανατρέπει βίαια την υπάρχουσα (νόμιμη) πολιτική κατάσταση μιας χώρας με σκοπό την κατάκτηση της εξουσίας.</skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Biographer">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">biographer</rdfs:label>
        <skos:prefLabel xml:lang="en">biographer</skos:prefLabel>
        <skos:definition xml:lang="en">Author studies and writes about the life of other people.</skos:definition>
        <rdfs:label xml:lang="el">βιογράφος</rdfs:label>
        <skos:prefLabel xml:lang="el">βιογράφος</skos:prefLabel>
        <skos:definition xml:lang="el">Συγγραφέας μελετάει και γράφει για την ζωή άλλων ανθρώπων.</skos:definition>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">event</rdfs:label>
        <skos:prefLabel xml:lang="en">event</skos:prefLabel>
        <skos:definition xml:lang="en">A planned public or social occasion that takes place at a specific time and location. In particular, a historical event is a significant occurrence that has shaped or influenced the course of human history, often leading to political, social, economic, or cultural changes.</skos:definition>
        <rdfs:label xml:lang="el">γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, εξετάζονται ιστορικά γεγονότα και ο όρος 'γεγονός' δηλώνει το ιστορικό γεγονός.</skos:definition>
        <skos:narrower rdf:resource="#Event_intellectual"/>
        <skos:narrower rdf:resource="#Event_military"/>
        <skos:narrower rdf:resource="#Event_political"/>
        <skos:narrower rdf:resource="#Event_religious"/>
        <skos:narrower rdf:resource="#Event_violent"/>
        <skos:related rdf:resource="#Source"/>
        <skos:related rdf:resource="#Agent"/>
        <skos:related rdf:resource="#Location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Coin">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">coin</rdfs:label>
        <skos:prefLabel xml:lang="en">coin</skos:prefLabel>
        <skos:definition xml:lang="en">A small, flat, round piece of metal used as money. Coins are also valuable archaeological finds because they can provide important insights into the history, culture, economics, and politics of the societies that produced them.</skos:definition>
        <rdfs:label xml:lang="el">νόμισμα</rdfs:label>
        <skos:prefLabel xml:lang="el">νόμισμα</skos:prefLabel>
        <skos:definition xml:lang="el">Μικρών διαστάσεων μεταλλικό αντικείμενο σε σχήμα δίσκου, το οποίο στις επιφάνειές του έχει επιγραφές, αριθμούς και παραστάσεις που δηλώνουν την αξία του. Αποτελεί βασική πηγή της Ιστορίας.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent_single_time_single_location_land">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">land battle</rdfs:label>
        <skos:prefLabel xml:lang="en">land battle</skos:prefLabel>
        <skos:definition xml:lang="en">A ground battle or land warfare, refers to military combat that takes place on land.</skos:definition>
        <rdfs:label xml:lang="el">μάχη ξηράς</rdfs:label>
        <skos:prefLabel xml:lang="el">μάχη ξηράς</skos:prefLabel>
        <skos:definition xml:lang="el">Στρατιωτική σύγκρουση που λαμβάνει χώρα στην ξηρά.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent_single_time_single_location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Jewish_Historian">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">jewish historian</rdfs:label>
        <skos:prefLabel xml:lang="en">jewish historian</skos:prefLabel>
        <skos:definition xml:lang="en">A scholar who specializes in the study of Jewish history, culture, and heritage, exploring the experiences, achievements, and challenges of the Jewish people throughout the ages. </skos:definition>
        <rdfs:label xml:lang="el">εβραίος ιστορικός</rdfs:label>
        <skos:prefLabel xml:lang="el">εβραίος ιστορικός</skos:prefLabel>
        <skos:definition xml:lang="el">Ιστορικός εβραϊκής καταγωγής.</skos:definition>
        <skos:broader rdf:resource="#Historian"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Emperor">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">emperor</rdfs:label>
        <skos:prefLabel xml:lang="en">emperor</skos:prefLabel>
        <skos:definition xml:lang="en">Ruler of an empire. A monarch who rules over an empire or a large territory composed of multiple nations, cultures, or kingdoms. </skos:definition>
        <rdfs:label xml:lang="el">αυτοκράτορας</rdfs:label>
        <skos:prefLabel xml:lang="el">αυτοκράτορας</skos:prefLabel>
        <skos:definition xml:lang="el">Ιδιότηταρόλος κυβερνήτης μιας αυτοκρατορίας.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Function_religious">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">religious function</rdfs:label>
        <skos:prefLabel xml:lang="en">religious function</skos:prefLabel>
        <skos:definition xml:lang="en">A specific position or function within a religious community or organization that carries responsibilities related to spiritual leadership, guidance, ritual performance, and the maintenance of religious traditions. </skos:definition>
        <rdfs:label xml:lang="el">θρησκευτική λειτουργία</rdfs:label>
        <skos:prefLabel xml:lang="el">θρησκευτική λειτουργία</skos:prefLabel>
        <skos:definition xml:lang="el">Συγκεκριμένη θέση ή ρόλος σε μια θρησκευτική κοινότητα ή οργανισμό που φέρει ευθύνες σχετικές με την πνευματική ηγεσία, την καθοδήγηση, την τέλεση τελετουργιών και τη διατήρηση των θρησκευτικών παραδόσεων.</skos:definition>
        <skos:broader rdf:resource="#Function"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Artifact">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">artefact</rdfs:label>
        <skos:prefLabel xml:lang="en">artefact</skos:prefLabel>
        <skos:definition xml:lang="en">An artefact (or artifact) refers to an object made by a human being, typically one of cultural or historical interest,</skos:definition>
        <rdfs:label xml:lang="el">τεχνούργημα</rdfs:label>
        <skos:prefLabel xml:lang="el">τεχνούργημα</skos:prefLabel>
        <skos:definition xml:lang="el">Αντικείμενο κατασκευασμένο με ιδιαίτερη φροντίδα και τέχνη. Αποτελεί βασική ιστορική πηγή.</skos:definition>
        <skos:broader rdf:resource="#Source"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_organised_group_of_people_with_the_same_ideology_who_want_to_exercise_political_power">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political group</rdfs:label>
        <skos:prefLabel xml:lang="en">political group</skos:prefLabel>
        <skos:definition xml:lang="en">Group a group of people with the same ideology who want to exercise political power.</skos:definition>
        <rdfs:label xml:lang="el">πολιτική ομάδα</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτική ομάδα</skos:prefLabel>
        <skos:definition xml:lang="el">Oργανωμένη ομάδα ατόμων που μοιράζονται κοινούς πολιτικούς στόχους ή ιδεολογίες και συνεργάζονται για να επηρεάσουν τη δημόσια πολιτική ή να αποκτήσουν πολιτική εξουσία.</skos:definition>
        <skos:broader rdf:resource="#Agent_human_more_than_one_person"/>
    </skos:Concept>

    <skos:Concept rdf:about="#General">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">general</rdfs:label>
        <skos:prefLabel xml:lang="en">general</skos:prefLabel>
        <skos:definition xml:lang="en">A high-ranking military officer who holds a senior leadership position within an army. </skos:definition>
        <rdfs:label xml:lang="el">στρατηγός</rdfs:label>
        <skos:prefLabel xml:lang="el">στρατηγός</skos:prefLabel>
        <skos:definition xml:lang="el">Στρατικός αξιωματούχος, διοικητής του στρατού.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Slave">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">slave</rdfs:label>
        <skos:prefLabel xml:lang="en">slave</skos:prefLabel>
        <skos:definition xml:lang="en">A person forced to word for and obey another person, treated as their property, typically without compensation and under the threat of violence.</skos:definition>
        <rdfs:label xml:lang="el">δούλος</rdfs:label>
        <skos:prefLabel xml:lang="el">δούλος</skos:prefLabel>
        <skos:definition xml:lang="el">Άνθρωπος αναγκασμένος να λογοδοτεί και να υπακούει έναν άλλον άνθρωπο, του οποίου θεωρείται ιδιοκτησία.
</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_lawful">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">politcal lawful event</rdfs:label>
        <skos:prefLabel xml:lang="en">politcal lawful event</skos:prefLabel>
        <skos:definition xml:lang="en">An occurrence or action related to politics that is conducted within the boundaries of the law and adheres to legal norms and regulations.</skos:definition>
        <rdfs:label xml:lang="el">νόμιμο πολτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">νόμιμο πολτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας εκφράζει την έννοια  {πολιτικό γεγονός, νόμιμο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political"/>
        <skos:narrower rdf:resource="#Event_political_lawful_non-violent"/>
        <skos:narrower rdf:resource="#Event_political_lawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_organised_group_union_made_of_smaller_political_entities_or_states">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political union of states</rdfs:label>
        <skos:prefLabel xml:lang="en">political union of states</skos:prefLabel>
        <skos:definition xml:lang="en">A formal arrangement where multiple states or regions come together to form a single political entity. </skos:definition>
        <rdfs:label xml:lang="el">ένωση πόλεων</rdfs:label>
        <skos:prefLabel xml:lang="el">ένωση πόλεων</skos:prefLabel>
        <skos:definition xml:lang="el">Σύνδεση πόλεων ώστε να αποτελούν ένα ενιαίο πολιτικό σύνολο.</skos:definition>
        <skos:broader rdf:resource="#Agent_human_more_than_one_person"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Series_of_military_operations">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">campaign</rdfs:label>
        <skos:prefLabel xml:lang="en">campaign</skos:prefLabel>
        <skos:definition xml:lang="en">A series of military operations designed to achieve a specific objective, involving multiple locations and timelines. </skos:definition>
        <rdfs:label xml:lang="el">εκστρατεία</rdfs:label>
        <skos:prefLabel xml:lang="el">εκστρατεία</skos:prefLabel>
        <skos:definition xml:lang="el">Σειρά πολεμικών επιχειρήσεων με σκοπό την εκπλήρωση συγκεκριμένου στόχου. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα }.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent_multi-location_multi-time"/>
    </skos:Concept>

    <skos:Concept rdf:about="#King-Queen">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">king-queen</rdfs:label>
        <skos:prefLabel xml:lang="en">king-queen</skos:prefLabel>
        <skos:definition xml:lang="en">Male and female monarch (respectively) who hold the highest positions of authority and sovereignty in a kingdom or monarchy.</skos:definition>
        <rdfs:label xml:lang="el">βασιλιάς-βασίλισσα</rdfs:label>
        <skos:prefLabel xml:lang="el">βασιλιάς-βασίλισσα</skos:prefLabel>
        <skos:definition xml:lang="el">Ιδιότηταρόλος κυβερνήτης-τρια ενός ανεξάρτητου κράτους ή συνόλου γαιών.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Non_violent_demonstration">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">non-violent demonstration</rdfs:label>
        <skos:prefLabel xml:lang="en">non-violent demonstration</skos:prefLabel>
        <skos:definition xml:lang="en">A peaceful protest, where participants express their views, demands, or grievances without resorting to violence.</skos:definition>
        <rdfs:label xml:lang="el">μη βίαιη διαδήλωση </rdfs:label>
        <skos:prefLabel xml:lang="el">μη βίαιη διαδήλωση </skos:prefLabel>
        <skos:definition xml:lang="el">Μαζική και δημόσια διεκδίκηση για την ικανοποίηση ενός αιτήματος. </skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent_multi-location_multi-time">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military event multi-location multi-time</rdfs:label>
        <skos:prefLabel xml:lang="en">military event multi-location multi-time</skos:prefLabel>
        <skos:definition xml:lang="en">A military event that is violent, occurs across multiple locations, and spans multiple time periods, such as a large-scale, prolonged conflict or a series of interconnected military operations.</skos:definition>
        <rdfs:label xml:lang="el">βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα</rdfs:label>
        <skos:prefLabel xml:lang="el">βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα</skos:prefLabel>
        <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός που συνέβη σε περισσότερους από έναν τόπους και χρονικές στιγμές. </skos:definition>
        <skos:broader rdf:resource="#Event_military_violent"/>
        <skos:narrower rdf:resource="#Series_of_military_operations"/>
        <skos:narrower rdf:resource="#Armed_conflict"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Philosopher">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">philosopher</rdfs:label>
        <skos:prefLabel xml:lang="en">philosopher</skos:prefLabel>
        <skos:definition xml:lang="en">A scholar who studies fundamental questions about the human existence and knowledge.</skos:definition>
        <rdfs:label xml:lang="el">φιλόσοφος</rdfs:label>
        <skos:prefLabel xml:lang="el">φιλόσοφος</skos:prefLabel>
        <skos:definition xml:lang="el">Κάποιος που  μελετάει θεμελιώδη ζητήματα της ανθρώπινης ύπαρξης.</skos:definition>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_non_human">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">non human agent</rdfs:label>
        <skos:prefLabel xml:lang="en">non human agent</skos:prefLabel>
        <skos:definition xml:lang="en">Any entity or force that influences events, processes, or outcomes without being a human being.</skos:definition>
        <rdfs:label xml:lang="el">μη ανθρώπινος παράγοντας</rdfs:label>
        <skos:prefLabel xml:lang="el">μη ανθρώπινος παράγοντας</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογία, η έννοια 'μη ανθρώπινος παράγοντας' κατηγοροποιείται σε αντιδιαστολή προς την έννοια 'ανθρώπινος παράγοντας'. </skos:definition>
        <skos:broader rdf:resource="#Agent"/>
        <skos:narrower rdf:resource="#Natural_Agent"/>
        <skos:narrower rdf:resource="#Mythological_Agent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political event</rdfs:label>
        <skos:prefLabel xml:lang="en">political event</skos:prefLabel>
        <skos:definition xml:lang="en">Any occurrence or activity related to politics that involves the exercise, expression, or impact of political power, policy, or governance. </skos:definition>
        <rdfs:label xml:lang="el">πολιτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Συμβάν ή εξέλιξη που επηρεάζει την πολιτική κατάσταση ενός κράτους ή μιας περιοχής.</skos:definition>
        <skos:broader rdf:resource="#Event"/>
        <skos:narrower rdf:resource="#Event_political_lawful"/>
        <skos:narrower rdf:resource="#Event_political_unlawful"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Pharaoh">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">pharaoh</rdfs:label>
        <skos:prefLabel xml:lang="en">pharaoh</skos:prefLabel>
        <skos:definition xml:lang="en">The title used for the ancient rulers of Egypt, who were considered both political leaders and divine figures.</skos:definition>
        <rdfs:label xml:lang="el">φαραώ</rdfs:label>
        <skos:prefLabel xml:lang="el">φαραώ</skos:prefLabel>
        <skos:definition xml:lang="el">Τίτλος των ηγεμόνων της αρχαίας Aιγύπτου, Στο πλαίσιο της παρούσας οντοορολογίας κατηγοριοποιείται ως {ιδιότηταρόλος του κυβερνήτη της Αιγύπτου}.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Withdrawal">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">withdrawal</rdfs:label>
        <skos:prefLabel xml:lang="en">withdrawal</skos:prefLabel>
        <skos:definition xml:lang="en">Distancing oneself from social or military interactions.</skos:definition>
        <rdfs:label xml:lang="el">υποχώρηση</rdfs:label>
        <skos:prefLabel xml:lang="el">υποχώρηση</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας κατηγοριοποιείται ως μη βίαιο στρατιωτικό γεγονός που σημαίνει το τέλος στρατιωτικής δραστηριότητας.</skos:definition>
        <skos:broader rdf:resource="#Event_military_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Revolt">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">revolt</rdfs:label>
        <skos:prefLabel xml:lang="en">revolt</skos:prefLabel>
        <skos:definition xml:lang="en">An unlawful, violent, and often sudden overthrow of the existing social, political, or economic order, typically involving a significant change in power structures and governance.</skos:definition>
        <rdfs:label xml:lang="el">επανάσταση</rdfs:label>
        <skos:prefLabel xml:lang="el">επανάσταση</skos:prefLabel>
        <skos:definition xml:lang="el">Το σύνολο των ιστορικών γεγονότων που συμβαίνουν σε μία κοινωνία, όταν ένα τμήμα της εξεγείρεται με σκοπό την κατάληψη της εξουσίας. Μια επανάσταση συνήθως συνεπάγεται μια ριζική και συχνά βίαιη αλλαγή στην πολιτική ή κοινωνική δομή μιας χώρας. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {πολιτικό γεγονός, άνομο, βίαιο, βίαιη εκτόπιση της κοινωνικής τάξης στην εξουσία}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Consul">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">consul</rdfs:label>
        <skos:prefLabel xml:lang="en">consul</skos:prefLabel>
        <skos:definition xml:lang="en">The highest-ranking magistrates in the Roman Republic. They were annually elected, ruled jointly, and played a crucial role in the political and military leadership of the state.</skos:definition>
        <rdfs:label xml:lang="el">ύπατος</rdfs:label>
        <skos:prefLabel xml:lang="el">ύπατος</skos:prefLabel>
        <skos:definition xml:lang="el">Ιδιότηταρόλος ενός από τους δύο ετησίως επιλεγμένους στρατηγούς που κυβερνούσαν από κοινού την ρωμαϊκή δημοκρατία.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_human_one_person">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">person</rdfs:label>
        <skos:prefLabel xml:lang="en">person</skos:prefLabel>
        <skos:definition xml:lang="en">An individual human being, with unique identity, consciousness, and capacity for thought, emotion, and interaction with others.</skos:definition>
        <rdfs:label xml:lang="el">άνθρωπος</rdfs:label>
        <skos:prefLabel xml:lang="el">άνθρωπος</skos:prefLabel>
        <skos:definition xml:lang="el">Ένα πρόσωπο ή μια οντότητα που ενεργεί.</skos:definition>
        <skos:broader rdf:resource="#Agent_human"/>
        <skos:related rdf:resource="#Agent_human_one_person"/>
        <skos:related rdf:resource="#Agent_human_one_person"/>
        <skos:related rdf:resource="#Author"/>
        <skos:related rdf:resource="#Role"/>
        <skos:related rdf:resource="#Agent_human_more_than_one_person"/>
        <skos:related rdf:resource="#Event"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_political_unlawful_non-violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political event unlawful non-violent</rdfs:label>
        <skos:prefLabel xml:lang="en">political event unlawful non-violent</skos:prefLabel>
        <skos:definition xml:lang="en">A political activity or occurrence that is not permitted by law but is conducted without the use of violence.</skos:definition>
        <rdfs:label xml:lang="el">πολιτικό γεγονός άνομο μη βίαιο</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτικό γεγονός άνομο μη βίαιο</skos:prefLabel>
        <skos:definition xml:lang="el">Πολιτικό γεγονός που δεν συμμορφώνεται με τους ισχύοντες νόμους και δεν περιλαμβάνει τη χρήση βίας.</skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful"/>
        <skos:narrower rdf:resource="#Non_violent_demonstration"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Primary">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">primary source</rdfs:label>
        <skos:prefLabel xml:lang="en">primary source</skos:prefLabel>
        <skos:definition xml:lang="en">Original document or object created during the time of a historical event. They provide firsthand evidence and direct insights into the past.</skos:definition>
        <rdfs:label xml:lang="el">πρωτογενής πηγή</rdfs:label>
        <skos:prefLabel xml:lang="el">πρωτογενής πηγή</skos:prefLabel>
        <skos:definition xml:lang="el">Πρωτότυπα κείμενα και αντικείμενα που χρονολογούνται στην ίδια περίοδο με το ιστορικό γεγονός.</skos:definition>
        <skos:broader rdf:resource="#Text"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <skos:topConceptOf rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">agent</rdfs:label>
        <skos:prefLabel xml:lang="en">agent</skos:prefLabel>
        <skos:definition xml:lang="en">A person or entity that acts.</skos:definition>
        <rdfs:label xml:lang="el">παράγοντας</rdfs:label>
        <skos:prefLabel xml:lang="el">παράγοντας</skos:prefLabel>
        <skos:definition xml:lang="el">Αυτός, -ή, -ό που επιδρά ή συντελεί σε κάποιο ιστορικό γεγονός.</skos:definition>
        <skos:narrower rdf:resource="#Agent_human"/>
        <skos:narrower rdf:resource="#Agent_non_human"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Satrap">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">satrap</rdfs:label>
        <skos:prefLabel xml:lang="en">satrap</skos:prefLabel>
        <skos:definition xml:lang="en">A provincial governor in the ancient Persian Empire, particularly during the Achaemenid, Parthian, and Sassanid periods. </skos:definition>
        <rdfs:label xml:lang="el">σατράπης</rdfs:label>
        <skos:prefLabel xml:lang="el">σατράπης</skos:prefLabel>
        <skos:definition xml:lang="el">Αξιωματούχος που διόριζε ο Πέρσης βασιλιάς για να διοικεί τις επαρχίες (σατραπείες) της Περσικής αυτοκρατορίας.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Legal_repression">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">legal repression</rdfs:label>
        <skos:prefLabel xml:lang="en">legal repression</skos:prefLabel>
        <skos:definition xml:lang="en"> The use of laws and the legal system by a government or ruling authority to suppress dissent, restrict freedoms, and control or punish individuals or groups.</skos:definition>
        <rdfs:label xml:lang="el">νομική καταστολή</rdfs:label>
        <skos:prefLabel xml:lang="el">νομική καταστολή</skos:prefLabel>
        <skos:definition xml:lang="el">Xρήση νόμων και νομικών μηχανισμών από τις αρχές για την καταστολή της διαφωνίας, τον περιορισμό των ελευθεριών ή τον έλεγχο ορισμένων ομάδων ή δραστηριοτήτων.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Election">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">election</rdfs:label>
        <skos:prefLabel xml:lang="en">election</skos:prefLabel>
        <skos:definition xml:lang="en">A formal and lawful political process where citizens vote to choose a candidate for a political position or to express their preference on a specific issue.</skos:definition>
        <rdfs:label xml:lang="el">εκλογή</rdfs:label>
        <skos:prefLabel xml:lang="el">εκλογή</skos:prefLabel>
        <skos:definition xml:lang="el">Ανάδειξη σε ένα αξίωμα μέσω ψηφοφορίας. Στο πλαίσιο της παρούσας οντοορολογίας κατατάσσεται στην κατηγορία {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Mythological_Agent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">mythological agent</rdfs:label>
        <skos:prefLabel xml:lang="en">mythological agent</skos:prefLabel>
        <skos:definition xml:lang="en">A character or entity from mythology that plays an active role in myths, legends, and similar narratives helping to explain the origins of the world, human experiences, and moral lessons within a particular culture.</skos:definition>
        <rdfs:label xml:lang="el">μυθολογικός παράγοντας</rdfs:label>
        <skos:prefLabel xml:lang="el">μυθολογικός παράγοντας</skos:prefLabel>
        <skos:definition xml:lang="el">Στοιχείο της φύσης που επηρεάζει τα γεγονότα και εμπεριέχει μύθους.</skos:definition>
        <skos:broader rdf:resource="#Agent_non_human"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_human_more_than_one_person">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">group</rdfs:label>
        <skos:prefLabel xml:lang="en">group</skos:prefLabel>
        <skos:definition xml:lang="en">Human agent organised group.</skos:definition>
        <rdfs:label xml:lang="el">ομάδα</rdfs:label>
        <skos:prefLabel xml:lang="el">ομάδα</skos:prefLabel>
        <skos:definition xml:lang="el">Οργανωμένο σύνολο ανθρώπων. Στην παρούσα οντοορολογία αποτελεί υποκατηγορία της κατηγορίας {ανθρώπινος παράγοντας}.</skos:definition>
        <skos:broader rdf:resource="#Agent_human"/>
        <skos:narrower rdf:resource="#Agent_organised_group_succession_of_rulers_of_the_same_line_of_descent"/>
        <skos:narrower rdf:resource="#Agent_organised_group_of_people_with_the_same_ideology_who_want_to_exercise_political_power"/>
        <skos:narrower rdf:resource="#Agent_organised_group_union_made_of_smaller_political_entities_or_states"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Assembly_vote">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">assembly</rdfs:label>
        <skos:prefLabel xml:lang="en">assembly</skos:prefLabel>
        <skos:definition xml:lang="en">A group of people gathered together for a common purpose, such as a legislative body.</skos:definition>
        <rdfs:label xml:lang="el">συνέλευση</rdfs:label>
        <skos:prefLabel xml:lang="el">συνέλευση</skos:prefLabel>
        <skos:definition xml:lang="el">Προγραμματισμένη συγκέντρωση συνόλου ανθρώπων, για να συζητήσουν κάποιο θέμα και για να πάρουν αποφάσεις. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_organised_group_succession_of_rulers_of_the_same_line_of_descent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">dynasty</rdfs:label>
        <skos:prefLabel xml:lang="en">dynasty</skos:prefLabel>
        <skos:definition xml:lang="en">A succession of rulers or prominent figures from the same family or line of descent. </skos:definition>
        <rdfs:label xml:lang="el">δυναστεία</rdfs:label>
        <skos:prefLabel xml:lang="el">δυναστεία</skos:prefLabel>
        <skos:definition xml:lang="el">Διαδοχική σειρά κληρονομικών αρχόντων που ανήκουν στην ίδια οικογένεια.</skos:definition>
        <skos:broader rdf:resource="#Agent_human_more_than_one_person"/>
        <skos:related rdf:resource="#Event"/>
        <skos:related rdf:resource="#Agent_human_one_person"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Reform">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">reform</rdfs:label>
        <skos:prefLabel xml:lang="en">reform</skos:prefLabel>
        <skos:definition xml:lang="en">A lawful, non-violent process aimed at bringing about political, economic, or social changes to improve the state or society.</skos:definition>
        <rdfs:label xml:lang="el">μεταρρύθμιση</rdfs:label>
        <skos:prefLabel xml:lang="el">μεταρρύθμιση</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, η έννοια που εκφράζει ο όρος 'μεταρρύθμιση' κατηγοροποιείται ως {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_lawful_non-violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Tyrant">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">tyrant</rdfs:label>
        <skos:prefLabel xml:lang="en">tyrant</skos:prefLabel>
        <skos:definition xml:lang="en">An oppressive ruler.</skos:definition>
        <rdfs:label xml:lang="el">τύραννος</rdfs:label>
        <skos:prefLabel xml:lang="el">τύραννος</skos:prefLabel>
        <skos:definition xml:lang="el">Απόλυτος άρχοντας που καταλαμβάνει την εξουσία με βίαια ή με παράνομα μέσα. Καταπιεστικός κυβερνήτης.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#City">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">city</rdfs:label>
        <skos:prefLabel xml:lang="en">city</skos:prefLabel>
        <skos:definition xml:lang="en">A large and permanent human settlement.</skos:definition>
        <rdfs:label xml:lang="el">πόλη</rdfs:label>
        <skos:prefLabel xml:lang="el">πόλη</skos:prefLabel>
        <skos:definition xml:lang="el">Χερσαία τοποθεσία, κατοικημένη, με σαφή κοινωνική και πολιτική οργάνωση.</skos:definition>
        <skos:broader rdf:resource="#Location_land"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Assasination">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">assasination</rdfs:label>
        <skos:prefLabel xml:lang="en">assasination</skos:prefLabel>
        <skos:definition xml:lang="en">The deliberate killing of a prominent or important person, often for political or ideological reasons.</skos:definition>
        <rdfs:label xml:lang="el">δολοφονία</rdfs:label>
        <skos:prefLabel xml:lang="el">δολοφονία</skos:prefLabel>
        <skos:definition xml:lang="el">Αφαίρεση της ζωής άλλου ανθρώπου με βίαιο τρόπο. Στο πλαίσιο της παρούσας οντοορολογίας ανήκει στην κατηγορία {πολιτικό γεγονός, άνομο, βίαιο, η πράξη του φόνου}.</skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_multi-time_single_location">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military event multi-time single location</rdfs:label>
        <skos:prefLabel xml:lang="en">military event multi-time single location</skos:prefLabel>
        <skos:definition xml:lang="en">A military event that is violent, occurs over multiple time periods, but is confined to a single location typically refers to a prolonged siege, a series of battles or campaigns focused on a specific geographical area, or a recurring conflict centered around a particular strategic site,</skos:definition>
        <rdfs:label xml:lang="el">βίαιο στρατιωτικό γεγονός σε πολλούς χρόνους σε μια τοποθεσία</rdfs:label>
        <skos:prefLabel xml:lang="el">βίαιο στρατιωτικό γεγονός σε πολλούς χρόνους σε μια τοποθεσία</skos:prefLabel>
        <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός που συνέβη σε περισσότερες από μία χρονικές στιγμές, σε έναν τόπο.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent"/>
        <skos:narrower rdf:resource="#Event_military_multi-time_single_location_city"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Prince-Princess">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">prince-princess</rdfs:label>
        <skos:prefLabel xml:lang="en">prince-princess</skos:prefLabel>
        <skos:definition xml:lang="en">Role the son or daughter of a monarch.</skos:definition>
        <rdfs:label xml:lang="el">πρίγκηπας-πριγκήπισσα</rdfs:label>
        <skos:prefLabel xml:lang="el">πρίγκηπας-πριγκήπισσα</skos:prefLabel>
        <skos:definition xml:lang="el">Γιός - κόρη μονάρχη.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Island">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">island</rdfs:label>
        <skos:prefLabel xml:lang="en">island</skos:prefLabel>
        <skos:definition xml:lang="en">A landmass, smaller than a continent, that is surrounded by water.</skos:definition>
        <rdfs:label xml:lang="el">νησί</rdfs:label>
        <skos:prefLabel xml:lang="el">νησί</skos:prefLabel>
        <skos:definition xml:lang="el">Χερσαία τοποθεσία που περιβρέχεται από υγρό στοιχείο (θάλασσα, λίμνη, ποταμό).</skos:definition>
        <skos:broader rdf:resource="#Location_land"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Historian">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">historian</rdfs:label>
        <skos:prefLabel xml:lang="en">historian</skos:prefLabel>
        <skos:definition xml:lang="en">A scholar who studies, researches, interprets, and writes about the past. Historians analyze and contextualize historical events, people, cultures, and processes to deepen our understanding of human experiences and societal changes over time. </skos:definition>
        <rdfs:label xml:lang="el">ιστορικός</rdfs:label>
        <skos:prefLabel xml:lang="el">ιστορικός</skos:prefLabel>
        <skos:definition xml:lang="el">Συγγραφέας που μελετάει τα γεγονότα και τις περιόδους της ιστορίας.που μελετά, ερευνά και καταγράφει τα γεγονότα του παρελθόντος αναλύοντας πρωτογενείς και δευτερογενείς πηγές, όπως έγγραφα, αρχεία, μαρτυρίες και αντικείμενα. Με το έργο του συντελεί στη διατήρηση της ιστορικής μνήμης και στη διαμόρφωση της κατανόησης του παρελθόντος και επηρεάζει την λήψη αποφάσεων στο παρόν.</skos:definition>
        <skos:note xml:lang="el">--- new note --- A historian studies the chronological record of events, usually attempting, on the basis of a critical examination of source materials, to explain events. </skos:note>
        <skos:broader rdf:resource="#Author"/>
        <skos:narrower rdf:resource="#Roman_Historian"/>
        <skos:narrower rdf:resource="#Greek_Historian"/>
        <skos:narrower rdf:resource="#Jewish_Historian"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Priest">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">priest</rdfs:label>
        <skos:prefLabel xml:lang="en">priest</skos:prefLabel>
        <skos:definition xml:lang="en">Someone authorized in performing the sacred rites of a religion or cult.</skos:definition>
        <rdfs:label xml:lang="el">ιερέας</rdfs:label>
        <skos:prefLabel xml:lang="el">ιερέας</skos:prefLabel>
        <skos:definition xml:lang="el">Ιδιότηταρόλος που εξουσιοδοτεί αυτόν που τον έχει να πραγματοποιεί τις ιερές τελετουργίες μιας θρησκείας ή λατρείας.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Function_political">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">political function</rdfs:label>
        <skos:prefLabel xml:lang="en">political function</skos:prefLabel>
        <skos:definition xml:lang="en">The roles, activities, or responsibilities associated with the operation and management of political systems, institutions, or processes.</skos:definition>
        <rdfs:label xml:lang="el">πολιτική λειτουργία</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιτική λειτουργία</skos:prefLabel>
        <skos:definition xml:lang="el">Ρόλος, ιδιότητα, θέση που αφορά την πολιτική ζωή της κοινωνίας.</skos:definition>
        <skos:broader rdf:resource="#Function"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_religious_lawful">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">festival</rdfs:label>
        <skos:prefLabel xml:lang="en">festival</skos:prefLabel>
        <skos:definition xml:lang="en">A time of celebration, commemoration, or observance that is rooted in the beliefs, traditions, and practices of a religious group.</skos:definition>
        <rdfs:label xml:lang="el">γιορτή </rdfs:label>
        <skos:prefLabel xml:lang="el">γιορτή </skos:prefLabel>
        <skos:definition xml:lang="el">Θρησκευτικό γεγονός νόμιμος.</skos:definition>
        <skos:broader rdf:resource="#Event_religious"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Orator">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">orator</rdfs:label>
        <skos:prefLabel xml:lang="en">orator</skos:prefLabel>
        <skos:definition xml:lang="en">A person who is skilled in public speaking, particularly someone who delivers speeches in a formal or influential manner. </skos:definition>
        <rdfs:label xml:lang="el">ρήτορας</rdfs:label>
        <skos:prefLabel xml:lang="el">ρήτορας</skos:prefLabel>
        <skos:definition xml:lang="el">Ομιλητή που χρησιμοποιεί τη δύναμη του λόγου, για να επηρεάσει την κοινή γνώμη, να επιχειρηματολογήσει στο δικαστήριο, ή να συμμετάσχει σε πολιτικές και φιλοσοφικές συζητήσεις.</skos:definition>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Governor">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">governor</rdfs:label>
        <skos:prefLabel xml:lang="en">governor</skos:prefLabel>
        <skos:definition xml:lang="en">An official appointed or elected to exercise political and administrative authority over a region, state, province, or territory.</skos:definition>
        <rdfs:label xml:lang="el">κυβερνήτης</rdfs:label>
        <skos:prefLabel xml:lang="el">κυβερνήτης</skos:prefLabel>
        <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας είναι η Ιδιότηταρόλος του ηγέτη ή διοικητή συγκεκριμένης περιοχής.</skos:definition>
        <skos:broader rdf:resource="#Role"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_violent_single_time_single_location">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">battle</rdfs:label>
        <skos:prefLabel xml:lang="en">battle</skos:prefLabel>
        <skos:definition xml:lang="en">For the purposes of this ontoterminology, a battle is categorized as a military event that is violent, occurring at a single time and in a single location.</skos:definition>
        <rdfs:label xml:lang="el">μάχη</rdfs:label>
        <skos:prefLabel xml:lang="el">μάχη</skos:prefLabel>
        <skos:definition xml:lang="el">Ένοπλη σύγκρουση μεταξύ δύο στρατών στα πλαίσια ενός πολέμου. Στο πλαίσιο της παρούσας οντοορολογίας κατηγοριοποιείται ως {βίαιο στρατιωτικό γεγονός που συνέβη μια φορά, μοναδικού τόπου}.</skos:definition>
        <skos:broader rdf:resource="#Event_military_violent_single_time"/>
        <skos:narrower rdf:resource="#Event_military_violent_single_time_single_location_land"/>
        <skos:narrower rdf:resource="#Event_military_violent_single_time_single_location_sea"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Geographer">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">geographer</rdfs:label>
        <skos:prefLabel xml:lang="en">geographer</skos:prefLabel>
        <skos:definition xml:lang="en">A scholar who studies the Earth's physical, biological, and human environments, as well as the interactions between them.</skos:definition>
        <rdfs:label xml:lang="el">γεωγράφος</rdfs:label>
        <skos:prefLabel xml:lang="el">γεωγράφος</skos:prefLabel>
        <skos:definition xml:lang="el">Συγγραφέας μελετάει το φυσικό περιβάλλον και πως ανακατανέμεται.</skos:definition>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Historiographer">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">historiographer</rdfs:label>
        <skos:prefLabel xml:lang="en">historiographer</skos:prefLabel>
        <skos:definition xml:lang="en">Someone who writes history. In particular, someone who ho focuses on the study of the history of historical writing, the methods used by historians, and the evolution of historical interpretations over time.</skos:definition>
        <rdfs:label xml:lang="el">ιστοριογράφος</rdfs:label>
        <skos:prefLabel xml:lang="el">ιστοριογράφος</skos:prefLabel>
        <skos:definition xml:lang="el">Συγγραφέας που έχει συγγράψει ιστορία της εποχής του ή της χώρας του.</skos:definition>
        <skos:note xml:lang="el">--- new note ---A historiographer studies how history was written, who wrote it, and what factors influenced how it was written.</skos:note>
        <skos:example xml:lang="el">--- new context ---
--- should contain the term ---</skos:example>
        <skos:broader rdf:resource="#Author"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_multi-time_single_location_city">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">siege</rdfs:label>
        <skos:prefLabel xml:lang="en">siege</skos:prefLabel>
        <skos:definition xml:lang="en">A prolonged military operation in which enemy forces surround a city or fortified location with the aim of capturing it, often by cutting off supplies and communication until the defenders surrender or are defeated.</skos:definition>
        <rdfs:label xml:lang="el">πολιορκία</rdfs:label>
        <skos:prefLabel xml:lang="el">πολιορκία</skos:prefLabel>
        <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός σε πολλούς χρόνους σε μια τοποθεσία στρατιωτική επιχείρηση κατά την οποία εχθρικές δυνάμεις περικυκλώνουν μια πόλη .</skos:definition>
        <skos:broader rdf:resource="#Event_military_multi-time_single_location"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Agent_human_non-organised_group">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">crowd</rdfs:label>
        <skos:prefLabel xml:lang="en">crowd</skos:prefLabel>
        <skos:definition xml:lang="en">Large group of people gathered together in a disorganized or informal way.</skos:definition>
        <rdfs:label xml:lang="el">πλήθος</rdfs:label>
        <skos:prefLabel xml:lang="el">πλήθος</skos:prefLabel>
        <skos:definition xml:lang="el">Μεγάλη ομάδα ανθρώπων συγκεντρωμένη σε μια τοποθεσία.</skos:definition>
        <skos:broader rdf:resource="#Agent_human"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Event_military_non-violent">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">military event non-violent</rdfs:label>
        <skos:prefLabel xml:lang="en">military event non-violent</skos:prefLabel>
        <skos:definition xml:lang="en">Activities or occurrences involving armed forces that do not entail combat or the use of force. </skos:definition>
        <rdfs:label xml:lang="el">μη βίαιο στρατιωτικό γεγονός</rdfs:label>
        <skos:prefLabel xml:lang="el">μη βίαιο στρατιωτικό γεγονός</skos:prefLabel>
        <skos:definition xml:lang="el">Συμβάν που αφορά στρατιωτικές δυνάμεις και δεν εμπεριέχει τη χρήση βίας.</skos:definition>
        <skos:broader rdf:resource="#Event_military"/>
        <skos:narrower rdf:resource="#Armistice"/>
        <skos:narrower rdf:resource="#Truce"/>
        <skos:narrower rdf:resource="#Withdrawal"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Sedition">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">sedition</rdfs:label>
        <skos:prefLabel xml:lang="en">sedition</skos:prefLabel>
        <skos:definition xml:lang="en">An unlawful, violent uprising in which people are called upon to rebel against established authority, typically a government or ruling power.</skos:definition>
        <rdfs:label xml:lang="el">στάση</rdfs:label>
        <skos:prefLabel xml:lang="el">στάση</skos:prefLabel>
        <skos:definition xml:lang="el">Εξέγερση, αντίσταση απέναντι στην εξουσία. Βίαιο πολιτικό γεγονός, συχνά με σκοπό την ανατροπή της παρούσας διοίκησης και την κατάληψη της εξουσίας. </skos:definition>
        <skos:broader rdf:resource="#Event_political_unlawful_violent"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Function_intellectual">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">intellectual function</rdfs:label>
        <skos:prefLabel xml:lang="en">intellectual function</skos:prefLabel>
        <skos:definition xml:lang="en">A role or fuction affecting the intellectual life of a group or community.</skos:definition>
        <rdfs:label xml:lang="el">πνευματική λειτουργία</rdfs:label>
        <skos:prefLabel xml:lang="el">πνευματική λειτουργία</skos:prefLabel>
        <skos:definition xml:lang="el">Ρόλος, ιδιότητα, θέση που αφορά την πνευματική ζωή της κοινωνίας.
</skos:definition>
        <skos:broader rdf:resource="#Function"/>
    </skos:Concept>

    <skos:Concept rdf:about="#Location_sea">
        <skos:inScheme rdf:resource="http://www.ontologia.fr/OTB/Events-hellenistic-v.1.0"/>
        <rdfs:label xml:lang="en">sea </rdfs:label>
        <skos:prefLabel xml:lang="en">sea </skos:prefLabel>
        <skos:definition xml:lang="en">A large body of salt water partially or fully enclosed by land.</skos:definition>
        <rdfs:label xml:lang="el">θαλάσσια τοποθεσία</rdfs:label>
        <skos:prefLabel xml:lang="el">θαλάσσια τοποθεσία</skos:prefLabel>
        <skos:definition xml:lang="el">Γεωγραφική περιοχή που βρίσκεται μέσα σε μια θάλασσα.</skos:definition>
        <skos:broader rdf:resource="#Location"/>
    </skos:Concept>

