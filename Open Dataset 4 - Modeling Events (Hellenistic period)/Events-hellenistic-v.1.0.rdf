        <ontolex:denotes rdf:resource="#Coup"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πνευματικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πνευματικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">πνευματικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πνευματικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#πνευματικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Mια συγκέντρωση, τελετή ή εμπειρία που έχει βαθιά πνευματική σημασία για τους συμμετέχοντες.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_intellectual"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ομάδα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ομάδα_el">
                <ontolex:writtenRep xml:lang="el">ομάδα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ομάδα_el">
                <ontolex:isEvokedBy rdf:resource="#ομάδα_el"/>
                <skos:definition xml:lang="el">Οργανωμένο σύνολο ανθρώπων. Στην παρούσα οντοορολογία αποτελεί υποκατηγορία της κατηγορίας {ανθρώπινος παράγοντας}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_human_more_than_one_person"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μη_ανθρώπινος_παράγοντας_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μη_ανθρώπινος_παράγοντας_el">
                <ontolex:writtenRep xml:lang="el">μη ανθρώπινος παράγοντας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μη_ανθρώπινος_παράγοντας_el">
                <ontolex:isEvokedBy rdf:resource="#μη_ανθρώπινος_παράγοντας_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογία, η έννοια 'μη ανθρώπινος παράγοντας' κατηγοροποιείται σε αντιδιαστολή προς την έννοια 'ανθρώπινος παράγοντας'. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_non_human"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#παράγοντας_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_παράγοντας_el">
                <ontolex:writtenRep xml:lang="el">παράγοντας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_παράγοντας_el">
                <ontolex:isEvokedBy rdf:resource="#παράγοντας_el"/>
                <skos:definition xml:lang="el">Αυτός, -ή, -ό που επιδρά ή συντελεί σε κάποιο ιστορικό γεγονός.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#μη_βίαιη_διαδήλωση__el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_μη_βίαιη_διαδήλωση__el">
                <ontolex:writtenRep xml:lang="el">μη βίαιη διαδήλωση </ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_μη_βίαιη_διαδήλωση__el">
                <ontolex:isEvokedBy rdf:resource="#μη_βίαιη_διαδήλωση__el"/>
                <skos:definition xml:lang="el">Μαζική και δημόσια διεκδίκηση για την ικανοποίηση ενός αιτήματος. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Non_violent_demonstration"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#τύραννος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_τύραννος_el">
                <ontolex:writtenRep xml:lang="el">τύραννος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_τύραννος_el">
                <ontolex:isEvokedBy rdf:resource="#τύραννος_el"/>
                <skos:definition xml:lang="el">Απόλυτος άρχοντας που καταλαμβάνει την εξουσία με βίαια ή με παράνομα μέσα. Καταπιεστικός κυβερνήτης.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Tyrant"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#γιορτή__el">
        <ontolex:lexicalForm>
