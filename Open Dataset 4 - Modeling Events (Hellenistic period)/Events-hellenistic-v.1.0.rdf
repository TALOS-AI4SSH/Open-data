                <ontolex:isEvokedBy rdf:resource="#μεταρρύθμιση_el"/>
                <skos:definition xml:lang="el">Στο πλαίσιο της παρούσας οντοορολογίας, η έννοια που εκφράζει ο όρος 'μεταρρύθμιση' κατηγοροποιείται ως {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Reform"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πραξικόπημα_el">
