            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_στρατιωτική_λειτουργία_el">
                <ontolex:isEvokedBy rdf:resource="#στρατιωτική_λειτουργία_el"/>
                <skos:definition xml:lang="el">Στρατιωτικό αξίωμα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Function_military"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιορκία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιορκία_el">
                <ontolex:writtenRep xml:lang="el">πολιορκία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιορκία_el">
                <ontolex:isEvokedBy rdf:resource="#πολιορκία_el"/>
                <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός σε πολλούς χρόνους σε μια τοποθεσία στρατιωτική επιχείρηση κατά την οποία εχθρικές δυνάμεις περικυκλώνουν μια πόλη .</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_multi-time_single_location_city"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δολοφονία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δολοφονία_el">
                <ontolex:writtenRep xml:lang="el">δολοφονία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δολοφονία_el">
                <ontolex:isEvokedBy rdf:resource="#δολοφονία_el"/>
                <skos:definition xml:lang="el">Αφαίρεση της ζωής άλλου ανθρώπου με βίαιο τρόπο. Στο πλαίσιο της παρούσας οντοορολογίας ανήκει στην κατηγορία {πολιτικό γεγονός, άνομο, βίαιο, η πράξη του φόνου}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Assasination"/>
    </ontolex:LexicalEntry>

