        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_θαλάσσια_τοποθεσία_el">
                <ontolex:isEvokedBy rdf:resource="#θαλάσσια_τοποθεσία_el"/>
                <skos:definition xml:lang="el">Γεωγραφική περιοχή που βρίσκεται μέσα σε μια θάλασσα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Location_sea"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#δυναστεία_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_δυναστεία_el">
                <ontolex:writtenRep xml:lang="el">δυναστεία</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_δυναστεία_el">
                <ontolex:isEvokedBy rdf:resource="#δυναστεία_el"/>
                <skos:definition xml:lang="el">Διαδοχική σειρά κληρονομικών αρχόντων που ανήκουν στην ίδια οικογένεια.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_organised_group_succession_of_rulers_of_the_same_line_of_descent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#στρατιωτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_στρατιωτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">στρατιωτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_στρατιωτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#στρατιωτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Συμβάν που περιλαμβάνει τις ένοπλες δυνάμεις και συνήθως συνδέεται με πολεμικές επιχειρήσεις, συγκρούσεις ή στρατιωτικές ασκήσεις. Αυτά τα γεγονότα μπορεί να ποικίλουν σε κλίμακα και σημασία, από μικρές αψιμαχίες μέχρι μεγάλες μάχες, πολέμους ή στρατιωτικές επιχειρήσεις.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πάπυρος__el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πάπυρος__el">
