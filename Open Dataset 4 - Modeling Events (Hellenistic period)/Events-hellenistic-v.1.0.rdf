        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_γιορτή__el">
                <ontolex:isEvokedBy rdf:resource="#γιορτή__el"/>
                <skos:definition xml:lang="el">Θρησκευτικό γεγονός νόμιμος.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_religious_lawful"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πόλη_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πόλη_el">
                <ontolex:writtenRep xml:lang="el">πόλη</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πόλη_el">
                <ontolex:isEvokedBy rdf:resource="#πόλη_el"/>
                <skos:definition xml:lang="el">Χερσαία τοποθεσία, κατοικημένη, με σαφή κοινωνική και πολιτική οργάνωση.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#City"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#νόμισμα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_νόμισμα_el">
                <ontolex:writtenRep xml:lang="el">νόμισμα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_νόμισμα_el">
                <ontolex:isEvokedBy rdf:resource="#νόμισμα_el"/>
                <skos:definition xml:lang="el">Μικρών διαστάσεων μεταλλικό αντικείμενο σε σχήμα δίσκου, το οποίο στις επιφάνειές του έχει επιγραφές, αριθμούς και παραστάσεις που δηλώνουν την αξία του. Αποτελεί βασική πηγή της Ιστορίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Coin"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πρωτογενής_πηγή_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πρωτογενής_πηγή_el">
                <ontolex:writtenRep xml:lang="el">πρωτογενής πηγή</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πρωτογενής_πηγή_el">
                <ontolex:isEvokedBy rdf:resource="#πρωτογενής_πηγή_el"/>
                <skos:definition xml:lang="el">Πρωτότυπα κείμενα και αντικείμενα που χρονολογούνται στην ίδια περίοδο με το ιστορικό γεγονός.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Primary"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#επανάσταση_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_επανάσταση_el">
                <ontolex:writtenRep xml:lang="el">επανάσταση</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_επανάσταση_el">
                <ontolex:isEvokedBy rdf:resource="#επανάσταση_el"/>
                <skos:definition xml:lang="el">Το σύνολο των ιστορικών γεγονότων που συμβαίνουν σε μία κοινωνία, όταν ένα τμήμα της εξεγείρεται με σκοπό την κατάληψη της εξουσίας. Μια επανάσταση συνήθως συνεπάγεται μια ριζική και συχνά βίαιη αλλαγή στην πολιτική ή κοινωνική δομή μιας χώρας. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {πολιτικό γεγονός, άνομο, βίαιο, βίαιη εκτόπιση της κοινωνικής τάξης στην εξουσία}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Revolt"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#σατράπης_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_σατράπης_el">
                <ontolex:writtenRep xml:lang="el">σατράπης</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_σατράπης_el">
                <ontolex:isEvokedBy rdf:resource="#σατράπης_el"/>
                <skos:definition xml:lang="el">Αξιωματούχος που διόριζε ο Πέρσης βασιλιάς για να διοικεί τις επαρχίες (σατραπείες) της Περσικής αυτοκρατορίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Satrap"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτικό_γεγονός_άνομο_βίαιο_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτικό_γεγονός_άνομο_βίαιο_el">
                <ontolex:writtenRep xml:lang="el">πολιτικό γεγονός άνομο βίαιο</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτικό_γεγονός_άνομο_βίαιο_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτικό_γεγονός_άνομο_βίαιο_el"/>
                <skos:definition xml:lang="el">Πολιτικό γεγονός που χαρακτηρίζεται από τον παράνομο χαρακτήρα του και τη χρήση βίας. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political_unlawful_violent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#συνέλευση_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_συνέλευση_el">
                <ontolex:writtenRep xml:lang="el">συνέλευση</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_συνέλευση_el">
                <ontolex:isEvokedBy rdf:resource="#συνέλευση_el"/>
                <skos:definition xml:lang="el">Προγραμματισμένη συγκέντρωση συνόλου ανθρώπων, για να συζητήσουν κάποιο θέμα και για να πάρουν αποφάσεις. Στο πλαίσιο της παρούσας οντοορολογίας εντάσσεται στην κατηγορία {πολιτικό γεγονός, νόμιμο, μη βίαιο}.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Assembly_vote"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#στάση_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_στάση_el">
                <ontolex:writtenRep xml:lang="el">στάση</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_στάση_el">
                <ontolex:isEvokedBy rdf:resource="#στάση_el"/>
                <skos:definition xml:lang="el">Εξέγερση, αντίσταση απέναντι στην εξουσία. Βίαιο πολιτικό γεγονός, συχνά με σκοπό την ανατροπή της παρούσας διοίκησης και την κατάληψη της εξουσίας. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Sedition"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#φιλόσοφος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_φιλόσοφος_el">
                <ontolex:writtenRep xml:lang="el">φιλόσοφος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_φιλόσοφος_el">
                <ontolex:isEvokedBy rdf:resource="#φιλόσοφος_el"/>
                <skos:definition xml:lang="el">Κάποιος που  μελετάει θεμελιώδη ζητήματα της ανθρώπινης ύπαρξης.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Philosopher"/>
    </ontolex:LexicalEntry>

