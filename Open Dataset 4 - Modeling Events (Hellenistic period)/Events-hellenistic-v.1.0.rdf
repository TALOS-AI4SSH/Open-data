    <ontolex:LexicalEntry rdf:about="#πλήθος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πλήθος_el">
                <ontolex:writtenRep xml:lang="el">πλήθος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πλήθος_el">
                <ontolex:isEvokedBy rdf:resource="#πλήθος_el"/>
                <skos:definition xml:lang="el">Μεγάλη ομάδα ανθρώπων συγκεντρωμένη σε μια τοποθεσία.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Agent_human_non-organised_group"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πόλεμος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πόλεμος_el">
                <ontolex:writtenRep xml:lang="el">πόλεμος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πόλεμος_el">
                <ontolex:isEvokedBy rdf:resource="#πόλεμος_el"/>
                <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα κατάσταση ένοπλης διαμάχης μεταξύ διαφορετικών εθνών ή πόλεων ή μεταξύ διαφορετικών ομάδων σε μια πόλη ή χώρα.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Armed_conflict"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ρήτορας_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ρήτορας_el">
                <ontolex:writtenRep xml:lang="el">ρήτορας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ρήτορας_el">
                <ontolex:isEvokedBy rdf:resource="#ρήτορας_el"/>
                <skos:definition xml:lang="el">Ομιλητή που χρησιμοποιεί τη δύναμη του λόγου, για να επηρεάσει την κοινή γνώμη, να επιχειρηματολογήσει στο δικαστήριο, ή να συμμετάσχει σε πολιτικές και φιλοσοφικές συζητήσεις.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Orator"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ιερέας_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ιερέας_el">
                <ontolex:writtenRep xml:lang="el">ιερέας</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ιερέας_el">
                <ontolex:isEvokedBy rdf:resource="#ιερέας_el"/>
                <skos:definition xml:lang="el">Ιδιότηταρόλος που εξουσιοδοτεί αυτόν που τον έχει να πραγματοποιεί τις ιερές τελετουργίες μιας θρησκείας ή λατρείας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Priest"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#στρατηγός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_στρατηγός_el">
                <ontolex:writtenRep xml:lang="el">στρατηγός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_στρατηγός_el">
                <ontolex:isEvokedBy rdf:resource="#στρατηγός_el"/>
                <skos:definition xml:lang="el">Στρατικός αξιωματούχος, διοικητής του στρατού.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#General"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#τεχνούργημα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_τεχνούργημα_el">
                <ontolex:writtenRep xml:lang="el">τεχνούργημα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_τεχνούργημα_el">
                <ontolex:isEvokedBy rdf:resource="#τεχνούργημα_el"/>
                <skos:definition xml:lang="el">Αντικείμενο κατασκευασμένο με ιδιαίτερη φροντίδα και τέχνη. Αποτελεί βασική ιστορική πηγή.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Artifact"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτικό_γεγονός_νόμιμο_μη_βίαιο_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτικό_γεγονός_νόμιμο_μη_βίαιο_el">
                <ontolex:writtenRep xml:lang="el">πολιτικό γεγονός νόμιμο μη βίαιο</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτικό_γεγονός_νόμιμο_μη_βίαιο_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτικό_γεγονός_νόμιμο_μη_βίαιο_el"/>
                <skos:definition xml:lang="el">Πολιτικό γεγονός που δεν συμμορφώνεται με τους ισχύοντεις νόμους και δεν περιλαμβάνει τη χρήση βίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political_lawful_non-violent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#βίαιο_στρατιωτικό_γεγονός_σε_πολλά_μέρη_ταυτόχρονα_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_βίαιο_στρατιωτικό_γεγονός_σε_πολλά_μέρη_ταυτόχρονα_el">
                <ontolex:writtenRep xml:lang="el">βίαιο στρατιωτικό γεγονός σε πολλά μέρη ταυτόχρονα</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_βίαιο_στρατιωτικό_γεγονός_σε_πολλά_μέρη_ταυτόχρονα_el">
                <ontolex:isEvokedBy rdf:resource="#βίαιο_στρατιωτικό_γεγονός_σε_πολλά_μέρη_ταυτόχρονα_el"/>
                <skos:definition xml:lang="el">Βίαιο στρατιωτικό γεγονός που συνέβη σε περισσότερους από έναν τόπους και χρονικές στιγμές. </skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_military_violent_multi-location_multi-time"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ιστοριογράφος_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ιστοριογράφος_el">
                <ontolex:writtenRep xml:lang="el">ιστοριογράφος</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ιστοριογράφος_el">
                <ontolex:isEvokedBy rdf:resource="#ιστοριογράφος_el"/>
                <skos:definition xml:lang="el">Συγγραφέας που έχει συγγράψει ιστορία της εποχής του ή της χώρας του.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Historiographer"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#ιστορικός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_ιστορικός_el">
                <ontolex:writtenRep xml:lang="el">ιστορικός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_ιστορικός_el">
                <ontolex:isEvokedBy rdf:resource="#ιστορικός_el"/>
                <skos:definition xml:lang="el">Συγγραφέας που μελετάει τα γεγονότα και τις περιόδους της ιστορίας.που μελετά, ερευνά και καταγράφει τα γεγονότα του παρελθόντος αναλύοντας πρωτογενείς και δευτερογενείς πηγές, όπως έγγραφα, αρχεία, μαρτυρίες και αντικείμενα. Με το έργο του συντελεί στη διατήρηση της ιστορικής μνήμης και στη διαμόρφωση της κατανόησης του παρελθόντος και επηρεάζει την λήψη αποφάσεων στο παρόν.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Historian"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτικό_γεγονός_άνομο_μη_βίαιο_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτικό_γεγονός_άνομο_μη_βίαιο_el">
                <ontolex:writtenRep xml:lang="el">πολιτικό γεγονός άνομο μη βίαιο</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτικό_γεγονός_άνομο_μη_βίαιο_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτικό_γεγονός_άνομο_μη_βίαιο_el"/>
                <skos:definition xml:lang="el">Πολιτικό γεγονός που δεν συμμορφώνεται με τους ισχύοντες νόμους και δεν περιλαμβάνει τη χρήση βίας.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political_unlawful_non-violent"/>
    </ontolex:LexicalEntry>

    <ontolex:LexicalEntry rdf:about="#πολιτικό_γεγονός_el">
        <ontolex:lexicalForm>
            <ontolex:Form rdf:about="#form_πολιτικό_γεγονός_el">
                <ontolex:writtenRep xml:lang="el">πολιτικό γεγονός</ontolex:writtenRep>
            </ontolex:Form>
        </ontolex:lexicalForm>
        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πολιτικό_γεγονός_el">
                <ontolex:isEvokedBy rdf:resource="#πολιτικό_γεγονός_el"/>
                <skos:definition xml:lang="el">Συμβάν ή εξέλιξη που επηρεάζει την πολιτική κατάσταση ενός κράτους ή μιας περιοχής.</skos:definition>
            </ontolex:LexicalConcept>
        </ontolex:evokes>
        <ontolex:denotes rdf:resource="#Event_political"/>
    </ontolex:LexicalEntry>

