        <ontolex:evokes>
            <ontolex:LexicalConcept rdf:about="#lexical_concept_πρίγκηπας-πριγκήπισσα_el">
                <ontolex:isEvokedBy rdf:resource="#πρίγκηπας-πριγκήπισσα_el"/>
